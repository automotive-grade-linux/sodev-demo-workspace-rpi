# build-time working directories (generated by build.sh / moulin — never committed)
/agl/
/android
/android_kernel/
# The Raspberry Pi 4 build checks the same two trees out under board-suffixed names
# (DOMA_DIR / ANDROID_KERNEL_DIR in rpi4-sodev.yaml), so that switching --board cannot
# make one board inherit the other's checkout -- and a mis-specified --aaos-ref fails
# on the spot instead of silently on some later clean build.
/android-rpi4
/android_kernel-rpi4/
/yocto/
/zephyr/
/artifacts/
/out/
/full.img
/build.ninja
/.moulin.config
/.ninja_deps
/.ninja_log
/.stamps/
*.log
# Python bytecode (from importing/compiling the committed .py helpers)
__pycache__/
*.pyc
# Throw-away shims build.sh creates so a bare '*-project-objects' mirror can serve as a
# repo --reference (--aaos-ref / --aaos-kernel-ref). They hold nothing but a symlink.
.aaos-ref-shim/
# local scratch / per-site overrides (not part of the PR)
*.bak-*
/rpi5-sodev.build.yaml
# SSH host keys — generated on first boot by ssh-keygen -A, never committed
**/recipes-core/images/files/ssh_host_*
# DomA boot artifacts. Normally DERIVED from the AAOS build outputs, so nothing is
# staged and nothing is ignored. The exception is --aaos=prebuilt, which has no AOSP
# checkout to derive from: there build.sh copies these two out of the bundle's files/
# (see docs/BUILD.md). Build inputs, never committed.
# The AOSP NOTICE that accompanies them is NOT listed here: the recipe fetches it with
# file://NOTICE, so it has to be committed or a fresh clone fails at do_fetch.
**/recipes-bsp/aaos-guest-binaries/files/aaos-android-kernel-xenbuilt-*
**/recipes-bsp/aaos-guest-binaries/files/aaos-vendor-boot-ramdisk-xenbuilt-*
