[Unit]
Description=AGL Cluster IC (shm fallback) demo on DomD weston
Documentation=file:///usr/share/doc/xt-cluster-shm/README
# weston.socket publishes the global compositor socket at /run/wayland-0, so
# XDG_RUNTIME_DIR=/run plus WAYLAND_DISPLAY=wayland-0 below resolves to exactly
# that path -- the same pair the qemu device-models get from
# xendriverdomain.service.d/hack-xdg_runtime_dir.conf. Using the global socket
# means this client does not have to know weston's uid.
After=weston.service weston.socket
Wants=weston.service
ConditionPathExists=/dev/dri/card0
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=XDG_RUNTIME_DIR=/run
Environment=WAYLAND_DISPLAY=wayland-0
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do [ -S /run/wayland-0 ] && exit 0; sleep 1; done; exit 1'
ExecStart=/usr/bin/xt-cluster-shm
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
