diff --git a/xen/arch/arm/domain.c b/xen/arch/arm/domain.c
index baa3a5d708..0cd0aa95e6 100644
--- a/xen/arch/arm/domain.c
+++ b/xen/arch/arm/domain.c
@@ -561,9 +561,16 @@ int arch_sanitise_domain_config(struct xen_domctl_createdomain *config)
 {
     unsigned int max_vcpus;
     unsigned int flags_required = (XEN_DOMCTL_CDF_hvm | XEN_DOMCTL_CDF_hap);
+    /*
+     * xen-troops libxl direct-map (Stage 1): also accept the direct-map /
+     * static-mem CDF flags on ARM (x86 rejects them in its own
+     * arch_sanitise_domain_config()).
+     */
     unsigned int flags_optional = (XEN_DOMCTL_CDF_iommu | XEN_DOMCTL_CDF_vpmu |
                                    XEN_DOMCTL_CDF_xs_domain |
-                                   XEN_DOMCTL_CDF_trap_unmapped_accesses );
+                                   XEN_DOMCTL_CDF_trap_unmapped_accesses |
+                                   XEN_DOMCTL_CDF_directmap |
+                                   XEN_DOMCTL_CDF_staticmem);
     unsigned int sve_vl_bits = sve_decode_vl(config->arch.sve_vl);
 
     if ( (config->flags & ~flags_optional) != flags_required )
@@ -762,6 +769,20 @@ int arch_domain_create(struct domain *d,
     if ( (rc = sci_domain_init(d, config)) != 0 )
         goto fail;
 
+    /*
+     * Clear DomD vGIC SPI reservations.
+     * Use config->arch.nr_spis directly (libxl sets 219) since
+     * d->arch.vgic.nr_spis may be 0 at this point (timing of vgic_init).
+     * SGI 0-15 and PPI 16-31 remain untouched.
+     */
+    if ( config && !is_hardware_domain(d) && d->arch.vgic.allocated_irqs )
+    {
+        unsigned int irq;
+        unsigned int max_irq = NR_LOCAL_IRQS + config->arch.nr_spis;
+        for ( irq = NR_LOCAL_IRQS; irq < max_irq; irq++ )
+            clear_bit(irq, d->arch.vgic.allocated_irqs);
+    }
+
     return 0;
 
 fail:
diff --git a/xen/arch/arm/domain_build.c b/xen/arch/arm/domain_build.c
index 72d5316180..71026c0396 100644
--- a/xen/arch/arm/domain_build.c
+++ b/xen/arch/arm/domain_build.c
@@ -1674,7 +1674,22 @@ static int __init handle_node(struct domain *d, struct kernel_info *kinfo,
 
 static int __init prepare_dtb_hwdom(struct domain *d, struct kernel_info *kinfo)
 {
-    const p2m_type_t default_p2mt = p2m_mmio_direct_c;
+    /*
+     * Memory attribute for the hardware domain's device MMIO.
+     *
+     * Upstream maps it Normal-Cacheable (p2m_mmio_direct_c). On BCM2712 that
+     * produces IMP-DEF asynchronous SErrors (ESR=0xbffb936f) the first time
+     * Linux does a writel() to a register-style block -- observed on the main
+     * pinctrl at 0x10_7d504100 -- because its pad-config registers do not
+     * tolerate write-back cached or reordered accesses. Device-nGnRE is what
+     * both bare-metal Linux and Xen's own dom0less passthrough path
+     * (handle_passthrough_prop() in dom0less-build.c) use for the same
+     * registers.
+     *
+     * This is a SoC property, not an architectural one, so it is opt-in.
+     */
+    const p2m_type_t default_p2mt = IS_ENABLED(CONFIG_XT_HWDOM_MMIO_DEVICE_ATTR)
+                                    ? p2m_mmio_direct_dev : p2m_mmio_direct_c;
     const void *fdt;
     int new_size;
     int ret;
@@ -1926,6 +1941,56 @@ int __init construct_hwdom(struct kernel_info *kinfo,
     if ( rc < 0 )
         return rc;
 
+#ifdef CONFIG_XT_HWDOM_PASSTHROUGH_CAPS
+    /*
+     * Widen the hardware domain's forwarding capabilities so its toolstack can
+     * hand host SPIs and device MMIO to a driver domain.
+     *
+     * A device left to a driver domain is marked "xen,passthrough" in the host
+     * device tree, so handle_node() skips it and neither its interrupts nor its
+     * register range end up in the hardware domain's irq_caps/iomem_caps. The
+     * capability check in XEN_DOMCTL_irq_permission /
+     * XEN_DOMCTL_iomem_permission is against the *caller's* caps, so libxl in
+     * the hardware domain then fails with -EPERM when it tries to forward them
+     * (observed for IRQ 65 and for the HVS registers at 0x10_7c580000).
+     *
+     * Granting the whole SPI range plus the SoC's device-MMIO window lets the
+     * hardware domain delegate; it does not map anything into it. Enabling this
+     * does widen what a compromised hardware domain could delegate, which is
+     * why it is opt-in.
+     */
+    {
+        unsigned int irq;
+
+        for ( irq = NR_LOCAL_IRQS; irq < gic_number_lines(); irq++ )
+        {
+            int ipr = irq_permit_access(d, irq);
+
+            if ( ipr )
+                printk(XENLOG_WARNING "%pd: irq_permit_access(IRQ%u) rc=%d\n",
+                       d, irq, ipr);
+        }
+    }
+
+    /*
+     * The device-MMIO window. BCM2712 places the SoC peripherals the driver
+     * domain needs high in a 40-bit space (the HVS at 0x10_7c580000, roughly
+     * 66 GiB), well above the 4 GiB where RAM ends, so the window granted here
+     * is [4 GiB, 128 GiB) -- everything above RAM and below the top of the
+     * address space the SoC decodes. A window that stopped at 8 GiB, as an
+     * earlier revision of this change did, covers none of those devices.
+     */
+    {
+        unsigned long mfn_start = CONFIG_XT_HWDOM_IOMEM_CAP_START >> PAGE_SHIFT;
+        unsigned long mfn_end   = (CONFIG_XT_HWDOM_IOMEM_CAP_END >> PAGE_SHIFT) - 1;
+        int ipr = iomem_permit_access(d, mfn_start, mfn_end);
+
+        if ( ipr )
+            printk(XENLOG_WARNING "%pd: iomem_permit_access([%#lx..%#lx]) rc=%d\n",
+                   d, mfn_start, mfn_end, ipr);
+    }
+
+#endif
     if ( acpi_disabled )
     {
         rc = prepare_dtb_hwdom(d, kinfo);
diff --git a/xen/arch/arm/domctl.c b/xen/arch/arm/domctl.c
index 6c9a3f9920..8566f31e93 100644
--- a/xen/arch/arm/domctl.c
+++ b/xen/arch/arm/domctl.c
@@ -111,9 +111,17 @@ long arch_do_domctl(struct xen_domctl *domctl, struct domain *d,
         read_lock(&currd->caps_lock);
 
         if ( !irq_access_permitted(currd, irq) )
+        {
+            printk(XENLOG_WARNING "bind_pt_irq -> EPERM (caller d%d lacks capability)\n",
+                   currd->domain_id);
             rc = -EPERM;
+        }
         else if ( !vgic_reserve_virq(d, virq) )
+        {
+            printk(XENLOG_WARNING "bind_pt_irq -> EBUSY (vgic_reserve_virq(d%d, vIRQ%u) failed; already allocated?)\n",
+                   d->domain_id, virq);
             rc = -EBUSY;
+        }
         else
         {
             rc = route_irq_to_guest(d, virq, irq, "routed IRQ");
@@ -184,6 +192,82 @@ long arch_do_domctl(struct xen_domctl *domctl, struct domain *d,
     }
     case XEN_DOMCTL_dt_overlay:
         return dt_overlay_domctl(d, &domctl->u.dt_overlay);
+
+#ifdef CONFIG_STATIC_MEMORY
+    case XEN_DOMCTL_assign_static_11:
+    {
+        /*
+         * xen-troops libxl direct-map (Stage 1):
+         * Runtime equivalent of dom0less assign_static_memory_11().
+         * Claim a host-reserved static-memory range [pbase, pbase+psize)
+         * (already marked PGC_static at boot by init_staticmem_pages())
+         * and directly map it into the domain at GPA == PA.
+         *
+         * Only valid for a direct-mapped, static-mem domain that is still
+         * being constructed (toolstack create path, before
+         * creation_finished).
+         */
+        paddr_t pbase = domctl->u.assign_static_11.pbase;
+        paddr_t psize = domctl->u.assign_static_11.psize;
+        mfn_t smfn;
+        unsigned int nr_pages;
+        int rc;
+
+        if ( !is_domain_direct_mapped(d) || !is_domain_using_staticmem(d) )
+            return -EINVAL;
+
+        if ( d->creation_finished )
+            return -EPERM;
+
+        if ( !IS_ALIGNED(pbase, PAGE_SIZE) || !IS_ALIGNED(psize, PAGE_SIZE) ||
+             psize == 0 )
+            return -EINVAL;
+
+        if ( (psize >> PAGE_SHIFT) > UINT_MAX )
+            return -EINVAL;
+
+        nr_pages = psize >> PAGE_SHIFT;
+        smfn = maddr_to_mfn(pbase);
+
+        /*
+         * acquire_domstatic_pages() claims the PGC_static pages and
+         * assigns them to the domain (on failure it unwinds itself).
+         */
+        rc = acquire_domstatic_pages(d, smfn, nr_pages, 0);
+        if ( rc )
+        {
+            printk(XENLOG_ERR
+                   "%pd: assign_static_11: failed to acquire static memory "
+                   "%#"PRIpaddr"-%#"PRIpaddr" (rc=%d)\n",
+                   d, pbase, pbase + psize, rc);
+            return rc;
+        }
+
+        /* GPA == PA: 1:1 map into the guest p2m. */
+        rc = guest_physmap_add_pages(d, gaddr_to_gfn(pbase), smfn, nr_pages);
+        if ( rc )
+        {
+            /*
+             * The pages remain assigned to the domain and will be
+             * reclaimed when the (failed) domain is destroyed.  Mirror
+             * dom0less, which treats a mapping failure as fatal for the
+             * domain rather than attempting partial rollback.
+             */
+            printk(XENLOG_ERR
+                   "%pd: assign_static_11: failed to 1:1 map "
+                   "%#"PRIpaddr"-%#"PRIpaddr" (rc=%d)\n",
+                   d, pbase, pbase + psize, rc);
+            return rc;
+        }
+
+        printk(XENLOG_INFO
+               "%pd: assign_static_11: direct-mapped STATIC %#"PRIpaddr
+               "-%#"PRIpaddr"\n", d, pbase, pbase + psize);
+
+        return 0;
+    }
+#endif /* CONFIG_STATIC_MEMORY */
+
     default:
         return subarch_do_domctl(domctl, d, u_domctl);
     }
diff --git a/xen/arch/arm/irq.c b/xen/arch/arm/irq.c
index 73e58a5108..79052e05e3 100644
--- a/xen/arch/arm/irq.c
+++ b/xen/arch/arm/irq.c
@@ -528,6 +528,27 @@ int route_irq_to_guest(struct domain *d, unsigned int virq,
 
     spin_lock_irqsave(&desc->lock, flags);
 
+#ifdef CONFIG_XT_GUEST_PASSTHROUGH_IRQ_TYPE_DEFAULT
+    /*
+     * Supply a trigger type for an SPI that is being routed to a non-hardware
+     * domain but was never configured by anyone.
+     *
+     * A device marked "xen,passthrough" in the host device tree is not probed
+     * by the hardware domain, so no request_irq() reaches Xen and
+     * gic_set_irq_type() never runs; desc->arch.type stays IRQ_TYPE_INVALID and
+     * the check below rejects the route with -EINVAL ("IRQ %u has not been
+     * configured"). Observed on BCM2712 as rc=-5 out of xc_domain_irq_permission
+     * for IRQ 65.
+     *
+     * BCM2712's GIC-400 SPIs are all active-high level lines, which is also the
+     * ARM GICv2 reset state, so level-high is the correct fallback for this SoC.
+     * It is not correct in general, hence the Kconfig gate.
+     */
+    if ( !is_hardware_domain(d) && irq >= NR_LOCAL_IRQS &&
+         desc->arch.type == IRQ_TYPE_INVALID )
+        desc->arch.type = IRQ_TYPE_LEVEL_HIGH;
+#endif
+
     if ( !irq_type_set_by_domain(d) && desc->arch.type == IRQ_TYPE_INVALID )
     {
         printk(XENLOG_G_ERR "IRQ %u has not been configured\n", irq);
