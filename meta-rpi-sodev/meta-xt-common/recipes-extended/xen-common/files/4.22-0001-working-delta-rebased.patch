diff --git a/xen/arch/arm/Kconfig b/xen/arch/arm/Kconfig
index 5fa89fcb24..224a7e286b 100644
--- a/xen/arch/arm/Kconfig
+++ b/xen/arch/arm/Kconfig
@@ -275,6 +275,89 @@ config PCI_PASSTHROUGH
 	help
 	  This option enables PCI device passthrough
 
+comment "Platform quirks for hardware-domain / driver-domain passthrough"
+
+config XT_HWDOM_MMIO_DEVICE_ATTR
+	bool "Map hardware-domain device MMIO as Device-nGnRE (UNSUPPORTED)" if UNSUPPORTED
+	default n
+	help
+	  Map the device MMIO handed to the hardware domain with the Device-nGnRE
+	  memory attribute instead of Normal-Cacheable, both for the ranges built
+	  into its device tree and for the XENMAPSPACE_dev_mmio hypercall.
+
+	  Some SoCs have peripherals whose registers do not tolerate write-back
+	  cached or reordered accesses and raise an IMP-DEF asynchronous SError
+	  instead; Broadcom BCM2712 (Raspberry Pi 5) is one. Xen's own dom0less
+	  passthrough path already uses Device-nGnRE for such ranges.
+
+	  Say N unless the platform is known to need it.
+
+config XT_HWDOM_PASSTHROUGH_CAPS
+	bool "Grant the hardware domain SPI and device-MMIO forwarding caps (UNSUPPORTED)" if UNSUPPORTED
+	default n
+	help
+	  Add the full SPI range and a platform device-MMIO window to the hardware
+	  domain's irq_caps and iomem_caps at build time, so its toolstack can
+	  forward them to a driver domain.
+
+	  Devices reserved for a driver domain are marked "xen,passthrough" and are
+	  therefore absent from the hardware domain's capability sets, which makes
+	  XEN_DOMCTL_irq_permission and XEN_DOMCTL_iomem_permission fail with
+	  -EPERM. This grants the right to delegate, not any mapping.
+
+	  This widens what a compromised hardware domain is able to delegate.
+	  Say N unless a driver domain on this platform needs it.
+
+config XT_HWDOM_IOMEM_CAP_START
+	hex "Start of the hardware domain device-MMIO capability window"
+	depends on XT_HWDOM_PASSTHROUGH_CAPS
+	default 0x100000000
+	help
+	  Physical address of the first byte of the window added to the hardware
+	  domain's iomem_caps. The default, 4 GiB, is above RAM on BCM2712.
+
+config XT_HWDOM_IOMEM_CAP_END
+	hex "End of the hardware domain device-MMIO capability window (exclusive)"
+	depends on XT_HWDOM_PASSTHROUGH_CAPS
+	default 0x2000000000
+	help
+	  Physical address one past the last byte of the window added to the
+	  hardware domain's iomem_caps. The default, 128 GiB, covers the whole
+	  address range BCM2712 decodes for its peripherals.
+
+config XT_GUEST_MIN_NR_SPIS
+	int "Minimum vGIC SPI count for non-hardware domains (UNSUPPORTED)" if UNSUPPORTED
+	default 0
+	range 0 988
+	help
+	  Raise a non-hardware domain's vGIC SPI count to at least this value.
+	  0 disables the floor and is the architectural behaviour.
+
+	  A guest given host SPIs through the xl.cfg "irqs=[...]" property keeps
+	  the host IRQ number as its vIRQ, but libxl sizes nr_spis from the
+	  emulated devices alone, so the vGIC can end up smaller than the highest
+	  forwarded line and gic_route_irq_to_guest() trips an ASSERT. Setting this
+	  to the host GIC's line count minus 32 keeps every forwarded vIRQ in range.
+
+	  The proper fix belongs in libxl; this is a platform workaround. On BCM2712
+	  the GIC-400 implements 320 lines, so the value is 288.
+
+config XT_GUEST_PASSTHROUGH_IRQ_TYPE_DEFAULT
+	bool "Default unconfigured guest passthrough SPIs to level-high (UNSUPPORTED)" if UNSUPPORTED
+	default n
+	help
+	  When an SPI is routed to a non-hardware domain and no trigger type has
+	  ever been programmed for it, assume active-high level.
+
+	  This happens when the owning device is marked "xen,passthrough": the
+	  hardware domain never probes it, so no request_irq() reaches Xen and
+	  gic_set_irq_type() never runs, leaving the type invalid and the route
+	  rejected with -EINVAL.
+
+	  Level-high is the GICv2 reset state and is correct for every BCM2712 SPI,
+	  but it is not correct in general. Say N unless the platform's SPIs are
+	  known to be level-high.
+
 endmenu
 
 menu "ARM errata workaround via the alternative framework"
