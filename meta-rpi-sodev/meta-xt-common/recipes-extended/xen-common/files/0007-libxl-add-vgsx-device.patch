     ])
 
 libxl__console_backend = Enumeration("console_backend", [
diff --git a/tools/libs/light/libxl_vgsx.c b/tools/libs/light/libxl_vgsx.c
new file mode 100644
index 0000000000..ee1f1a52a4
--- /dev/null
+++ b/tools/libs/light/libxl_vgsx.c
@@ -0,0 +1,94 @@
