From f5589b38545cdd3e5985c0a44d895de6812c14d9 Mon Sep 17 00:00:00 2001
From: Yuichi Kusakabe <yuichi_kusakabe@jp.honda>
Date: Wed, 08 Jul 2026 00:00:00 +0900
Subject: [PATCH] drivers/xen: regions: null-init the region pointer

Null-initialize the region pointer to avoid using an uninitialized value.

Assisted-by: Claude Code:claude-opus-4-8
Signed-off-by: Yuichi Kusakabe <yuichi_kusakabe@jp.honda>
Upstream-Status: Pending
---
diff --git a/drivers/xen/regions.c b/drivers/xen/regions.c
index d1d2aeedc2..73785ce183 100644
--- a/drivers/xen/regions.c
+++ b/drivers/xen/regions.c
@@ -100,7 +100,11 @@ static struct extended_regions ext_blocks[DT_NUM_REGS(XEN_HYP_NODE)] = {
 void *xen_region_get_pages(size_t nr_pages)
 {
 	int ret, i;
-	void *ptr;
+	/* Must start NULL: if every region returns -ENOMEM
+	 * the loop never assigns ptr and the old code returned uninitialized
+	 * stack garbage, which xenmem_map_region() would then map a foreign
+	 * guest page over - i.e. memory corruption at an arbitrary VA. */
+	void *ptr = NULL;
 
 	/*
 	 * Locking ranges iteration, although each call sys_mem_blocks_alloc_contiguous
