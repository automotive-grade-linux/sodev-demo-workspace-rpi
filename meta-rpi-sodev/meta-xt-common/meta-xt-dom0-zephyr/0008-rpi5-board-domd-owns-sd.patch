From 56ee5a686ee257d77f5e5728facd16c3e7e0c329 Mon Sep 17 00:00:00 2001
From: Yuichi Kusakabe <yuichi_kusakabe@jp.honda>
Date: Wed, 08 Jul 2026 00:00:00 +0900
Subject: [PATCH] boards/rpi_5: HW-verified Dom0 bring-up + DomD-owns-SD fixes

Root-caused on RPi5 hardware, Xen 4.21, Zephyr Dom0 + dom0less DomD topology.
Every change below was verified on hardware, including the sram0 base value: the
board reports BANK[0] 0xa0000000-0xc0000000 and loads the Dom0 Image there.

* rpi_5.overlay:
  - sram0 relink 0x10000000 -> 0xa0000000: Xen's allocate_memory_11 places
    this Dom0's direct-map bank there (dom0_mem=512M + our static-mem DomD
    layout); Zephyr is absolute-linked from CONFIG_SRAM_BASE_ADDRESS, so a
    mismatch runs garbage (observed on hardware: total UART silence, no Dom0
    console in Xen's input mux at all).
    MEASURED ON HARDWARE (2026-08-03): BANK[0] 0xa0000000-0xc0000000 and
    "Loading zImage from 0000000004000000 to 00000000a0000000". An earlier
    derivation had predicted 0xe0000000 by assuming the HIGHEST free block in a
    MEMF_bits tier wins; the board takes the LOWEST of the candidates
    (0xa0000000 / 0xc0000000 / 0xe0000000). For dom0_mem=1024M the measured
    value is 0xc0000000, where only one candidate existed -- which is why that
    data point could not discriminate the rule.
  - hypervisor node grant-table/extended-region resized to the actual Xen
    assignment (grant 0x80000, ext region 0x5e00000; from HW UART log).
  - &sdio1 status="disabled" : the SoC SDHCI is passed through to DomD
    (the toolstack domain owns the SD); with its MMIO unmapped the SDHC
    driver's SYS_INIT hangs and stops the init chain BEFORE dom0less_init,
    so the dom0less DomD is never introduced to xenstore (xenbus_probe
    state D on HW).
* rpi_5.conf:
  - SHELL/MAIN/ISR stack size raise + HW_STACK_PROTECTION: `xu create`'s
    domain build has large VLAs; 4 KiB shell stack overflowed and corrupted
    .data (data-abort fault-in-fault on HW).
  - MAX_XLAT_TABLES=32: mapping a 24 MiB guest kernel exhausts the default 12.
  - LOG_MODE_IMMEDIATE: async log interleaved char-by-char with the shell on
    the shared UART, making failure lines unreadable.
  - DISK_DRIVER_SDMMC=n + FS_FATFS_WINDOW_ALIGNMENT=4: Dom0 is SD-less (sdio1 is
    DomD's; guests are built into zephyr.bin), so the SD-disk driver is turned
    off. Disabling only the sdio1 controller (above) leaves its disk child node
    enabled, which keeps DISK_DRIVER_SDMMC=y and compiles drivers/disk/
    sdmmc_subsys.c against the now-disabled controller (__device_dts_ord_N
    undeclared). The FATFS window alignment is pinned because zephyr-dom0-xt/
    Kconfig defaults it to the now-inactive SDHC_BUFFER_ALIGNMENT symbol, which
    resolves empty and breaks the generated misc/generated/configs.c asm.
  - XEN_DOMCTL_INTERFACE_VERSION 0x16 -> 0x17 and XENTROOPS_ARCH_{VGSX_OSID,
    SCI_TYPE} y -> n: align the domctl ABI with our Xen 4.21. The two XENTROOPS
    options insert fork-specific fields into the middle of
    xen_arch_domainconfig: a u16 arm_sci_type between tee_type and nr_spis, and
    a u8 vgsx_osid between nr_spis and clock_frequency, taking the vendored
    struct from 12 to 20 bytes and xen_domctl_getdomaininfo from 120 to 128.
    Xen 4.21 has neither field at those positions -- it does have its own
    arm_sci_type, but as a u8 *after* clock_frequency (from the upstream
    generic-SCI subsystem), and it has no vgsx_osid at all. So at =y Xen reads
    nr_spis and clock_frequency at offsets 8 and 16 where it expects 4 and 8,
    and the getdomaininfolist array stride mismatches (entries 2+ garbage in
    `xu list`). Measured with gcc against Xen 4.21's public headers: Xen's
    xen_arch_domainconfig is 16 bytes with arm_sci_type at offset 12, and
    xen_domctl_getdomaininfo is 120. Verified on hardware: with =n `xu list`
    shows all 4 domains correctly. Note that =n does not reproduce Xen's
    trailing arm_sci_type either -- the vendored struct is 12 bytes where Xen's
    is 16 -- the two only agree on the enclosing getdomaininfo size (120)
    because that field lands in tail padding; patch 0018 zeroes the createdomain
    hypercall argument so Xen reads it as ARM_SCI_NONE rather than as
    uninitialised stack. (Previously required as manual `west build` -D flags;
    now carried by this patch. The sysctl version is handled by 0010.)
* src/dom0.h: CONFIG_SDMMC_VOLUME_NAME fallback so the FATFS code keeps
  compiling with CONFIG_SDHC disabled (runtime storage_init fails cleanly
  with ENODEV; the storage path is unused in the DomD-as-toolstack topology).

Depends on 0002-0004.
Assisted-by: Claude Code:claude-opus-4-8
Signed-off-by: Yuichi Kusakabe <yuichi_kusakabe@jp.honda>
Upstream-Status: Pending
---
diff --git a/boards/rpi_5.overlay b/boards/rpi_5.overlay
--- a/boards/rpi_5.overlay
+++ b/boards/rpi_5.overlay
@@ -8,6 +8,21 @@
 
 #include <mem.h>
 
+/*
+ * The SoC SDHCI (sdio1) is passed through to DomD
+ * (the toolstack domain owns the SD and serves guest rootfs partitions via
+ * qemu virtio-blk), so its MMIO is no longer mapped into this Zephyr Dom0.
+ * The board dts enables sdio1 for the FATFS storage path; with the MMIO gone
+ * the SDHC driver's SYS_INIT hangs on the first register access, which stops
+ * the whole init chain BEFORE init_domain0/dom0less_init -> the dom0less DomD
+ * is never introduced to xenstore (xenbus_probe state D on HW). Disable the
+ * controller: storage_init() in main() then fails cleanly with ENODEV (the
+ * FATFS/xu-create path is unused in this topology) and dom0less_init runs normally.
+ */
+&sdio1 {
+	status = "disabled";
+};
+
 / {
 	#address-cells = <2>;
 	#size-cells = <1>;
@@ -38,7 +53,11 @@
 	 */
 	hypervisor: hypervisor@2000000 {
 		compatible = "xen,xen";
-		reg = <0x00 0x2000000 0x40000>, <0x00 0x2200000 0x5400000>;
+		/* grant table + extended region 0 sized to OUR Xen's
+		 * actual assignment (HW UART log): grant table 0x2000000-0x207b000 (was
+		 * 0x40000 -> 0x80000 to cover it); extended region 0 0x2200000-0x8000000
+		 * (was 0x5400000 -> 0x5e00000). Base addresses already matched. */
+		reg = <0x00 0x2000000 0x80000>, <0x00 0x2200000 0x5e00000>;
 		interrupts = <GIC_PPI 0x0 IRQ_TYPE_EDGE IRQ_DEFAULT_PRIORITY>;
 		interrupt-parent = <&gic>;
 		status = "okay";
@@ -55,9 +74,19 @@
 	 * Xen passes actual values for setup in domain device tree, but Zephyr
 	 * is not capable to parse and handle it in runtime.
 	 */
-	sram0: memory@10000000 {
+	/*
+	 * Relinked 0x10000000 -> 0xa0000000 to match where OUR Xen
+	 * places this Dom0's direct-map bank. Xen loads the Dom0 arm64 Image relative to
+	 * bank[0].start (allocate_memory_11 cannot be pinned via DT), and with
+	 * dom0_mem=512M + our dom0less DomD static-mem layout it lands at 0xa0000000 --
+	 * MEASURED: "Loading zImage from 0000000004000000 to 00000000a0000000".
+	 * Zephyr is absolute-linked from CONFIG_SRAM_BASE_ADDRESS (auto-derived from this
+	 * node), so it MUST equal the actual bank base or it runs garbage and faults before
+	 * console init (observed: total UART silence, no xu-create, hardware).
+	 */
+	sram0: memory@a0000000 {
 		compatible = "mmio-sram";
-		reg = <0x00 0x10000000 DT_SIZE_M(128)>;
+		reg = <0x00 0xa0000000 DT_SIZE_M(128)>;
 	};
 };
 
diff --git a/boards/rpi_5.conf b/boards/rpi_5.conf
--- a/boards/rpi_5.conf
+++ b/boards/rpi_5.conf
@@ -6,10 +6,20 @@
 CONFIG_XSTAT=y
 CONFIG_XSTAT_SHELL_CMDS=y
 
-CONFIG_SHELL_STACK_SIZE=4096
-
-CONFIG_MAIN_STACK_SIZE=8192
-CONFIG_ISR_STACK_SIZE=8192
+# xu create runs on the shell thread. The domain build
+# (load_modules -> gen_domain_fdt) has large VLAs; 4 KiB overflowed and
+# corrupted adjacent .data/.bss -> data-abort -> "Abort taken without a change
+# in exception level" (fault-in-fault) during `xu create rpi_5_sodev_domu`
+# (hardware). Raise the shell stack and enable HW stack protection so any
+# residual overflow faults cleanly (with ELR/FAR) instead of silently corrupting.
+CONFIG_SHELL_STACK_SIZE=32768
+
+CONFIG_MAIN_STACK_SIZE=16384
+CONFIG_ISR_STACK_SIZE=16384
+CONFIG_HW_STACK_PROTECTION=y
+# 24 MiB guest kernel is mapped into Dom0 to load it; bump the xlat table pool
+# so the map does not exhaust CONFIG_MAX_XLAT_TABLES (default 12).
+CONFIG_MAX_XLAT_TABLES=32
 
 CONFIG_XEN_VCH=y
 CONFIG_XEN_DOM0LESS_BOOT=y
@@ -33,6 +43,18 @@
 
 CONFIG_DOMU_MAX=5
 
+# Synchronous logging so the `xu create` failure line
+# ("Failed to <step> for domain#2 (rc=N)") prints atomically and is readable
+# on the shared Xen UART (async log thread was interleaving char-by-char with
+# the shell thread -> "kernel will"->"kernbaill", failure reason unreadable).
+CONFIG_LOG_MODE_IMMEDIATE=y
+
+# [build-fix] SD-less Dom0 (sdio1 -> DomD, guests built into zephyr.bin):
+# turn the SD-disk driver off so drivers/disk/sdmmc_subsys.c is not built against the
+# disabled sdio1 controller, and pin FS_FATFS_WINDOW_ALIGNMENT (zephyr-dom0-xt/Kconfig
+# defaults it to the now-inactive, empty SDHC_BUFFER_ALIGNMENT -> broken configs.c asm).
+CONFIG_DISK_DRIVER_SDMMC=n
+CONFIG_FS_FATFS_WINDOW_ALIGNMENT=4
-CONFIG_XEN_DOMCTL_INTERFACE_VERSION=0x16
+CONFIG_XEN_DOMCTL_INTERFACE_VERSION=0x17
-CONFIG_XEN_DOMCTL_XENTROOPS_ARCH_VGSX_OSID=y
-CONFIG_XEN_DOMCTL_XENTROOPS_ARCH_SCI_TYPE=y
+CONFIG_XEN_DOMCTL_XENTROOPS_ARCH_VGSX_OSID=n
+CONFIG_XEN_DOMCTL_XENTROOPS_ARCH_SCI_TYPE=n
diff --git a/src/dom0.h b/src/dom0.h
--- a/src/dom0.h
+++ b/src/dom0.h
@@ -28,6 +28,14 @@
 };
 
 #if defined(CONFIG_DOM_STORAGE_FATFS_ENABLE)
+/* With the SD passed through to DomD the SDHC
+ * subsystem (CONFIG_SDHC) is disabled and CONFIG_SDMMC_VOLUME_NAME no longer
+ * exists; keep the FATFS code compiling with a dummy volume name — the
+ * runtime disk_access_init() then fails cleanly with -ENODEV (storage is
+ * unused in the DomD-as-toolstack topology). */
+#ifndef CONFIG_SDMMC_VOLUME_NAME
+#define CONFIG_SDMMC_VOLUME_NAME "SD"
+#endif
 #define DISK_DRIVE_NAME CONFIG_SDMMC_VOLUME_NAME
 #define DISK_MOUNT_PT "/"CONFIG_DOM_STORAGE_FATFS_LOGICAL_DRIVE_NAME":"
 #define DISK_BIN_PATH DISK_MOUNT_PT"/"CONFIG_DOM_STORAGE_FATFS_DIR
