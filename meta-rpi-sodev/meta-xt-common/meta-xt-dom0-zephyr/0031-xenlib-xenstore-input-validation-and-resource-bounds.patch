diff --git a/Kconfig b/Kconfig
index 35efccb..d60c2af 100644
--- a/Kconfig
+++ b/Kconfig
@@ -102,9 +102,26 @@ config XENSTORE_SHELL_READ_SIZE
 	help
 	  Sets the maximum size that xs read cmd can handle
 
+config XENSTORE_MAX_WATCHES_PER_DOMAIN
+	int "Maximum number of xenstore watches one domain may register"
+	default 128
+	range 1 4096
+	help
+	  Per-domain quota on XS_WATCH registrations. Each watch is a permanent heap
+	  allocation (entry plus its path and token), and a guest can ask for them in
+	  a loop, so without a quota one domain can exhaust Dom0's heap and take
+	  unrelated domains down with it. 128 matches the default
+	  quota_nb_watch_per_domain of the reference xenstored.
+
 config XENSTORE_TREE_TRAVERSE_DEPTH
 	int "Maximum xs traverse depth"
-	default 8
+	# 16, not 8. This bounds the depth a guest may create, and the shallowest real
+	# PV path is already 8 components
+	# (.../backend/vbd/<fe>/<devid>/multi-queue-max-queues) - pvUSB reaches 9 and
+	# pvSCSI 10 - so a default of 8 rejects legitimate writes with a bare EINVAL and
+	# hangs `xl create` for those device types. Boards used to have to raise it
+	# themselves; the default now covers the protocols in tree.
+	default 16
 	range 1 16
 	help
 	  Sets the maximum xs traverse depth to avoid stack overflow
