+/*
+ * True when `path` is `prefix` itself or a node below it.
+ *
+ * The watch machinery used a bare strncmp(key, path, strlen(key)), which is a
+ * plain string prefix test: a watch on /local/domain/1/foo then fired for
+ * /local/domain/1/foobar as well. Require the match to end on a path boundary.
+ */
+static bool path_has_prefix(const char *path, const char *prefix)
+{
+	size_t plen = strlen(prefix);
+
+	if (strncmp(path, prefix, plen) != 0) {
+		return false;
+	}
+
+	/* Exact match, or the prefix ended right before a separator. A prefix
+	 * that already ends in '/' (including the root "/") needs no separator.
+	 */
+	return path[plen] == '\0' || path[plen] == '/' ||
+	       (plen > 0 && prefix[plen - 1] == '/');
+}
