-static void notify_watchers(const char *path, uint32_t caller_domid)
+/*
+ * Queue one pending watch event for `domain`/`path`, applying the coalescing rule and
+ * the per-domain cap. Returns true if an entry is queued afterwards (newly appended, or
+ * already present).
+ *
+ * Both producers go through this: notify_watchers() on a write, and handle_watch() for
+ * the initial event a new watch is owed. handle_watch() used to append directly,
+ * bypassing both the cap and the coalescing, so re-registering a watch in a loop grew
+ * the list without bound - exactly what the cap exists to stop. Counting and appending
+ * happen under one pfl_mutex hold so the count cannot be overtaken in between; the two
+ * split helpers this replaces released the lock between the check and the append.
+ *
+ * Takes pfl_mutex itself; callers must NOT hold it.
+ */
+static bool queue_pending_watch_event(struct xen_domain *domain, const char *path)
 {
-	struct watch_entry *iter;
-	struct pending_watch_event_entry *pentry;
+	struct pending_watch_event_entry *iter, *pentry;
+	size_t n = 0;
 
