- * stays >= 1 here and teardown is never due). */
-void unref_domain(struct xen_domain *domain)
+/*
+ * Zephyr-side teardown of a released domain once its last reference is gone.
+ * The caller has unlinked it from domain_list under dl_mutex and dropped the
+ * lock: stop_domain_stored() joins the guest's xenstore worker, and doing that
+ * under dl_mutex would stall every get_domain/put_domain/introduce/release on
+ * the other threads. Once unlinked at refcount 0 the domain is exclusively
+ * ours. This never destroys the hypervisor domain. Only toolstack-introduced
+ * domains get here; Zephyr set up no backends for them, so there are none to
+ * remove.
+ *
+ * When the last reference is a borrower's (put_domain()/unref_domain() from a
+ * shell command), the join runs on that thread.
+ */
+static void release_teardown(struct xen_domain *domain, const char *why)
 {
-	if (!domain) {
-		return;
+	domid_t domid = domain->domid;
+	int rc;
+
+	/* Also removes the nodes the guest owns, as the stock xenstored does on a
+	 * release (domain_tree_remove()). The ones Dom0 owns - /local/domain/<id>,
+	 * /vm/<uuid>, /libxl/<id> - are libxl's, which removes them before it
+	 * destroys the domain, so xs_deinitialize_domain_xenstore() is not called. */
+	rc = stop_domain_stored(domain);
+	if (rc) {
+		LOG_ERR("xs_release:domid:%u stop_stored err (%d)", domid, rc);
 	}
+
+	/* No console to stop: this Dom0 never starts one for a toolstack-
+	 * introduced domain (xen_start_domain_console() runs only in
+	 * domain_create()), and xen_stop_domain_console() would log an error
+	 * for every release. */
+
+	k_free(domain);
+
+	/* The slot is counted free only now. Until stop_domain_stored() has
+	 * joined the worker and given back its stack slot, an XS_INTRODUCE
+	 * that passed the CONFIG_DOMU_MAX check could not start a worker. */
 	k_mutex_lock(&dl_mutex, K_FOREVER);
+	--dom_num;
+	k_mutex_unlock(&dl_mutex);
+	LOG_INF("xs_release:domid:%u released (%s)", domid, why);
+}
+
+/* Drop one reference with dl_mutex held. If the domain has been released and
+ * this was its last reference, unlink it and return it: the caller must drop
+ * dl_mutex and then call release_teardown(). Otherwise return NULL. */
+static struct xen_domain *drop_ref_locked(struct xen_domain *domain)
+{
 	if (domain->refcount > 0) {
 		domain->refcount--;
 	}
+	if (domain->f_released && domain->refcount == 0) {
+		sys_dlist_remove(&domain->node);
+		return domain;
+	}
+	return NULL;
+}
+
+/* Drop a reference taken by get_domain(), for read-only borrowers (e.g. the
+ * `xu xsring` diag command) that must not touch dom0less domains (put_domain()
+ * asserts !f_dom0less). The decrement is done under dl_mutex so it cannot race
+ * the locked increments/decrements in get_domain()/put_domain()/
+ * xs_release_domain() -- a raw `domain->refcount--` from a shell thread could
+ * otherwise lose an update against the DomD worker thread on a preemptible
+ * single-CPU build. If the domain was released while it was borrowed, this
+ * drop is the last one and runs the teardown. */
+void unref_domain(struct xen_domain *domain)
+{
+	struct xen_domain *gone;
+
+	if (!domain) {
+		return;
+	}
+	k_mutex_lock(&dl_mutex, K_FOREVER);
+	gone = drop_ref_locked(domain);
 	k_mutex_unlock(&dl_mutex);
+	if (gone) {
+		release_teardown(gone, "last reference dropped");
+	}
 }
 
 void put_domain(struct xen_domain *domain)
@@ -750,9 +816,10 @@ void put_domain(struct xen_domain *domain)
 	/*
