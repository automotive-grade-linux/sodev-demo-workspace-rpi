diff --git a/Kconfig b/Kconfig
index d60c2af..10034cc 100644
--- a/Kconfig
+++ b/Kconfig
@@ -32,6 +32,25 @@ config XENSTORE_TOOLSTACK_DOMID
 	  as the toolstack domain (DomD in the Zephyr-Dom0 / DomD-as-toolstack
 	  configuration). Defaults to 1, the first dom0less domain on RPi5.
 
+config XEN_DOM_EXC_RELEASE
+	bool "Release dead toolstack-introduced domains on VIRQ_DOM_EXC"
+	depends on XEN_STORE_SRV && XEN_DOMAIN_MANAGEMENT
+	default y
+	help
+	  Bind VIRQ_DOM_EXC and, on each event, release the toolstack-introduced
+	  domains (XS_INTRODUCE) that the hypervisor reports dead or gone, as the
+	  stock xenstored does. libxl sends XS_RELEASE only on a soft reset, so
+	  without this a domain destroyed with `xl destroy` keeps its store ring
+	  mapped here, stays dead in Xen and holds a CONFIG_DOMU_MAX slot.
+
+config XEN_DOM_EXC_RELEASE_STACK_SIZE
+	int "Stack size of the VIRQ_DOM_EXC release thread"
+	depends on XEN_DOM_EXC_RELEASE
+	default 8192
+	help
+	  The thread runs the same release path as the XS_RELEASE handler, which
+	  runs on a xenstore worker; the default is that worker's stack size.
+
 config XEN_LIBFDT
 	bool "Enable libfdt support"
 	help
diff --git a/xen-dom-mgmt/include/domain.h b/xen-dom-mgmt/include/domain.h
index 74e85dc..04b2992 100644
--- a/xen-dom-mgmt/include/domain.h
+++ b/xen-dom-mgmt/include/domain.h
@@ -239,8 +239,14 @@ struct xen_domain {
 	 * (DomD's `xl create`, via XS_INTRODUCE). The hypervisor domain is owned
 	 * by DomD, which destroys it itself; Zephyr must never call
