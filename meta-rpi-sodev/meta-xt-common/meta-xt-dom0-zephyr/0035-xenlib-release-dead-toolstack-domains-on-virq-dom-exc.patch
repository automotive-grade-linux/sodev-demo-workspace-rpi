-	 * Torn down on the Zephyr side only by xs_release_domain() (XS_RELEASE). */
+	 * Released on the Zephyr side when the hypervisor reports it dead or gone
+	 * (VIRQ_DOM_EXC), or on an explicit XS_RELEASE. */
 	bool f_toolstack:1;
+	/* The owner's reference has been dropped (xs_release_domain). Set and read
+	 * under dl_mutex. A second release is then a no-op instead of dropping a
+	 * borrower's reference, and the borrower that drops the last reference
+	 * runs the teardown. */
+	bool f_released:1;
 };
 
 struct xen_domain *get_domain(uint32_t domid);
