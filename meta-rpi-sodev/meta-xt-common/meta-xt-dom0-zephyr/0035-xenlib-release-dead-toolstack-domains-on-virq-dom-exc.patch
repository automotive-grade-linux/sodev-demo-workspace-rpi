+
+int xs_release_domain(uint32_t domid)
+{
+	return release_domain(domid, "XS_RELEASE");
+}
+
+#ifdef CONFIG_XEN_DOM_EXC_RELEASE
+/*
+ * VIRQ_DOM_EXC: Xen's "exceptional event for some domain", sent when a domain
+ * shuts down, when domain_kill() finishes relinquishing it (it is then dead)
+ * and when it is finally destroyed (xen/common/domain.c). Xen routes this
+ * global VIRQ to the xenstore domain, which on this platform is Dom0
+ * (set_xs_domain(dom0) in xen/arch/arm/domain_build.c).
+ *
+ * This mirrors the stock xenstored (tools/xenstored/domain.c check_domains()):
+ * on every event look at all the domains it tracks, and release the ones the
