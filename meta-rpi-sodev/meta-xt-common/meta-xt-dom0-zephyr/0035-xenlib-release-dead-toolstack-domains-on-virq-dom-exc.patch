+ * except while that domid's release waits for a borrower (-EBUSY).
  */
 int xs_introduce_domain(uint32_t domid, uint64_t store_pfn, uint32_t remote_evtchn)
 {
@@ -1339,23 +1414,31 @@ int xs_introduce_domain(uint32_t domid, uint64_t store_pfn, uint32_t remote_evtc
 	 * domain_create() applies, so an unbounded XS_INTRODUCE stream cannot
