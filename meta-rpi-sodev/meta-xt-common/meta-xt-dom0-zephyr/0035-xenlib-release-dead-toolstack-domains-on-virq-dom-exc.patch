+		k_mutex_unlock(&dl_mutex);
+		LOG_ERR("xs_introduce:domid:%u domain limit %d reached", domid,
+			CONFIG_DOMU_MAX);
+		return -ENOSPC;
+	}
+	k_mutex_unlock(&dl_mutex);
 
 	/* Confirm the domain exists at the hypervisor and fetch vcpu/mem info
 	 * (needed by xs_initialize_xenstore for the per-domain xenstore tree). */
@@ -1381,8 +1464,8 @@ int xs_introduce_domain(uint32_t domid, uint64_t store_pfn, uint32_t remote_evtc
 	 * HVM_PARAM_STORE_EVTCHN to the same value, which is harmless. */
 	domain->f_dom0less = false;
 	/* DomD owns the hypervisor domain; mark it so Zephyr
-	 * never destroys it via put_domain/domain_destroy (only xs_release_domain
-	 * tears down the Zephyr-side state on XS_RELEASE). */
+	 * never destroys it via put_domain/domain_destroy. The Zephyr-side state
+	 * is released when the domain dies (VIRQ_DOM_EXC) or on XS_RELEASE. */
 	domain->f_toolstack = true;
 	snprintf(domain->name, CONTAINER_NAME_SIZE, "DomU-%u", domid);
 
@@ -1416,6 +1499,11 @@ int xs_introduce_domain(uint32_t domid, uint64_t store_pfn, uint32_t remote_evtc
 	k_mutex_unlock(&dl_mutex);
 
 	LOG_INF("xs_introduce:domid:%u introduced by toolstack", domid);
+#ifdef CONFIG_XEN_DOM_EXC_RELEASE
+	/* A death between mapping the ring and the append above was not seen by a
+	 * scan, and no later event comes for it while the ring stays mapped. */
+	dom_exc_kick();
+#endif
 	return 0;
 
 err_free:
@@ -1424,23 +1512,26 @@ err_free:
 }
 
 /*
- * Release a toolstack-introduced domain from Zephyr
- * Dom0's xenstore server. Counterpart to xs_introduce_domain(): tears down the
- * xenstore-side state (backends, store ring/thread, xenstore tree, console) and
- * drops the shadow xen_domain. Driven by the XS_RELEASE (op 9) wire request
- * that DomD's `xl destroy` issues. IMPORTANT: unlike put_domain(), this does
- * NOT call xen_domctl_destroydomain() — the hypervisor domain is owned by the
- * external toolstack (DomD), which destroys it itself; doing it here too would
- * be a double-destroy. Idempotent: releasing an untracked domid succeeds.
+ * Drop the owner's reference of a domain tracked by Zephyr Dom0's xenstore
+ * server and, once no borrower holds it, tear down the xenstore-side state
+ * (the store ring and thread, and the nodes the guest owns) and free the shadow
+ * xen_domain.
+ * Counterpart to xs_introduce_domain(). Unlike put_domain(), this does NOT call
+ * xen_domctl_destroydomain(): a toolstack-introduced domain is DomD's, which
+ * destroys it itself.
+ *
+ * Two callers: the VIRQ_DOM_EXC thread below, when the hypervisor reports a
+ * toolstack-introduced domain dead or gone (libxl sends XS_RELEASE only on a
+ * soft reset, not on `xl destroy`), and the XS_RELEASE (op 9) handler. Both can
+ * name the same domain, so a second release is a no-op (f_released). Only
+ * toolstack-introduced domains are released; an untracked domid succeeds.
  */
-int xs_release_domain(uint32_t domid)
+static int release_domain(uint32_t domid, const char *why)
 {
 	struct xen_domain *domain = NULL, *iter;
-	int rc;
 
-	/* Find the domain and run the whole release under dl_mutex, exactly like
-	 * put_domain(). Scan directly (NOT get_domain) so we do not bump refcount
-	 * and can inspect f_dom0less before touching it. */
+	/* Scan directly (NOT get_domain) so we do not bump refcount and can
+	 * inspect f_dom0less before touching it. */
 	k_mutex_lock(&dl_mutex, K_FOREVER);
 	SYS_DLIST_FOR_EACH_CONTAINER(&domain_list, iter, node) {
 		if (iter->domid == domid) {
@@ -1448,69 +1539,179 @@ int xs_release_domain(uint32_t domid)
 			break;
 		}
 	}
-	if (!domain) {
-		/* Not tracked (already released / never introduced): idempotent. */
+	if (!domain || domain->f_released) {
+		/* Not tracked, or already released: idempotent. */
 		k_mutex_unlock(&dl_mutex);
 		return 0;
 	}
-	if (domain->f_dom0less) {
-		/* A dom0less domain (e.g. DomD itself) is owned by dom0less_init, not
-		 * by the toolstack. Never tear it down on a stray XS_RELEASE. */
+	if (!domain->f_toolstack) {
+		/* A dom0less domain (e.g. DomD itself) is owned by dom0less_init, and
+		 * one Zephyr created by domain_create(); neither was introduced by the
