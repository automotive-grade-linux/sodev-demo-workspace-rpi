From: Yuichi Kusakabe <yuichi_kusakabe@jp.honda>
Date: Fri, 2 Oct 2026 15:54:00 +0900
Subject: [PATCH] virtio-gpu-gl + sdl2-gl: overlay planes (overlay-planes=N)

With overlay-planes=N (0..3, default 0 = unchanged) the guest sees
max_outputs+N scanouts. The extra ones have no console: SET_SCANOUT on
them binds the resource as overlay k of scanout 0, the device-specific
VIRTIO_GPU_CMD_SET_OVERLAY_POS (0x0120) places it, and a RESOURCE_FLUSH
of its resource presents scanout 0 again. The SDL GL display blends the
overlays over scanout 0 at their positions (premultiplied alpha) every
time it presents scanout 0.

The guest side is the virtio_gpu.overlay_planes=N module parameter
(drm/virtio overlay planes on output 0, zpos 1..N). drm_hwcomposer then
puts the AAOS system bars on the overlays and the app on the primary
plane, and SurfaceFlinger stops compositing on the GPU (RPi4 DomA, a
640x360 video playing in a WebView: dropped frames 35% -> 25% with
Vulkan HWUI, 21% -> 13.5% with GL HWUI; the layer dump shows all three
layers DEVICE).

Note: qemu_gl_run_texture_blit()'s flip has the opposite sense of
egl_fb_blit()'s, so overlays are drawn with flip = y0_top.

Assisted-by: Claude Code:claude-opus-5-5
Signed-off-by: Yuichi Kusakabe <yuichi_kusakabe@jp.honda>
Upstream-Status: Inappropriate [uses device-specific virtio-gpu commands (SET_OVERLAY_POS) that are not in the virtio specification]
---
--- a/include/hw/virtio/virtio-gpu.h
+++ b/include/hw/virtio/virtio-gpu.h
@@ -133,6 +133,22 @@
      * default. The guest's SurfaceFlinger derives its vsync from this.
      */
     uint32_t refresh_rate;
+    /* extra scanouts the guest drives as overlay planes of scanout 0 (0..3) */
+    uint32_t overlay_planes;
+};
+
+#define VIRTIO_GPU_MAX_OVERLAYS 3
+/*
+ * Device-specific command (only with overlay-planes > 0): place overlay plane
+ * scanout_id (one of the extra scanouts) at x, y on scanout 0.
+ */
+#define VIRTIO_GPU_CMD_SET_OVERLAY_POS 0x0120
+struct virtio_gpu_set_overlay_pos {
+    struct virtio_gpu_ctrl_hdr hdr;
+    uint32_t scanout_id;
+    int32_t x;
+    int32_t y;
+    uint32_t padding;
 };
 
 struct virtio_gpu_ctrl_command {
@@ -159,6 +175,12 @@
     MemoryRegion hostmem;
 
     struct virtio_gpu_scanout scanout[VIRTIO_GPU_MAX_SCANOUTS];
+    /* overlay-planes: what overlay k currently shows and where */
+    struct {
+        int32_t x, y;
+        uint32_t tex_id, tex_w, tex_h;
+        bool y0_top, on;
+    } overlay[VIRTIO_GPU_MAX_OVERLAYS];
 
     int enabled_output_bitmask;
     struct virtio_gpu_requested_state req_state[VIRTIO_GPU_MAX_SCANOUTS];
--- a/hw/display/virtio-gpu-base.c
+++ b/hw/display/virtio-gpu-base.c
@@ -27,7 +27,8 @@
 
     g->enable = 0;
 
-    for (i = 0; i < g->conf.max_outputs; i++) {
+    /* the overlay planes' scanouts too, which have no console */
+    for (i = 0; i < g->conf.max_outputs + g->conf.overlay_planes; i++) {
         g->scanout[i].resource_id = 0;
         g->scanout[i].width = 0;
         g->scanout[i].height = 0;
@@ -35,6 +36,7 @@
         g->scanout[i].y = 0;
         g->scanout[i].ds = NULL;
     }
+    memset(g->overlay, 0, sizeof(g->overlay));
 }
 
 void
@@ -198,7 +200,16 @@
         }
     }
 
-    g->virtio_config.num_scanouts = cpu_to_le32(g->conf.max_outputs);
+    if (g->conf.overlay_planes > VIRTIO_GPU_MAX_OVERLAYS ||
+        g->conf.max_outputs + g->conf.overlay_planes > VIRTIO_GPU_MAX_SCANOUTS) {
+        error_setg(errp, "invalid overlay-planes %u (max %d, and max_outputs + "
+                   "overlay-planes <= %d)", g->conf.overlay_planes,
+                   VIRTIO_GPU_MAX_OVERLAYS, VIRTIO_GPU_MAX_SCANOUTS);
+        return false;
+    }
+    /* overlay planes are extra scanouts without a console of their own */
+    g->virtio_config.num_scanouts =
+        cpu_to_le32(g->conf.max_outputs + g->conf.overlay_planes);
     virtio_init(VIRTIO_DEVICE(g), VIRTIO_ID_GPU,
                 sizeof(struct virtio_gpu_config));
 
--- a/hw/display/virtio-gpu-gl.c
+++ b/hw/display/virtio-gpu-gl.c
@@ -179,6 +179,8 @@
                     VIRTIO_GPU_FLAG_STATS_ENABLED, false),
     DEFINE_PROP_BIT("venus", VirtIOGPU, parent_obj.conf.flags,
                     VIRTIO_GPU_FLAG_VENUS_ENABLED, false),
+    DEFINE_PROP_UINT32("overlay-planes", VirtIOGPU,
+                       parent_obj.conf.overlay_planes, 0),
 };
 
 static void virtio_gpu_gl_device_unrealize(DeviceState *qdev)
--- a/hw/display/virtio-gpu-virgl.c
+++ b/hw/display/virtio-gpu-virgl.c
@@ -622,6 +622,85 @@
         }
         virtio_gpu_rect_update(g, i, rf.r.x, rf.r.y, rf.r.width, rf.r.height);
     }
+    /* an overlay changed: present scanout 0 again, the display blends it in */
+    for (i = 0; i < g->parent_obj.conf.overlay_planes; i++) {
+        uint32_t id = g->parent_obj.conf.max_outputs + i;
+
+        if (g->parent_obj.overlay[i].on &&
+            g->parent_obj.scanout[id].resource_id == rf.resource_id) {
+            virtio_gpu_rect_update(g, 0, 0, 0, g->parent_obj.scanout[0].width,
+                                   g->parent_obj.scanout[0].height);
+            break;
+        }
+    }
+}
+
+static void virgl_overlay_publish(VirtIOGPU *g, unsigned int k)
+{
+    VirtIOGPUBase *b = &g->parent_obj;
+
+    dpy_gl_overlay(b->scanout[0].con, k, b->overlay[k].on,
+                   b->overlay[k].tex_id, b->overlay[k].y0_top,
+                   b->overlay[k].tex_w, b->overlay[k].tex_h,
+                   b->overlay[k].x, b->overlay[k].y);
+}
+
+/* SET_SCANOUT on one of the extra scanouts: bind (or drop) overlay plane k */
+static void virgl_cmd_set_overlay(VirtIOGPU *g,
+                                  struct virtio_gpu_ctrl_command *cmd,
+                                  struct virtio_gpu_set_scanout *ss)
+{
+    VirtIOGPUBase *b = &g->parent_obj;
+    unsigned int k = ss->scanout_id - b->conf.max_outputs;
+
+    b->overlay[k].on = false;
+    if (ss->resource_id && ss->r.width && ss->r.height) {
+        struct virgl_renderer_resource_info info;
+
+        memset(&info, 0, sizeof(info));
+        if (virgl_renderer_resource_get_info(ss->resource_id, &info)) {
+            qemu_log_mask(LOG_GUEST_ERROR, "%s: illegal resource specified %d\n",
+                          __func__, ss->resource_id);
+            /* and drop the overlay below, as for resource 0 */
+            cmd->error = VIRTIO_GPU_RESP_ERR_INVALID_RESOURCE_ID;
+        } else {
+            b->overlay[k].tex_id = info.tex_id;
+            b->overlay[k].tex_w = info.width;
+            b->overlay[k].tex_h = info.height;
+            b->overlay[k].y0_top =
+                info.flags & VIRTIO_GPU_RESOURCE_FLAG_Y_0_TOP;
+            b->overlay[k].on = true;
+        }
+    }
+    b->scanout[ss->scanout_id].resource_id = b->overlay[k].on ? ss->resource_id : 0;
+    virgl_renderer_force_ctx_0();
+    virgl_overlay_publish(g, k);
+    if (!b->overlay[k].on && b->scanout[0].width && b->scanout[0].height) {
+        /* nothing else will present the output without the overlay */
+        virtio_gpu_rect_update(g, 0, 0, 0, b->scanout[0].width,
+                               b->scanout[0].height);
+    }
+}
+
+static void virgl_cmd_set_overlay_pos(VirtIOGPU *g,
+                                      struct virtio_gpu_ctrl_command *cmd)
+{
+    VirtIOGPUBase *b = &g->parent_obj;
+    struct virtio_gpu_set_overlay_pos op;
+    unsigned int k;
+
+    VIRTIO_GPU_FILL_CMD(op);
+    if (op.scanout_id < b->conf.max_outputs ||
+        op.scanout_id >= b->conf.max_outputs + b->conf.overlay_planes) {
+        cmd->error = VIRTIO_GPU_RESP_ERR_INVALID_SCANOUT_ID;
+        return;
+    }
+    k = op.scanout_id - b->conf.max_outputs;
+    b->overlay[k].x = op.x;
+    b->overlay[k].y = op.y;
+    if (b->overlay[k].on) {
+        virgl_overlay_publish(g, k);
+    }
 }
 
 static void virgl_cmd_set_scanout(VirtIOGPU *g,
@@ -634,6 +713,13 @@
     trace_virtio_gpu_cmd_set_scanout(ss.scanout_id, ss.resource_id,
                                      ss.r.width, ss.r.height, ss.r.x, ss.r.y);
 
+    if (ss.scanout_id >= g->parent_obj.conf.max_outputs &&
+        ss.scanout_id < g->parent_obj.conf.max_outputs +
+                        g->parent_obj.conf.overlay_planes) {
+        virgl_cmd_set_overlay(g, cmd, &ss);
+        return;
+    }
+
     if (ss.scanout_id >= g->parent_obj.conf.max_outputs) {
         qemu_log_mask(LOG_GUEST_ERROR, "%s: illegal scanout id specified %d",
                       __func__, ss.scanout_id);
@@ -1155,6 +1241,9 @@
     case VIRTIO_GPU_CMD_RESOURCE_FLUSH:
         virgl_cmd_resource_flush(g, cmd);
         break;
+    case VIRTIO_GPU_CMD_SET_OVERLAY_POS:
+        virgl_cmd_set_overlay_pos(g, cmd);
+        break;
     case VIRTIO_GPU_CMD_RESOURCE_UNREF:
         virgl_cmd_resource_unref(g, cmd, &cmd_suspended);
         break;
@@ -1369,6 +1458,14 @@
         dpy_gfx_replace_surface(g->parent_obj.scanout[i].con, NULL);
         dpy_gl_scanout_disable(g->parent_obj.scanout[i].con);
     }
+    /*
+     * Drop the overlays from the display before virgl_renderer_reset() deletes
+     * their textures. virtio_gpu_base_reset() has already cleared their state.
+     */
+    for (i = 0; i < g->parent_obj.conf.overlay_planes; i++) {
+        dpy_gl_overlay(g->parent_obj.scanout[0].con, i, false, 0, false,
+                       0, 0, 0, 0);
+    }
 }
 
 bool virtio_gpu_virgl_ready;
--- a/include/ui/console.h
+++ b/include/ui/console.h
@@ -258,6 +258,11 @@
     /* optional */
     void (*dpy_gl_cursor_position)(DisplayChangeListener *dcl,
                                    uint32_t pos_x, uint32_t pos_y);
+    /* optional: overlay plane idx over the scanout (premultiplied alpha) */
+    void (*dpy_gl_overlay)(DisplayChangeListener *dcl, unsigned int idx,
+                           bool on, uint32_t tex_id, bool y0_top,
+                           uint32_t tex_w, uint32_t tex_h,
+                           int32_t x, int32_t y);
     /* optional */
     void (*dpy_gl_release_dmabuf)(DisplayChangeListener *dcl,
                                   QemuDmaBuf *dmabuf);
@@ -336,6 +341,9 @@
                           bool have_hot, uint32_t hot_x, uint32_t hot_y);
 void dpy_gl_cursor_position(QemuConsole *con,
                             uint32_t pos_x, uint32_t pos_y);
+void dpy_gl_overlay(QemuConsole *con, unsigned int idx, bool on,
+                    uint32_t tex_id, bool y0_top, uint32_t tex_w,
+                    uint32_t tex_h, int32_t x, int32_t y);
 void dpy_gl_release_dmabuf(QemuConsole *con,
                            QemuDmaBuf *dmabuf);
 void dpy_gl_update(QemuConsole *con,
--- a/ui/console.c
+++ b/ui/console.c
@@ -1082,6 +1082,24 @@
     }
 }
 
+void dpy_gl_overlay(QemuConsole *con, unsigned int idx, bool on,
+                    uint32_t tex_id, bool y0_top, uint32_t tex_w,
+                    uint32_t tex_h, int32_t x, int32_t y)
+{
+    DisplayState *s = con->ds;
+    DisplayChangeListener *dcl;
+
+    QLIST_FOREACH(dcl, &s->listeners, next) {
+        if (con != dcl->con) {
+            continue;
+        }
+        if (dcl->ops->dpy_gl_overlay) {
+            dcl->ops->dpy_gl_overlay(dcl, idx, on, tex_id, y0_top,
+                                     tex_w, tex_h, x, y);
+        }
+    }
+}
+
 void dpy_gl_cursor_position(QemuConsole *con,
                             uint32_t pos_x, uint32_t pos_y)
 {
--- a/include/ui/sdl2.h
+++ b/include/ui/sdl2.h
@@ -51,6 +51,12 @@
     egl_fb win_fb;
     bool y0_top;
     bool scanout_mode;
+    /* overlay planes blended over the scanout (see sdl2_gl_overlay) */
+    struct {
+        egl_fb fb;
+        int32_t x, y;
+        bool y0_top, on;
+    } ovl[3];
 #endif
 };
 
@@ -94,6 +100,9 @@
                              uint32_t x, uint32_t y,
                              uint32_t w, uint32_t h,
                              void *d3d_tex2d);
+void sdl2_gl_overlay(DisplayChangeListener *dcl, unsigned int idx, bool on,
+                     uint32_t tex_id, bool y0_top, uint32_t tex_w,
+                     uint32_t tex_h, int32_t x, int32_t y);
 void sdl2_gl_scanout_flush(DisplayChangeListener *dcl,
                            uint32_t x, uint32_t y, uint32_t w, uint32_t h);
 
--- a/ui/sdl2-gl.c
+++ b/ui/sdl2-gl.c
@@ -224,6 +224,66 @@
                          backing_id, false);
 }
 
+void sdl2_gl_overlay(DisplayChangeListener *dcl, unsigned int idx, bool on,
+                     uint32_t tex_id, bool y0_top, uint32_t tex_w,
+                     uint32_t tex_h, int32_t x, int32_t y)
+{
+    struct sdl2_console *scon = container_of(dcl, struct sdl2_console, dcl);
+
+    if (idx >= ARRAY_SIZE(scon->ovl)) {
+        return;
+    }
+    SDL_GL_MakeCurrent(scon->real_window, scon->winctx);
+    /* a texture name can come back for a new resource of another size */
+    if (scon->ovl[idx].fb.texture != tex_id || !on ||
+        scon->ovl[idx].fb.width != tex_w ||
+        scon->ovl[idx].fb.height != tex_h) {
+        egl_fb_destroy(&scon->ovl[idx].fb);
+    }
+    scon->ovl[idx].on = on && tex_id;
+    if (scon->ovl[idx].on && !scon->ovl[idx].fb.framebuffer) {
+        egl_fb_setup_for_tex(&scon->ovl[idx].fb, tex_w, tex_h, tex_id, false);
+    }
+    scon->ovl[idx].x = x;
+    scon->ovl[idx].y = y;
+    scon->ovl[idx].y0_top = y0_top;
+}
+
+/*
+ * Blend the enabled overlays over what egl_fb_blit() just put in the window.
+ * Coordinates are in scanout pixels, origin top-left; the window may be scaled.
+ * The guest composer hands premultiplied buffers, hence GL_ONE.
+ */
+static void sdl2_gl_draw_overlays(struct sdl2_console *scon, int ww, int wh)
+{
+    double sx = scon->w ? (double)ww / scon->w : 1.0;
+    double sy = scon->h ? (double)wh / scon->h : 1.0;
+
+    for (int i = 0; i < ARRAY_SIZE(scon->ovl); i++) {
+        if (!scon->ovl[i].on || !scon->ovl[i].fb.texture) {
+            continue;
+        }
+        int w = scon->ovl[i].fb.width * sx;
+        int h = scon->ovl[i].fb.height * sy;
+        int x = scon->ovl[i].x * sx;
+        int y = scon->ovl[i].y * sy;
+
+        glBindFramebuffer(GL_FRAMEBUFFER_EXT, scon->win_fb.framebuffer);
+        glViewport(x, wh - h - y, w, h);
+        glEnable(GL_TEXTURE_2D);
+        glBindTexture(GL_TEXTURE_2D, scon->ovl[i].fb.texture);
+        glEnable(GL_BLEND);
+        glBlendFunc(GL_ONE, GL_ONE_MINUS_SRC_ALPHA);
+        /*
+         * NOT !y0_top as for egl_fb_blit(): qemu_gl_run_texture_blit's flip
+         * has the opposite sense, and !y0_top drew the system bars upside down
+         * (RPi4 DomA, 2026-10-02).
+         */
+        qemu_gl_run_texture_blit(scon->gls, scon->ovl[i].y0_top);
+        glDisable(GL_BLEND);
+    }
+}
+
 void sdl2_gl_scanout_flush(DisplayChangeListener *dcl,
                            uint32_t x, uint32_t y, uint32_t w, uint32_t h)
 {
@@ -243,6 +303,7 @@
     SDL_GetWindowSize(scon->real_window, &ww, &wh);
     egl_fb_setup_default(&scon->win_fb, ww, wh);
     egl_fb_blit(&scon->win_fb, &scon->guest_fb, !scon->y0_top);
+    sdl2_gl_draw_overlays(scon, ww, wh);
 
     SDL_GL_SwapWindow(scon->real_window);
 }
--- a/ui/sdl2.c
+++ b/ui/sdl2.c
@@ -843,6 +843,7 @@
 
     .dpy_gl_scanout_disable  = sdl2_gl_scanout_disable,
     .dpy_gl_scanout_texture  = sdl2_gl_scanout_texture,
+    .dpy_gl_overlay          = sdl2_gl_overlay,
     .dpy_gl_update           = sdl2_gl_scanout_flush,
 };
 
