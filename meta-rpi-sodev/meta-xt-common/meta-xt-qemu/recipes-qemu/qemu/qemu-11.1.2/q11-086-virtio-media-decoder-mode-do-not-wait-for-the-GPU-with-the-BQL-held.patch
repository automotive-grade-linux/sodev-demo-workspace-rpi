+++ b/hw/virtio/virtio-media-virgl-stub.c
@@ -65,6 +65,11 @@ int virtio_media_gpu_wait(void *handle)
     return 0;
 }
 
+int virtio_media_gpu_poll(void *handle)
+{
+    return 0;
+}
