diff --git a/hw/virtio/virtio-media-decoder.c b/hw/virtio/virtio-media-decoder.c
index 0bb221e37..4dc8431c8 100644
--- a/hw/virtio/virtio-media-decoder.c
+++ b/hw/virtio/virtio-media-decoder.c
@@ -167,6 +167,13 @@ static const DecCodec dec_codecs[] = {
  * buffer when none is free, as long as extra_hw_frames is unset (it is).
  */
 #define DEC_GPU_HOLD 2
+/*
+ * q11-dec-gpu-poll: with a fence fd (gpu-fence-fd=on), a software codec keeps
+ * up to this many frames whose GPU copies are not done, instead of waiting for
+ * the oldest one at DEC_GPU_HOLD. Each is a buffer of the zero-copy pool
+ * (DEC_ZC_MAX), which grows by them.
+ */
+#define DEC_GPU_HOLD_MAX 8
 /* -EAGAIN (no GL context) this many frames in a row is reported once. */
 #define DEC_GPU_AGAIN_WARN 120
 
@@ -282,10 +289,10 @@ typedef struct DecSwSlot {
  * three planes from there (dec_zc_gpu_write): no CPU conversion or copy. The
  * dec_sw_gpu_write staging took about half of the main loop's CPU at H.264
  * 1080p60 on the Raspberry Pi 5. The pool grows to what the decoder holds at
- * once (references, frame threads, DEC_THR_OUT, DEC_GPU_HOLD) and no further
- * than DEC_ZC_MAX; past that a frame takes libavcodec's own buffer and the
- * staging path. It is laid out for one coded size and format: another one
- * starts a new pool, and an old pool lives on until its last buffer is
+ * once (references, frame threads, DEC_THR_OUT, up to DEC_GPU_HOLD_MAX) and
+ * no further than DEC_ZC_MAX; past that a frame takes libavcodec's own buffer
+ * and the staging path. It is laid out for one coded size and format: another
+ * one starts a new pool, and an old pool lives on until its last buffer is
  * released, whichever thread that is on.
  *
  * "Zero-copy" is the CPU's: Mesa v3d samples a linear plane through a tiled
@@ -481,7 +488,7 @@ struct VirtIOMediaDec {
     AVBufferRef *gpu_fctx; /* the hw_frames_ctx the imports came from */
     DecGpuEntry gpu[DEC_GPU_CACHE];
     unsigned gpu_n;
-    DecGpuHeld gpu_held[DEC_GPU_HOLD];
+    DecGpuHeld gpu_held[DEC_GPU_HOLD_MAX];
     unsigned gpu_held_n;
 
     /*
@@ -755,19 +762,69 @@ static int dec_next_cap_buffer(VirtIOMediaSession *s)
 /* ------------------------------------------------------------------------- */
 
 /* Give the oldest held frame back to the decoder once the GPU has read it. */
-static void dec_gpu_unhold_oldest(VirtIOMediaDec *d)
+static void dec_gpu_drop_oldest(VirtIOMediaDec *d)
 {
-    DecGpuHeld *h = &d->gpu_held[0];
-
-    if (virtio_media_gpu_wait(h->handle) < 0) {
-        warn_report_once("virtio-media/dec: host-sand: GPU wait failed");
-    }
-    av_frame_free(&h->frame);
+    av_frame_free(&d->gpu_held[0].frame);
     d->gpu_held_n--;
     memmove(&d->gpu_held[0], &d->gpu_held[1],
             d->gpu_held_n * sizeof(d->gpu_held[0]));
 }
 
+static void dec_gpu_unhold_oldest(VirtIOMediaDec *d)
+{
+    if (virtio_media_gpu_wait(d->gpu_held[0].handle) < 0) {
+        warn_report_once("virtio-media/dec: host-sand: GPU wait failed");
+    }
+    dec_gpu_drop_oldest(d);
+}
+
+/*
+ * q11-dec-gpu-poll: let go of the held frames whose GPU copies are done,
+ * without waiting. Each frame is tested on its own buffer's fence, so none goes
+ * before its copy is done; stopping at the first one not done only keeps a
+ * later frame whose copy finished early until the next call. Returns whether
+ * the oldest one left can be tested without waiting (it has a fence fd).
+ */
+static bool dec_gpu_reap(VirtIOMediaDec *d)
+{
+    while (d->gpu_held_n) {
+        int r = virtio_media_gpu_poll(d->gpu_held[0].handle);
+
+        if (r == 1) {
+            return true;
+        }
+        if (r == -EAGAIN) {
+            return false;
+        }
+        if (r < 0) {
+            warn_report_once("virtio-media/dec: host-sand: GPU poll failed");
+        }
+        dec_gpu_drop_oldest(d);
+    }
+    return true;
+}
+
+/*
+ * Let go of every held frame (a new stream, a flush, the end). Those whose
+ * copies are done go first; the rest are waited for, oldest first, each up to
+ * virtio_media_gpu_wait()'s 200 ms. After one wait fails the GPU is taken to be
+ * stuck and the rest go without waiting, so that the main loop is not held for
+ * DEC_GPU_HOLD_MAX times 200 ms.
+ */
+static void dec_gpu_unhold_all(VirtIOMediaDec *d)
+{
+    bool stuck = false;
+
+    dec_gpu_reap(d);
+    while (d->gpu_held_n) {
+        if (!stuck && virtio_media_gpu_wait(d->gpu_held[0].handle) < 0) {
+            warn_report_once("virtio-media/dec: host-sand: GPU wait failed");
+            stuck = true;
+        }
+        dec_gpu_drop_oldest(d);
+    }
+}
+
 static void dec_ds_drop(VirtIOMediaDec *d);
 
 static void dec_gpu_clear(VirtIOMediaDec *d)
@@ -777,9 +834,7 @@ static void dec_gpu_clear(VirtIOMediaDec *d)
     /* the display's references and fds name these entries' slots */
     dec_ds_drop(d);
     /* the held frames' waits use the imports, so they go first */
-    while (d->gpu_held_n) {
-        dec_gpu_unhold_oldest(d);
-    }
+    dec_gpu_unhold_all(d);
     for (i = 0; i < d->gpu_n; i++) {
         virtio_media_gpu_release(d->gpu[i].handle);
     }
@@ -820,6 +875,19 @@ static void dec_gpu_reset(VirtIOMediaDec *d)
  * reference instead and wait when the frame leaves this queue, DEC_GPU_HOLD
  * frames later, by which time the fence has normally signalled. The proxy
  * waits at the capture buffer's next QBUF for the same reason.
+ *
+ * q11-dec-gpu-poll: the frames whose copies are done go first, without
+ * waiting (dec_gpu_reap). With a fence fd, a software codec (H.264) then does
+ * not wait at DEC_GPU_HOLD either: while the oldest one's copy is not done the
+ * new frame is held beside it, up to DEC_GPU_HOLD_MAX, and the next frame
+ * tries them again. Measured on a Raspberry Pi 5 (2026-10-24, H.264 1080p60 in
+ * a WebView beside the HMI, 30 seconds): the main loop waited for a fence in
+ * virtio_media_gpu_wait() 280 times, up to 48 ms, with the BQL held, while
+ * DomA's sound buffers waited behind it. The frames held are buffers of the
+ * zero-copy pool, which grows by them, so the decoder does not run short. A
+ * hardware codec (HEVC), and a copy without a fence fd (GLsync), still waits
+ * for the oldest one at DEC_GPU_HOLD: HEVC's buffers come from v4l2request's
+ * pool, in CMA.
  */
 static void dec_gpu_hold(VirtIOMediaDec *d, const AVFrame *fr, void *handle)
 {
@@ -835,7 +903,11 @@ static void dec_gpu_hold(VirtIOMediaDec *d, const AVFrame *fr, void *handle)
         }
         return;
     }
-    if (d->gpu_held_n == DEC_GPU_HOLD) {
+    if (dec_gpu_reap(d) && !d->codec->hwaccel) {
+        if (d->gpu_held_n >= DEC_GPU_HOLD_MAX) {
+            dec_gpu_unhold_oldest(d);
+        }
+    } else if (d->gpu_held_n >= DEC_GPU_HOLD) {
         dec_gpu_unhold_oldest(d);
     }
     d->gpu_held[d->gpu_held_n].frame = ref;
@@ -1125,9 +1197,7 @@ static void dec_let_go(VirtIOMediaDec *d)
 {
     dec_ds_release(d);
     av_frame_free(&d->held);
-    while (d->gpu_held_n) {
-        dec_gpu_unhold_oldest(d);
-    }
+    dec_gpu_unhold_all(d);
 }
 
 /* Offer the decoder's buffers now? See DEC_DS_PROBE_MS. */
@@ -1288,9 +1358,7 @@ static bool dec_ds_starved(VirtIOMediaDec *d, int r)
         direct_scanout_forget(d);
         d->ds_epoch = 0;
     }
-    while (d->gpu_held_n) {
-        dec_gpu_unhold_oldest(d);
-    }
+    dec_gpu_unhold_all(d);
     d->ds_backoff_ms = qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + DEC_DS_RETRY_MS;
     return true;
 }
@@ -1918,9 +1986,7 @@ static void dec_zc_gpu_clear(VirtIOMediaDec *d)
     unsigned i;
 
     /* a held frame's wait uses its import */
-    while (d->gpu_held_n) {
-        dec_gpu_unhold_oldest(d);
-    }
+    dec_gpu_unhold_all(d);
     for (i = 0; i < DEC_ZC_MAX; i++) {
         if (d->zc_gpu[i]) {
             virtio_media_gpu_release(d->zc_gpu[i]);
diff --git a/hw/virtio/virtio-media-virgl-stub.c b/hw/virtio/virtio-media-virgl-stub.c
