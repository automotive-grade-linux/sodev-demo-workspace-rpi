 void virtio_media_gpu_set_fence_fd(bool on)
 {
 }
diff --git a/hw/virtio/virtio-media-virgl.c b/hw/virtio/virtio-media-virgl.c
index 0aab9f155..e50a5c845 100644
--- a/hw/virtio/virtio-media-virgl.c
+++ b/hw/virtio/virtio-media-virgl.c
@@ -1068,6 +1068,8 @@ int virtio_media_gpu_blit(void *handle, uint32_t res_id)
     struct virgl_renderer_resource_info info;
     GpuSaved sv;
     GLenum status, gl_err;
+    GLsync old_sync;
+    int old_fd;
     int ret = 0;
 
     if (!b) {
@@ -1097,19 +1099,19 @@ int virtio_media_gpu_blit(void *handle, uint32_t res_id)
     while (glGetError() != GL_NO_ERROR) {
         /* clear stale errors */
     }
-    if (b->sync) {
-        /* Previous copy of this buffer must be gone before we reuse the fence. */
-        glDeleteSync(b->sync);
-        b->sync = NULL;
-    }
-    if (b->sync_fd >= 0) {
-        /*
-         * Same reason, and it must be closed rather than leaked: one fd per
-         * capture buffer per frame would exhaust the process in seconds.
-         */
-        close(b->sync_fd);
-        b->sync_fd = -1;
-    }
+    /*
+     * The previous copy's fence is replaced by this one's, which signals after
+     * it (one context, in order). It is let go once this copy has its fence,
+     * and closed rather than leaked: one fd per capture buffer per frame would
+     * exhaust the process in seconds. A copy that fails keeps it: a frame held
+     * for the previous copy (dec_gpu_hold) still waits for that one. What a
+     * failed copy already submitted has no fence of its own; it only writes
+     * the guest resource the failed frame was for.
+     */
+    old_sync = b->sync;
+    old_fd = b->sync_fd;
+    b->sync = NULL;
+    b->sync_fd = -1;
 
     if (b->nv12) {
         ret = gpu_draw_nv12(b, info.tex_id);
@@ -1185,11 +1187,49 @@ int virtio_media_gpu_blit(void *handle, uint32_t res_id)
     b->sync = glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
     /* Submit now so virgl's next draw (other context) orders behind it. */
     glFlush();
+    if (!b->sync) {
+        ret = -EIO;   /* no fence: keep the previous one, as for a failed copy */
+    }
 out:
+    if (ret == 0) {
+        if (old_sync) {
+            glDeleteSync(old_sync);
+        }
+        if (old_fd >= 0) {
+            close(old_fd);
+        }
+    } else {
+        b->sync = old_sync;
+        b->sync_fd = old_fd;
+    }
     gpu_leave(&sv);
     return ret;
 }
 
+int virtio_media_gpu_poll(void *handle)
+{
+    VirtIOMediaGpuBuf *b = handle;
+    struct pollfd pfd;
+    int r;
+
+    if (!b || (b->sync_fd < 0 && !b->sync)) {
+        return 0;
+    }
+    if (b->sync_fd < 0) {
+        return -EAGAIN;   /* a GLsync: only a current context can test it */
+    }
+    pfd = (struct pollfd) { .fd = b->sync_fd, .events = POLLIN };
+    do {
+        r = poll(&pfd, 1, 0);
+    } while (r < 0 && errno == EINTR);
+    if (r == 0) {
+        return 1;
+    }
+    close(b->sync_fd);
+    b->sync_fd = -1;
+    return r < 0 ? -EIO : 0;
+}
+
 int virtio_media_gpu_wait(void *handle)
 {
     VirtIOMediaGpuBuf *b = handle;
