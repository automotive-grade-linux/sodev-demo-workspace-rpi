+  libavutil = dependency('libavutil', required: false,
+                         method: 'pkg-config')
+  libswscale = dependency('libswscale', required: false,
+                          method: 'pkg-config')
+endif
+have_virtio_media_decoder = libavcodec.found() and libavutil.found() and libswscale.found()
+if not have_virtio_media_decoder
+  libavcodec = not_found
+  libavutil = not_found
