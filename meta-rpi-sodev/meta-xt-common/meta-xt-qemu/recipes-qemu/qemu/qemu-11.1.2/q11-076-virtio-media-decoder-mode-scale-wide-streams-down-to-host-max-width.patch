     }
-    /* Unscaled only: the guest's buffer is the frame's size (see dec_pump). */
-    if ((uint32_t)fr->width != w || (uint32_t)fr->height != h) {
+    if (scaled && !dec_scaled_ok(d, fw, fh, w, h)) {
         return -ENOTSUP;
     }
     l = &desc->layers[0];
@@ -1222,7 +1261,8 @@ static int dec_gpu_write(VirtIOMediaSession *s, VirtIOMediaBuffer *gb,
     col = (uint32_t)DEC_MOD_PARAM(mod);
     uv_offset = (uint32_t)l->planes[1].offset;
