     tex = virtio_media_gpu_res_tex(gb->virgl_res);
-    show = tex && dec_ds_on() && direct_scanout_sand_usable() && dec_ds_wanted(d);
+    /* q11-dec-scale: the display shows a buffer 1:1, so not a scaled one */
+    show = !scaled && tex && dec_ds_on() && direct_scanout_sand_usable() &&
+           dec_ds_wanted(d);
     if (show && e->show_fd < 0) {
         e->show_fd = fcntl(desc->objects[0].fd, F_DUPFD_CLOEXEC, 0);
     }
@@ -1388,7 +1435,7 @@ static void dec_sw_clear(VirtIOMediaDec *d)
         sl->fd = -1;
     }
     d->sw_next = 0;
-    d->sw_w = d->sw_h = 0;
+    d->sw_w = d->sw_h = d->sw_dw = d->sw_dh = 0;
 }
 
 /* A dma-buf of len bytes from the system heap, mapped. */
@@ -1449,9 +1496,13 @@ static int dec_sw_gpu_write(VirtIOMediaSession *s, VirtIOMediaBuffer *gb,
 {
     VirtIOMediaDec *d = s->dec;
     int matrix = dec_gpu_matrix(fr);
-    uint32_t stride = ROUND_UP(w, 64);
-    uint32_t uv_offset = ROUND_UP(stride * h, 4096);
-    size_t len = ROUND_UP((size_t)uv_offset + stride * ((h + 1) / 2), 4096);
+    /* q11-dec-scale: staged at the frame's size, scaled into the guest's */
+    uint32_t fw = (uint32_t)fr->width, fh = (uint32_t)fr->height;
+    bool scaled = fw != w || fh != h;
+    float scale = scaled ? (float)fw / w : 1.0f;
+    uint32_t stride = ROUND_UP(fw, 64);
+    uint32_t uv_offset = ROUND_UP(stride * fh, 4096);
+    size_t len = ROUND_UP((size_t)uv_offset + stride * ((fh + 1) / 2), 4096);
     DecSwSlot *sl;
     uint8_t *dst[4];
     int dst_ls[4] = { 0 };
@@ -1459,19 +1510,22 @@ static int dec_sw_gpu_write(VirtIOMediaSession *s, VirtIOMediaBuffer *gb,
     uint32_t tex;
 
     if (!gb->virgl_res || gb->num_planes != 1 ||
-        (uint32_t)fr->width != w || (uint32_t)fr->height != h) {
+        (scaled && !dec_scaled_ok(d, fw, fh, w, h))) {
