+    if (d->sw_w != fw || d->sw_h != fh || d->sw_dw != w || d->sw_dh != h ||
+        d->sw_matrix != matrix) {
         dec_sw_clear(d);
-        d->sw_w = w;
-        d->sw_h = h;
+        d->sw_w = fw;
+        d->sw_h = fh;
+        d->sw_dw = w;
