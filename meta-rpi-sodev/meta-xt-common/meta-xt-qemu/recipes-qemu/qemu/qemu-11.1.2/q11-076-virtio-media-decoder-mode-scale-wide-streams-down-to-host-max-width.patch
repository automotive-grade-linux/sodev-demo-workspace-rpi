+        if (d->gpu_n && (d->gpu[0].w != w || d->gpu[0].h != h ||
+                         d->gpu[0].src_w != fw || d->gpu[0].src_h != fh)) {
             dec_gpu_clear(d);
         }
         if (d->gpu_n == DEC_GPU_CACHE) {
@@ -1267,11 +1309,12 @@ static int dec_gpu_write(VirtIOMediaSession *s, VirtIOMediaBuffer *gb,
         }
         e = &d->gpu[d->gpu_n];
         e->handle = s->vm->host_sand == 2
