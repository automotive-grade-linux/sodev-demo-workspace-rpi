-            : virtio_media_gpu_import_nv12(fd, w, h, w, uv_offset, w, h, 1.0f,
+            : virtio_media_gpu_import_nv12(fd, fw, fh, fw, uv_offset, w, h,
+                                           scale,
                                            (uint32_t)desc->objects[0].size,
                                            matrix, col, &err);
         if (!e->handle) {
@@ -1281,6 +1324,8 @@ static int dec_gpu_write(VirtIOMediaSession *s, VirtIOMediaBuffer *gb,
         e->ino = st.st_ino;
         e->w = w;
         e->h = h;
+        e->src_w = fw;
+        e->src_h = fh;
         e->matrix = matrix;
         e->show_fd = -1;
         e->seq = 0;
@@ -1293,7 +1338,9 @@ static int dec_gpu_write(VirtIOMediaSession *s, VirtIOMediaBuffer *gb,
     /* q11-dec-sand-scanout: offer the decoder's buffer to the display */
