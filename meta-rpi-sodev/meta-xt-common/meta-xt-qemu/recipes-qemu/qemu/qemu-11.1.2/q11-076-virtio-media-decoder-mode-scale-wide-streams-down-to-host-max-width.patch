     dev_t dev;
     ino_t ino;
     uint32_t w, h;
+    uint32_t src_w, src_h;   /* q11-dec-scale: the frame's size */
     int matrix;
     void *handle;
     /* q11-dec-sand-scanout: the buffer as the display sees it (dec_ds_*) */
@@ -338,6 +339,12 @@ struct VirtIOMediaDec {
      */
     bool stream_fmt_known;
     uint32_t stream_w, stream_h;
+    /*
+     * q11-dec-scale: host-max-width. A stream wider than this reaches the
+     * guest scaled down to it (dec_guest_dims): coded_w/h is then the
+     * guest's size and stream_w/h stays the decoder's.
+     */
+    uint32_t max_w;
 
     /* Event subscriptions. Unsubscribed events must not be sent. */
     bool sub_source_change;
@@ -426,6 +433,7 @@ struct VirtIOMediaDec {
     DecSwSlot sw[DEC_SW_RING];
     unsigned sw_next;
     uint32_t sw_w, sw_h, sw_stride, sw_uv_offset;
+    uint32_t sw_dw, sw_dh;   /* q11-dec-scale: the guest's size */
     int sw_matrix;
     bool sw_off;      /* the GPU path failed for this stream: CPU from now on */
     bool sw_logged;
@@ -501,6 +509,31 @@ static void dec_norm_dims(uint32_t *w, uint32_t *h)
     *h = (hh + 1) & ~1u;
 }
 
+/* q11-dec-scale: the guest-facing size of the stream. */
+static void dec_guest_dims(const VirtIOMediaDec *d, uint32_t *w, uint32_t *h)
+{
+    virtio_media_scaled_size(d->max_w, d->stream_w, d->stream_h, w, h);
+    dec_norm_dims(w, h);
+}
+
+/*
+ * q11-dec-scale: may a fw x fh frame go into the guest's w x h buffer, scaled
+ * by the one ratio the shader uses? Only when host-max-width made that size.
+ * A guest that chose another size itself (no SOURCE_CHANGE subscription) is
+ * scaled on the CPU, axis by axis.
+ */
+static bool dec_scaled_ok(const VirtIOMediaDec *d, uint32_t fw, uint32_t fh,
+                          uint32_t w, uint32_t h)
+{
+    uint32_t gw, gh;
+
+    if (!d->max_w || fw != d->stream_w || fh != d->stream_h) {
+        return false;
+    }
+    dec_guest_dims(d, &gw, &gh);
+    return w == gw && h == gh;
+}
+
 static uint32_t dec_cap_sizeimage(uint32_t w, uint32_t h)
 {
     /*
@@ -1203,12 +1236,18 @@ static int dec_gpu_write(VirtIOMediaSession *s, VirtIOMediaBuffer *gb,
     unsigned i;
