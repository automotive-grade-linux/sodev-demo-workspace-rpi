     for (unsigned i = 0; i < DEC_SW_RING; i++) {
         d->sw[i].fd = -1;
     }
@@ -2699,8 +2760,7 @@ static int dec_s_fmt(VirtIOMediaDec *d, struct v4l2_format *f)
         uint32_t w = pix->width, h = pix->height;
 
         if (d->stream_fmt_known) {
-            w = d->stream_w;
-            h = d->stream_h;
+            dec_guest_dims(d, &w, &h);
         }
         /*
          * ALWAYS, not only in the else branch. Without it the stream-known path
@@ -2764,6 +2824,20 @@ static int dec_g_selection(VirtIOMediaDec *d, struct v4l2_selection *sel)
         sel->r.top = 0;
         sel->r.width = d->visible_w ? d->visible_w : d->coded_w;
         sel->r.height = d->visible_h ? d->visible_h : d->coded_h;
+        /*
+         * q11-dec-scale: in the guest's pixels, by the one ratio the shader
+         * uses, the width's (as the proxy's host-max-width does)
+         */
+        if (d->max_w && d->stream_fmt_known && d->coded_w != d->stream_w) {
+            sel->r.width = MIN(virtio_media_scale_coord(sel->r.width,
+                                                        d->coded_w,
+                                                        d->stream_w),
+                               d->coded_w);
+            sel->r.height = MIN(virtio_media_scale_coord(sel->r.height,
+                                                         d->coded_w,
+                                                         d->stream_w),
+                                d->coded_h);
+        }
         return 0;
     default:
         return EINVAL;
