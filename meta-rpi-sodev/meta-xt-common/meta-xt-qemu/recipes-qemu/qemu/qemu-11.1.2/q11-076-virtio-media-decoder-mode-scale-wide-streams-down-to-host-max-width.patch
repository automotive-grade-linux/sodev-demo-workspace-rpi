         d->sw_uv_offset = uv_offset;
         d->sw_matrix = matrix;
         sws_freeContext(d->sws_nv12);
         /* YUVJ420P is YUV420P with full range, which the matrix carries */
-        d->sws_nv12 = sws_getContext(w, h, AV_PIX_FMT_YUV420P, w, h,
+        d->sws_nv12 = sws_getContext(fw, fh, AV_PIX_FMT_YUV420P, fw, fh,
                                      AV_PIX_FMT_NV12, SWS_POINT,
                                      NULL, NULL, NULL);
         if (!d->sws_nv12) {
@@ -1491,9 +1545,10 @@ static int dec_sw_gpu_write(VirtIOMediaSession *s, VirtIOMediaBuffer *gb,
         if (fd < 0) {
             return -errno;
         }
-        sl->handle = virtio_media_gpu_import_nv12(fd, w, h, stride, uv_offset,
-                                                  w, h, 1.0f, (uint32_t)len,
-                                                  matrix, 0, &err);
+        sl->handle = virtio_media_gpu_import_nv12(fd, fw, fh, stride,
+                                                  uv_offset, w, h, scale,
+                                                  (uint32_t)len, matrix, 0,
+                                                  &err);
         if (!sl->handle) {
             return err ? err : -EINVAL;
         }
@@ -1533,7 +1588,7 @@ static int dec_sw_gpu_write(VirtIOMediaSession *s, VirtIOMediaBuffer *gb,
         d->sw_logged = true;
         info_report("virtio-media/dec: sw-gpu: %s frames reach the guest on "
                     "the GPU (linear NV12 %ux%u, stride %u, matrix %d)",
-                    d->codec->desc, w, h, stride, matrix);
+                    d->codec->desc, fw, fh, stride, matrix);
     }
     return 0;
 }
@@ -2314,8 +2369,7 @@ static void dec_pump(VirtIOMediaSession *s)
                  * no renegotiation coming, so its chosen format must stay put and
                  * dec_write_frame() scales into it.
                  */
-                d->coded_w = d->stream_w;
-                d->coded_h = d->stream_h;
+                dec_guest_dims(d, &d->coded_w, &d->coded_h);
                 /*
                  * Hold this frame across the renegotiation rather than dropping
                  * it: it is the IDR the guest has to start decoding from.
@@ -2430,6 +2484,12 @@ bool virtio_media_dec_realize(VirtIOMedia *vm, Error **errp)
                    vm->decoder);
         return false;
     }
+    /* q11-dec-scale: no narrower than the smallest CAPTURE size (DEC_MIN_W) */
+    if (vm->host_max_width && vm->host_max_width < DEC_MIN_W) {
+        error_setg(errp, "virtio-media: host-max-width must be 0 or at least "
+                   "%d in decoder mode", DEC_MIN_W);
+        return false;
+    }
     /*
      * device_caps is what the guest reads out of config space, and
