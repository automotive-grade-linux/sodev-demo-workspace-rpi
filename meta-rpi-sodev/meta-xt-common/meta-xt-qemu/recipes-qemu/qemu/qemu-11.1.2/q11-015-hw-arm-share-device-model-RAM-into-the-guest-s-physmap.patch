+/*
+ * x86 does not share device-model RAM into the guest's p2m at all -- its
+ * arch_xen_set_memory() relocates guest RAM for the VGA framebuffer -- so there
+ * is nothing for a caller to withdraw.
+ */
+bool xen_dm_ram_share_failed(void)
+{
+    return false;
+}
+
+/* x86 never shares device-model RAM, so it has no use for the buffer either. */
+void xen_dm_set_blob_dmabuf(int fd)
+{
+    if (fd >= 0) {
+        close(fd);
+    }
+}
+
+void xen_dm_clear_blob_dmabuf(void)
+{
+}
