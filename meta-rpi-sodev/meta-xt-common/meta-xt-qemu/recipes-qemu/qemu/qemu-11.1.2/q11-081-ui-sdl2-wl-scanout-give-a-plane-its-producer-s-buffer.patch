+/*
+ * q11-plane-sand (on while /run/qemu-plane-sand exists, read once a second): a
+ * plane whose guest texture a producer filled from a buffer of its own -- the
+ * decoder's SAND frame, the video of the WebView layout -- gets that buffer, as
+ * a lone full-screen scanout does (sdl2_wl_scanout), instead of the export of
+ * the texture: the producer may skip the conversion into the texture, and the
+ * compositor scales the frame (a 4K frame on a 1080p plane) on the HVS. The
+ * buffer is a WlScanBuf of the direct path, so the owner hears hold(true) when
+ * it goes on the plane and hold(false) when weston releases it; unlike a
+ * texture's export the guest does not overwrite it in place, the producer
+ * keeps it until then.
+ */
+static bool plane_sand_flag(void)
+{
+    static int64_t last = INT64_MIN;
+    static bool on;
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+
+    if (last == INT64_MIN || now - last > NANOSECONDS_PER_SECOND) {
+        last = now;
+        on = access("/run/qemu-plane-sand", F_OK) == 0;
+    }
+    return on;
+}
+
+/*
+ * The producer's buffer for plane i showing texture tex (tw x th) of resource res, or
+ * NULL. Not one that names another resource (the GL name was given to a new one, the
+ * reason plane_buf keys its cache by resource too), nor one of another size that does
+ * not say what area of the texture it fills (the proxy's).
+ */
+static WlPlaneBuf *plane_sand(int i, uint32_t tex, uint32_t tw, uint32_t th, uint32_t res)
+{
+    DirectScanout d;
+    WlScanBuf *sb;
+    WlPlaneBuf *pb = &pl.sand[i];
