 static uint32_t streak;
 static int64_t last_hit_ms;
-static void *catch_up_owner;
-static void (*catch_up_fn)(void *owner);
+/*
+ * q11-plane-sand: owner -> catch-up, for each producer that skipped and has not
+ * made all its conversions since
+ */
+static GHashTable *catch_ups;
+/* q11-plane-sand: the owners whose buffers the display took in this flush */
+static GHashTable *shown;
+/* q11-plane-sand: ... and in the last flush, if it was a hit (may skip) */
+static GHashTable *taken;
+
+static void sets_init(void)
+{
+    if (!catch_ups) {
+        catch_ups = g_hash_table_new(g_direct_hash, g_direct_equal);
+        shown = g_hash_table_new(g_direct_hash, g_direct_equal);
+        taken = g_hash_table_new(g_direct_hash, g_direct_equal);
+    }
+}
+
+void direct_scanout_set_catch_up(void *owner, bool (*fn)(void *owner))
+{
+    sets_init();
+    g_hash_table_insert(catch_ups, owner, fn);
+}
 
-void direct_scanout_set_catch_up(void *owner, void (*fn)(void *owner))
+void direct_scanout_note_shown(void *owner)
 {
-    catch_up_owner = owner;
-    catch_up_fn = fn;
+    sets_init();
+    g_hash_table_add(shown, owner);
+}
+
+static gboolean not_shown(gpointer owner, gpointer fn, gpointer unused)
+{
+    return !g_hash_table_contains(shown, owner);
+}
+
+/* the catch-up makes a bounded number of conversions: keep its entry until done */
+static gboolean run_catch_up(gpointer owner, gpointer fn, gpointer unused)
+{
+    return ((bool (*)(void *))fn)(owner);
 }
 
 void direct_scanout_note_flush(bool hit)
 {
+    GHashTable *t;
+
+    sets_init();
+    /*
+     * a producer that skipped and is not on the display now: its textures may
+     * be sampled
+     */
+    if (hit && g_hash_table_find(catch_ups, not_shown, NULL)) {
+        hit = false;
+    }
+    g_hash_table_remove_all(taken);
     if (hit) {
+        t = taken;
+        taken = shown;
+        shown = t;
         if (streak < UINT32_MAX) {
             streak++;
         }
         last_hit_ms = qemu_clock_get_ms(QEMU_CLOCK_REALTIME);
         return;
     }
+    g_hash_table_remove_all(shown);
     streak = 0;
-    if (catch_up_fn) {
-        catch_up_fn(catch_up_owner);
-    }
+    g_hash_table_foreach_remove(catch_ups, run_catch_up, NULL);
 }
 
 /* q11-dec-sand-scanout: the display took a producer's buffer in the last ms */
@@ -84,7 +130,7 @@ bool direct_scanout_hit_within(int64_t ms)
     return streak && qemu_clock_get_ms(QEMU_CLOCK_REALTIME) - last_hit_ms < ms;
 }
 
