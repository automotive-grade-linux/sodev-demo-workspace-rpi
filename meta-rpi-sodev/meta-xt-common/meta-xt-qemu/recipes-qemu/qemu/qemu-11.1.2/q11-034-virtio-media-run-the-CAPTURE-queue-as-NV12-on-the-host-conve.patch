+/*
+ * Import one plane of a dmabuf as a 2D texture. Context must be current.
+ * Returns 0 or a GL texture name.
+ */
+static GLuint gpu_import_plane(int fd, uint32_t fourcc, uint32_t width,
+                               uint32_t height, uint32_t stride,
+                               uint32_t offset)
+{
+    EGLImageKHR img;
+    GLuint tex = 0;
+    EGLint attrs[] = {
+        EGL_WIDTH, width,
+        EGL_HEIGHT, height,
+        EGL_LINUX_DRM_FOURCC_EXT, fourcc,
+        EGL_DMA_BUF_PLANE0_FD_EXT, fd,
+        EGL_DMA_BUF_PLANE0_OFFSET_EXT, offset,
+        EGL_DMA_BUF_PLANE0_PITCH_EXT, stride,
+        EGL_DMA_BUF_PLANE0_MODIFIER_LO_EXT, (EGLint)(VM_DRM_FORMAT_MOD_LINEAR & 0xffffffffu),
+        EGL_DMA_BUF_PLANE0_MODIFIER_HI_EXT, (EGLint)(VM_DRM_FORMAT_MOD_LINEAR >> 32),
+        EGL_NONE
+    };
+
+    if (!gpu_have_egl_ext(gpu.dpy, "EGL_EXT_image_dma_buf_import_modifiers")) {
+        attrs[12] = EGL_NONE;
+    }
+    img = eglCreateImageKHR(gpu.dpy, EGL_NO_CONTEXT, EGL_LINUX_DMA_BUF_EXT,
+                            NULL, attrs);
+    if (img == EGL_NO_IMAGE_KHR) {
+        qemu_log("virtio-media-diag: gpu_xfer: eglCreateImageKHR(fourcc %08x "
+                 "%ux%u stride %u off %u fd %d) failed (0x%x)\n", fourcc, width,
+                 height, stride, offset, fd, eglGetError());
+        return 0;
+    }
+    while (glGetError() != GL_NO_ERROR) {
+        /* clear stale errors */
+    }
+    glGenTextures(1, &tex);
+    glBindTexture(GL_TEXTURE_2D, tex);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    glEGLImageTargetTexture2DOES(GL_TEXTURE_2D, (GLeglImageOES)img);
+    glBindTexture(GL_TEXTURE_2D, 0);
+    eglDestroyImageKHR(gpu.dpy, img);
+    if (glGetError() != GL_NO_ERROR) {
+        qemu_log("virtio-media-diag: gpu_xfer: glEGLImageTargetTexture2DOES "
+                 "(fourcc %08x) failed\n", fourcc);
+        glDeleteTextures(1, &tex);
+        return 0;
+    }
+    return tex;
+}
+
+static const char *nv12_vs =
+    "#version 300 es\n"
+    "void main() {\n"
+    "  vec2 p = vec2((gl_VertexID & 1) * 4 - 1, (gl_VertexID & 2) * 2 - 1);\n"
+    "  gl_Position = vec4(p, 0.0, 1.0);\n"
+    "}\n";
+/*
+ * gl_FragCoord is in destination pixels; the destination may be wider than
+ * the source (gralloc pads the row), so sample by texel and let
+ * CLAMP_TO_EDGE repeat the last column. The RGBA resource is sampled by the
+ * guest with y=0 at the top of the image, as is the V4L2 buffer, so no flip.
+ */
+static const char *nv12_fs =
+    "#version 300 es\n"
+    "precision highp float;\n"
+    "uniform sampler2D u_y;\n"
+    "uniform sampler2D u_uv;\n"
+    "uniform vec2 u_src_size;\n"
+    "uniform float u_yoff;\n"
+    "uniform float u_yscale;\n"
+    "uniform vec4 u_coef;\n"   /* r_cr, g_cb, g_cr, b_cb */
+    "out vec4 o;\n"
+    "void main() {\n"
+    "  vec2 uv = gl_FragCoord.xy / u_src_size;\n"
+    "  float y = (texture(u_y, uv).r - u_yoff) * u_yscale;\n"
+    "  vec2 c = texture(u_uv, uv).rg - vec2(0.5);\n"
+    "  float r = y + u_coef.x * c.y;\n"
+    "  float g = y + u_coef.y * c.x + u_coef.z * c.y;\n"
+    "  float b = y + u_coef.w * c.x;\n"
+    "  o = vec4(clamp(vec3(r, g, b), 0.0, 1.0), 1.0);\n"
+    "}\n";
+
+static GLuint gpu_compile(GLenum type, const char *src)
+{
+    GLuint sh = glCreateShader(type);
+    GLint ok = 0;
+
+    glShaderSource(sh, 1, &src, NULL);
+    glCompileShader(sh);
+    glGetShaderiv(sh, GL_COMPILE_STATUS, &ok);
+    if (!ok) {
+        char log[512] = "";
+        glGetShaderInfoLog(sh, sizeof(log), NULL, log);
+        qemu_log("virtio-media-diag: gpu_xfer: shader compile failed: %s\n", log);
+        glDeleteShader(sh);
+        return 0;
+    }
+    return sh;
+}
+
+static bool gpu_build_nv12_program(void)
+{
+    GLuint vs, fs;
+    GLint ok = 0;
+
+    if (gpu.prog) {
+        return true;
+    }
+    if (gpu.prog_failed) {
+        return false;
+    }
+    vs = gpu_compile(GL_VERTEX_SHADER, nv12_vs);
+    fs = gpu_compile(GL_FRAGMENT_SHADER, nv12_fs);
+    if (!vs || !fs) {
+        gpu.prog_failed = true;
+        return false;
+    }
+    gpu.prog = glCreateProgram();
+    glAttachShader(gpu.prog, vs);
+    glAttachShader(gpu.prog, fs);
+    glLinkProgram(gpu.prog);
+    glDeleteShader(vs);
+    glDeleteShader(fs);
+    glGetProgramiv(gpu.prog, GL_LINK_STATUS, &ok);
+    if (!ok) {
+        char log[512] = "";
+        glGetProgramInfoLog(gpu.prog, sizeof(log), NULL, log);
+        qemu_log("virtio-media-diag: gpu_xfer: program link failed: %s\n", log);
+        glDeleteProgram(gpu.prog);
+        gpu.prog = 0;
+        gpu.prog_failed = true;
+        return false;
+    }
+    gpu.u_y = glGetUniformLocation(gpu.prog, "u_y");
+    gpu.u_uv = glGetUniformLocation(gpu.prog, "u_uv");
+    gpu.u_src_size = glGetUniformLocation(gpu.prog, "u_src_size");
+    gpu.u_yoff = glGetUniformLocation(gpu.prog, "u_yoff");
+    gpu.u_yscale = glGetUniformLocation(gpu.prog, "u_yscale");
+    gpu.u_coef = glGetUniformLocation(gpu.prog, "u_coef");
+    return true;
+}
+
+void *virtio_media_gpu_import_nv12(int dmabuf_fd, uint32_t src_width,
+                                   uint32_t src_height, uint32_t stride,
+                                   uint32_t uv_offset, uint32_t dst_width,
+                                   uint32_t len, int matrix, int *err)
+{
+    GpuSaved sv;
+    VirtIOMediaGpuBuf *b;
+
+    if (!gpu_enter(&sv)) {
+        close(dmabuf_fd);
+        if (err) {
+            *err = gpu.tried && gpu.ctx == EGL_NO_CONTEXT ? -ENOTSUP : -EAGAIN;
+        }
+        return NULL;
+    }
+    if (!gpu_build_nv12_program()) {
+        gpu_leave(&sv);
+        close(dmabuf_fd);
+        if (err) {
+            *err = -ENOTSUP;
+        }
+        return NULL;
+    }
+    b = g_new0(VirtIOMediaGpuBuf, 1);
+    b->fd = dmabuf_fd;
+    b->nv12 = true;
+    b->width = dst_width;
+    b->height = src_height;
+    b->src_width = src_width;
+    b->stride = stride;
+    b->len = len;
+    b->matrix = matrix;
+    b->tex = gpu_import_plane(dmabuf_fd, VM_DRM_FORMAT_R8, src_width,
+                              src_height, stride, 0);
+    b->tex_uv = b->tex ? gpu_import_plane(dmabuf_fd, VM_DRM_FORMAT_GR88,
+                                          src_width / 2, src_height / 2,
+                                          stride, uv_offset) : 0;
+    if (!b->tex || !b->tex_uv) {
+        if (b->tex) {
+            glDeleteTextures(1, &b->tex);
+        }
+        gpu_leave(&sv);
+        close(dmabuf_fd);
+        g_free(b);
+        if (err) {
+            *err = -EINVAL;
+        }
+        return NULL;
+    }
+    gpu_leave(&sv);
+    return b;
+}
+
+/* Draw the NV12 planes into the destination texture. Context is current. */
+static int gpu_draw_nv12(VirtIOMediaGpuBuf *b, GLuint dst_tex)
+{
+    /* Coefficients for (r_cr, g_cb, g_cr, b_cb) and the luma range. */
+    static const float coef601[4] = { 1.402f, -0.344136f, -0.714136f, 1.772f };
+    static const float coef709[4] = { 1.5748f, -0.187324f, -0.468124f, 1.8556f };
+    const float *coef = (b->matrix & 1) ? coef709 : coef601;
+    bool full = b->matrix & 2;
+    float yoff = full ? 0.0f : 16.0f / 255.0f;
+    float yscale = full ? 1.0f : 255.0f / 219.0f;
+    float cscale = full ? 1.0f : 255.0f / 224.0f;
+    float c[4] = { coef[0] * cscale, coef[1] * cscale, coef[2] * cscale,
+                   coef[3] * cscale };
+    GLenum status;
+
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, gpu.draw_fbo);
+    glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                           GL_TEXTURE_2D, dst_tex, 0);
+    status = glCheckFramebufferStatus(GL_DRAW_FRAMEBUFFER);
+    if (status != GL_FRAMEBUFFER_COMPLETE) {
+        glBindFramebuffer(GL_DRAW_FRAMEBUFFER, 0);
+        return -EIO;
+    }
+    glDisable(GL_SCISSOR_TEST);
+    glDisable(GL_BLEND);
+    glDisable(GL_DEPTH_TEST);
+    glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+    glViewport(0, 0, b->width, b->height);
+    glUseProgram(gpu.prog);
+    glActiveTexture(GL_TEXTURE0);
+    glBindTexture(GL_TEXTURE_2D, b->tex);
+    glActiveTexture(GL_TEXTURE1);
+    glBindTexture(GL_TEXTURE_2D, b->tex_uv);
+    glUniform1i(gpu.u_y, 0);
+    glUniform1i(gpu.u_uv, 1);
+    glUniform2f(gpu.u_src_size, (float)b->src_width, (float)b->height);
+    glUniform1f(gpu.u_yoff, yoff);
+    glUniform1f(gpu.u_yscale, yscale);
+    glUniform4fv(gpu.u_coef, 1, c);
+    glBindVertexArray(0);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+    glBindTexture(GL_TEXTURE_2D, 0);
+    glActiveTexture(GL_TEXTURE0);
+    glBindTexture(GL_TEXTURE_2D, 0);
+    glUseProgram(0);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, 0);
+    return 0;
+}
