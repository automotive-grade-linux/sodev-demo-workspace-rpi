diff --git a/hw/virtio/virtio-media.c b/hw/virtio/virtio-media.c
index 4b8977736..0e1040c2c 100644
--- a/hw/virtio/virtio-media.c
+++ b/hw/virtio/virtio-media.c
@@ -170,6 +170,140 @@ static void virtio_media_queue_release(VirtIOMediaSession *s, VirtIOMediaQueue *
     q->num_host_planes = 0;
     q->streaming = false;
