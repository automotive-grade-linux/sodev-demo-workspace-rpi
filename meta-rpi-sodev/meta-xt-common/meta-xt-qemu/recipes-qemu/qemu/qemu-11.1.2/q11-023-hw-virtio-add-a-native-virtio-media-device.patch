diff --git a/include/hw/virtio/virtio-media.h b/include/hw/virtio/virtio-media.h
new file mode 100644
index 000000000..c990d788f
--- /dev/null
+++ b/include/hw/virtio/virtio-media.h
@@ -0,0 +1,233 @@
+/*
+ * VIRTIO-MEDIA device -- proxies a host V4L2 device into the guest.
+ *
+ * On this platform the device model runs in DomD, which owns the only real
+ * video hardware (bcm2835-codec, /dev/video10..13 on a Raspberry Pi 4), so the
+ * host side of virtio-media is a plain V4L2 client: guest ioctls are forwarded
+ * to a file descriptor on a host /dev/videoN.
+ *
+ * WHY A NATIVE DEVICE AND NOT A vhost-user BACKEND.
+ * The upstream way to host virtio-media is vhost-user; there is no in-tree
+ * device model in any QEMU release. vhost-user does not work under Xen: QEMU's
+ * implementation requires every guest memory region to be backed by a file
+ * descriptor (vhost_user_get_mr_data -> memory_region_get_fd), and the Xen
+ * machines' RAM regions are anonymous memory_region_init_ram() blocks with no
+ * fd, so the memory table cannot be built at all. That is what
+ * VHOST_USER_PROTOCOL_F_XEN_MMAP would fix, and it is still unimplemented in
+ * QEMU master (2026-08). A native device has no such problem: it reaches guest
+ * memory through address_space_map(), the same path the virtio-blk, virtio-net
+ * and virtio-snd devices on this board already use.
+ *
+ * WHY USERPTR ONLY.
+ * virtio-media's MMAP buffers live in a VIRTIO shared memory region, which on
+ * virtio-pci is a BAR, and the machinery to expose one only landed in QEMU
+ * 11.1.0. USERPTR needs none of it: the driver serialises the guest pages of
+ * each buffer as an array of virtio_media_sg_entry {u64 start; u32 len;} into
+ * the device-readable part of the descriptor chain
+ * (scatterlist_builder_add_buffer_userptr), so this device only ever maps plain
+ * guest physical addresses. With the DMABUF support the guest kernel patches
+ * add, the driver sends a DMABUF buffer as USERPTR runs as well, and that
+ * needs no module parameter: virtio-media.ko's allow_userptr gates only a
+ * queue whose user space itself asks for V4L2_MEMORY_USERPTR
+ * (virtio_media_reqbufs() in virtio_media_ioctls.c).
+ *
+ * This depends on the domain being configured with grant_usage=0 (foreign
+ * mapping), which doma.cfg does. Grant mapping would require the guest to
+ * grant each page, and deferred mapping of arbitrary guest addresses is exactly
+ * what that model forbids.
+ *
+ * DQBUF NEVER REACHES THIS DEVICE. The driver serves VIDIOC_DQBUF from its own
+ * queue->pending_dqbufs list (virtio_media_ioctls.c virtio_media_dqbuf), which
+ * is filled by VIRTIO_MEDIA_EVT_DQBUF events on the event queue. So buffer
+ * completion is an event this device sends, not an ioctl it answers.
+ */
+
+#ifndef QEMU_VIRTIO_MEDIA_H
+#define QEMU_VIRTIO_MEDIA_H
+
+#include <linux/videodev2.h>
+
+#include "hw/virtio/virtio.h"
+#include "qom/object.h"
+#include "qemu/queue.h"
+
+#define TYPE_VIRTIO_MEDIA "virtio-media-device"
+OBJECT_DECLARE_SIMPLE_TYPE(VirtIOMedia, VIRTIO_MEDIA)
+
+/* Commands and events, from the driver's protocol.h. */
+#define VIRTIO_MEDIA_CMD_OPEN   1
+#define VIRTIO_MEDIA_CMD_CLOSE  2
+#define VIRTIO_MEDIA_CMD_IOCTL  3
+#define VIRTIO_MEDIA_CMD_MMAP   4
+#define VIRTIO_MEDIA_CMD_MUNMAP 5
+
+#define VIRTIO_MEDIA_EVT_ERROR  0
+#define VIRTIO_MEDIA_EVT_DQBUF  1
+#define VIRTIO_MEDIA_EVT_EVENT  2
+
+/*
+ * All of these are byte-for-byte the driver's structures. They are plain
+ * host-endian: virtio-media has no endianness conversion and both sides of
+ * this link are aarch64 little-endian, which is also why the v4l2 structures
+ * below can be passed to the host kernel unmodified.
+ */
+struct virtio_media_cmd_header {
+    uint32_t cmd;
+    uint32_t padding;
+};
+
+struct virtio_media_resp_header {
+    uint32_t status;
+    uint32_t padding;
+};
+
+struct virtio_media_cmd_open {
+    struct virtio_media_cmd_header hdr;
+};
+
+struct virtio_media_resp_open {
+    struct virtio_media_resp_header hdr;
+    uint32_t session_id;
+    uint32_t padding;
+};
+
+struct virtio_media_cmd_close {
+    struct virtio_media_cmd_header hdr;
+    uint32_t session_id;
+    uint32_t padding;
+};
+
+struct virtio_media_cmd_ioctl {
+    struct virtio_media_cmd_header hdr;
+    uint32_t session_id;
+    uint32_t code;
+};
+
+struct virtio_media_resp_ioctl {
+    struct virtio_media_resp_header hdr;
+};
+
+struct virtio_media_sg_entry {
+    uint64_t start;
+    uint32_t len;
+    uint32_t reserved;
+};
+
+struct virtio_media_event_header {
+    uint32_t event;
+    uint32_t session_id;
+};
+
+struct virtio_media_event_error {
+    struct virtio_media_event_header hdr;
+    uint32_t err;
+    uint32_t reserved;
+};
+
+struct virtio_media_event_dqbuf {
+    struct virtio_media_event_header hdr;
+    struct v4l2_buffer buffer;
+    struct v4l2_plane planes[VIDEO_MAX_PLANES];
+};
+
+struct virtio_media_event_event {
+    struct virtio_media_event_header hdr;
+    struct v4l2_event event;
+};
+
+/*
+ * The driver posts event buffers of exactly this size and rejects a longer
+ * reply, so it is a protocol constant and not a choice made here
+ * (VIRTIO_MEDIA_EVENT_MAX_SIZE in the driver's protocol.h).
+ */
+#define VIRTIO_MEDIA_EVENT_MAX_SIZE sizeof(struct virtio_media_event_dqbuf)
+
+/*
+ * Enough for any single V4L2 ioctl payload plus the arrays that follow it: a
+ * v4l2_buffer with VIDEO_MAX_PLANES planes and one SG list per plane. A 4 KiB
+ * page holds 4096 bytes, so 1024 entries covers a 4 MiB plane -- larger than
+ * any 4K NV12 plane -- and the guest's own descriptor chain is bounded well
+ * below that anyway (DESC_CHAIN_MAX_LEN).
+ */
+#define VIRTIO_MEDIA_CMD_BUF_SIZE (256 * 1024)
+
+/*
+ * One guest USERPTR buffer, remembered between QBUF and completion.
+ *
+ * The guest hands over its pages at QBUF time and the frame only exists later,
+ * so the SG list has to be kept. Only the descriptions are kept, never a live
+ * mapping: holding an address_space_map() across an unbounded wait would pin a
+ * bounce buffer for as long as the session lives, and the guest may have
+ * dozens of buffers queued. Pages are mapped at completion, copied, unmapped.
+ */
+typedef struct VirtIOMediaPlaneSg {
+    uint32_t nents;
+    uint32_t len;
+    struct virtio_media_sg_entry *ents;
+} VirtIOMediaPlaneSg;
+
+typedef struct VirtIOMediaBuffer {
+    bool queued;
+    uint32_t num_planes;          /* 1 for single-planar */
+    VirtIOMediaPlaneSg planes[VIDEO_MAX_PLANES];
+} VirtIOMediaBuffer;
+
+#define VIRTIO_MEDIA_MAX_BUFFERS 32
+
+typedef struct VirtIOMediaQueue {
+    uint32_t type;                /* the v4l2_buf_type this state is for */
+    bool mplane;
+    bool streaming;
+    uint32_t num_bufs;
+    uint32_t num_host_planes;
+    /* Host MMAP buffers this device allocated on the host fd, mmap()ed. */
+    void *host_map[VIRTIO_MEDIA_MAX_BUFFERS][VIDEO_MAX_PLANES];
+    uint32_t host_len[VIRTIO_MEDIA_MAX_BUFFERS][VIDEO_MAX_PLANES];
+    /* Guest buffers by index, mirrored onto the host buffer of the same index. */
+    VirtIOMediaBuffer guest[VIRTIO_MEDIA_MAX_BUFFERS];
+} VirtIOMediaQueue;
+
+typedef struct VirtIOMediaSession {
+    struct VirtIOMedia *vm;
+    uint32_t id;
+    int fd;
+    /*
+     * Two queues per session is all a codec needs, and it is what the guest
+     * driver models too (VIRTIO_MEDIA_LAST_QUEUE). Indexed by
+     * virtio_media_queue_index().
+     */
+    VirtIOMediaQueue queues[2];
+    QLIST_ENTRY(VirtIOMediaSession) next;
+} VirtIOMediaSession;
+
+struct VirtIOMedia {
+    VirtIODevice parent_obj;
+
+    /* Properties. */
+    char *v4l2_device;            /* host /dev/videoN to proxy */
+
+    VirtQueue *command_vq;
+    VirtQueue *event_vq;
+
+    /*
+     * Config space, exactly as the driver reads it:
+     *   u32 @0  device_caps  (virtio_media_driver.c:895)
+     *   u32 @4  device_type  (video_register_device type, :908)
+     * Both come from the host device at realize time so the guest sees the
+     * real capabilities rather than something invented here.
+     */
+    uint32_t device_caps;
+    uint32_t device_type;
+
+    uint32_t next_session_id;
+    QLIST_HEAD(, VirtIOMediaSession) sessions;
+
+    /*
+     * Scratch for one command. The command queue is drained from the main loop
+     * and never re-entered, so one buffer is enough and it keeps a per-command
+     * allocation out of the path.
+     */
+    uint8_t *cmd_buf;
+};
+
+#endif /* QEMU_VIRTIO_MEDIA_H */
diff --git a/include/standard-headers/linux/virtio_ids.h b/include/standard-headers/linux/virtio_ids.h
index 6c12db16f..1c2f2e56e 100644
--- a/include/standard-headers/linux/virtio_ids.h
+++ b/include/standard-headers/linux/virtio_ids.h
@@ -69,6 +69,14 @@
 #define VIRTIO_ID_BT			40 /* virtio bluetooth */
 #define VIRTIO_ID_GPIO			41 /* virtio gpio */
 #define VIRTIO_ID_SPI			45 /* virtio spi */
+/*
+ * 48 is virtio-media. Not in this copy of the header because the device was
+ * standardised later; the number is fixed by the virtio-media specification
+ * and is what the guest driver's id_table matches
+ * (virtio_media_driver.c:39). Re-checked against qemu 11.1.2: the header
+ * stops at 45 (spi), so 48 is free.
+ */
+#define VIRTIO_ID_MEDIA			48 /* virtio media */
 
 /*
  * Virtio Transitional IDs
