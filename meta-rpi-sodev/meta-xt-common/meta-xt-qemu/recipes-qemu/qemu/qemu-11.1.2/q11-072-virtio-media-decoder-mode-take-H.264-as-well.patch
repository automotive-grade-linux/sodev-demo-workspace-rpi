+/*
+ * q11-dec-h264: a frame libavcodec could not decode (AVERROR_INVALIDDATA: a
+ * damaged or truncated slice, frequent in streamed H.264) is that frame lost,
+ * not the stream: it used to end the session with EIO.
+ */
+static bool dec_bad_data(int r)
+{
+    if (r != AVERROR_INVALIDDATA) {
+        return false;
+    }
+    warn_report_once("virtio-media/dec: libavcodec could not decode a frame "
+                     "(invalid data); skipping it");
+    return true;
+}
