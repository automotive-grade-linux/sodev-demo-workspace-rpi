+/* Is c among the codecs decoder= names? */
+static bool dec_codec_on(const VirtIOMedia *vm, const DecCodec *c)
+{
+    g_auto(GStrv) names = g_strsplit(vm->decoder, "+", -1);
+
+    return g_strv_contains((const gchar * const *)names, c->name);
+}
+
+/* The index-th codec this device offers, or NULL. */
+static const DecCodec *dec_codec_nth(const VirtIOMedia *vm, uint32_t index)
+{
+    size_t i;
+
+    for (i = 0; i < ARRAY_SIZE(dec_codecs); i++) {
+        if (dec_codec_on(vm, &dec_codecs[i]) && index-- == 0) {
+            return &dec_codecs[i];
+        }
+    }
+    return NULL;
+}
+
+static const DecCodec *dec_codec_by_fourcc(const VirtIOMedia *vm,
+                                           uint32_t fourcc)
+{
+    size_t i;
+
+    for (i = 0; i < ARRAY_SIZE(dec_codecs); i++) {
+        if (dec_codecs[i].fourcc == fourcc && dec_codec_on(vm, &dec_codecs[i])) {
+            return &dec_codecs[i];
+        }
+    }
+    return NULL;
+}
