@@ -1481,6 +1518,37 @@ static bool dec_deliver(VirtIOMediaSession *s, AVFrame *fr)
     return true;
 }
 
+/*
+ * q11-dec-h264: libavcodec's send, receive and flush. avctx is NULL only when
+ * dec_codec_switch could not open a decoder again.
+ */
+/* avcodec_send_packet; pkt NULL starts a drain. */
+static int dec_av_send(VirtIOMediaDec *d, const AVPacket *pkt)
+{
+    if (!d->avctx) {
+        return AVERROR(ENODEV);
+    }
+    return avcodec_send_packet(d->avctx, pkt);
+}
+
+/* avcodec_receive_frame. */
+static int dec_av_receive(VirtIOMediaDec *d, AVFrame *frame)
+{
+    if (!d->avctx) {
+        return AVERROR(ENODEV);
+    }
+    return avcodec_receive_frame(d->avctx, frame);
+}
+
+/* avcodec_flush_buffers. */
+static void dec_av_flush(VirtIOMediaDec *d)
+{
+    if (!d->avctx) {
+        return;
+    }
+    avcodec_flush_buffers(d->avctx);
+}
