+/*
+ * q11-dec-h264: the bitstreams this mode takes. decoder= names the ones a
+ * device offers: "hevc", "h264", or both joined by '+' (',' separates -device
+ * options), in any order: ENUM_FMT lists them in this table's order, and a
+ * session starts with the first. The Raspberry Pi 5 has no H.264 block, so
+ * H.264 is libavcodec's software decoder; it is offered here because DomD's
+ * libavcodec decodes it faster than the guest's software decoder does.
+ */
+typedef struct DecCodec {
+    const char *name;      /* in decoder= */
+    uint32_t fourcc;
+    const char *desc;      /* ENUM_FMT */
+    const char *av_name;   /* avcodec_find_decoder_by_name */
+    bool hwaccel;          /* try the v4l2request hwaccel (rpi-hevc-dec) */
+} DecCodec;
+
+static const DecCodec dec_codecs[] = {
+    { "hevc", V4L2_PIX_FMT_HEVC, "HEVC", "hevc", true },
+    { "h264", V4L2_PIX_FMT_H264, "H.264", "h264", false },
+};
