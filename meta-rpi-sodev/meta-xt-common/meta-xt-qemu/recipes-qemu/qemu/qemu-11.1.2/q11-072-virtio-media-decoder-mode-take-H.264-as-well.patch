+/* S_FMT(OUTPUT) with another bitstream: decode that one from now on. */
+static int dec_codec_switch(VirtIOMediaSession *s, const DecCodec *c)
+{
+    VirtIOMediaDec *d = s->dec;
+    const DecCodec *old = d->codec;
+
+    if (c == d->codec && d->avctx) {
+        return 0;
+    }
+    if (s->queues[0].num_bufs || s->queues[0].streaming ||
+        s->queues[1].streaming) {
+        return EBUSY;
+    }
+    dec_gpu_reset(d);
+    dec_backlog_clear(d);
+    av_frame_free(&d->held);
+    avcodec_free_context(&d->avctx);
+    d->stream_fmt_known = false;
+    d->awaiting_reconfig = false;
+    d->draining = false;
+    d->drain_done = false;
+    d->hw_logged = false;
+    d->gpu_logged = false;
+    d->codec = c;
+    if (dec_codec_open(d) == 0) {
+        return 0;
+    }
+    /* keep a working decoder: the old one */
+    d->codec = old;
+    return dec_codec_open(d) == 0 ? EINVAL : ENODEV;
+}
