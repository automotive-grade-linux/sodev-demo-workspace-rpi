diff --git a/audio/audio-mixeng-be.c b/audio/audio-mixeng-be.c
index f7d73d856..85ae45e26 100644
--- a/audio/audio-mixeng-be.c
+++ b/audio/audio-mixeng-be.c
@@ -684,6 +684,39 @@ static int audio_mixeng_backend_get_buffer_size_out(AudioBackend *be, SWVoiceOut
     return sw->hw->samples * sw->hw->info.bytes_per_frame;
 }
 
+/*
+ * Whether audio_be_write() on a voice may run on a thread of its own, without
+ * the BQL. Only for ALSA with the mixing engine off and no poll mode: the write
+ * then goes straight to snd_pcm_writei(), with no mixing or emulated buffer
+ * and no poll handler shared with the main loop. Every other backend or mode
+ * shares such state with the main loop. Fixed settings must be off too, for
+ * another reason: the PCM must take the guest's own format and rate.
+ *
+ * The main loop still drives the PCM itself (the audio timer's
+ * enable_out(false) on a pending disable, START's prepare, the VM state
+ * handlers), so the caller must keep its writes apart from those: virtio-snd
+ * writes only under the stream's queue_mutex, with the stream active and the
+ * VM running, and clears those first (see virtio_snd_tx_thread()).
+ */
+bool audio_be_out_write_any_thread(AudioBackend *be)
+{
+#ifdef CONFIG_AUDIO_ALSA
+    AudioMixengBackend *s = (AudioMixengBackend *)
+        object_dynamic_cast(OBJECT(be), TYPE_AUDIO_MIXENG_BACKEND);
+    AudiodevPerDirectionOptions *pdo;
+
+    if (!s || s->dev->driver != AUDIODEV_DRIVER_ALSA) {
+        return false;
+    }
+    pdo = audio_get_pdo_out(s->dev);
+    /* fixed-settings off: the PCM takes the guest's own frames */
+    return !pdo->mixing_engine && !pdo->fixed_settings &&
+           !s->dev->u.alsa.out->try_poll;
+#else
+    return false;
+#endif
+}
+
 static void audio_mixeng_backend_set_active_out(AudioBackend *be, SWVoiceOut *sw,
                                                 bool on)
 {
diff --git a/hw/audio/virtio-snd.c b/hw/audio/virtio-snd.c
index 1aebe3602..63037570b 100644
--- a/hw/audio/virtio-snd.c
+++ b/hw/audio/virtio-snd.c
@@ -96,25 +96,98 @@ static const Property virtio_snd_properties[] = {
      * 10000 for period-length=20000.
      */
     DEFINE_PROP_UINT32("tx-poll-us", VirtIOSound, tx_poll_us, 0),
+    /*
+     * With tx-poll-us, write TX buffers out from the TX thread without the
+     * BQL, which the main loop may hold for longer than the backend's buffer
+     * lasts. Giving them back to the guest needs the BQL: the TX thread does
+     * it when the BQL is free (a try), the main loop otherwise. Needs an ALSA
+     * audiodev with out.mixing-engine=off, out.try-poll=off and
+     * out.fixed-settings=off (see audio_be_out_write_any_thread()).
+     */
+    DEFINE_PROP_BOOL("tx-no-bql", VirtIOSound, tx_no_bql, false),
 };
 
+static void virtio_snd_tx_drain_no_bql(VirtIOSoundPCMStream *stream);
+static void virtio_snd_tx_done_bh(void *opaque);
+
 /*
- * TX drain thread. See the tx-poll-us property.
+ * TX drain thread. See the tx-poll-us and tx-no-bql properties.
+ *
+ * By default it calls the very same drain function the audio backend's
+ * callback calls, with available=INT_MAX: AUD_write() returns short when the
+ * backend is full and the loop inside already treats a 0-byte write as "stop".
+ * The BQL is held across that drain because the audio subsystem expects it, so
+ * this thread waits only for the longest single BQL hold instead of for
+ * everything the main loop has queued behind the video.
  *
- * It calls the very same drain function the audio backend's callback calls,
- * with available=INT_MAX: AUD_write() returns short when the backend is full
- * and the loop inside already treats a 0-byte write as "stop". The BQL is held
- * across the drain because the audio subsystem expects it, so this thread waits
- * only for the longest single BQL hold instead of for everything the main loop
- * has queued behind the video.
+ * With tx-no-bql it takes no BQL: each active stream is written out under its
+ * queue_mutex (virtio_snd_tx_drain_no_bql) and the buffers done go back to the
+ * guest from virtio_snd_tx_done_bh.
  */
 static void *virtio_snd_tx_thread(void *opaque)
 {
     VirtIOSound *vsnd = opaque;
 
-    /* virtqueue_push() and the memory API it reaches read under RCU */
     rcu_register_thread();
     while (!qatomic_read(&vsnd->tx_thread_stop)) {
+        if (vsnd->tx_no_bql) {
+            bool done = false;
+
+            for (uint32_t i = 0; i < vsnd->snd_conf.streams; i++) {
+                /* all made at realize, before this thread; freed after its join */
+                VirtIOSoundPCMStream *stream = vsnd->pcm.streams[i];
+
+                if (!stream) {
+                    continue;
+                }
+                WITH_QEMU_LOCK_GUARD(&stream->queue_mutex) {
+                    if (stream->info.direction == VIRTIO_SND_D_OUTPUT
+                        && stream->voice.out && stream->active
+                        && qatomic_read(&vsnd->tx_vm_running)) {
+                        virtio_snd_tx_drain_no_bql(stream);
+                    }
+                    /*
+                     * A ring not ready keeps its buffers: nothing to give
+                     * back. Read without the BQL: a racy but harmless test
+                     * (the bottom half tests it again under the BQL).
+                     */
+                    done |= !QSIMPLEQ_EMPTY(&stream->done) &&
+                            virtio_queue_ready(QSIMPLEQ_FIRST(&stream->done)->vq);
+                }
+            }
+            /*
+             * Give the buffers back now if the BQL is free, as the ioreq thread
+             * answers an ISR read: through the bottom half they waited for the
+             * main loop, up to ~95 ms behind the video, and the guest, with its
+             * few buffers all here, had nothing left to send meanwhile. Only a
+             * try: no stream lock is held, and a busy BQL leaves it to the
+             * bottom half as before.
+             */
+            /* a stopped VM is not touched: its buffers go back when it runs */
+            if (done && qatomic_read(&vsnd->tx_vm_running)) {
+                if (bql_trylock()) {
+                    /*
+                     * The bottom half's reentrancy guard, which a direct call
+                     * would skip: giving a buffer back writes guest memory
+                     * the guest chose, and an access that reached this
+                     * device's own registers must not run its handlers here,
+                     * under this thread's call (aio_bh_call() does the same).
+                     */
+                    MemReentrancyGuard *g = &qdev_get_parent_bus(
+                        DEVICE(vsnd))->parent->mem_reentrancy_guard;
+                    bool engaged = g->engaged_in_io;
+
+                    g->engaged_in_io = true;
+                    virtio_snd_tx_done_bh(vsnd);
+                    g->engaged_in_io = engaged;
+                    bql_unlock();
+                } else {
+                    qemu_bh_schedule(vsnd->tx_done_bh);
+                }
+            }
+            g_usleep(vsnd->tx_poll_us);
+            continue;
+        }
         bql_lock();
         if (vsnd->pcm.streams) {
             for (uint32_t i = 0; i < vsnd->snd_conf.streams; i++) {
@@ -448,8 +521,10 @@ static void virtio_snd_pcm_close(VirtIOSoundPCMStream *stream)
     if (stream) {
         virtio_snd_pcm_flush(stream);
         if (stream->info.direction == VIRTIO_SND_D_OUTPUT) {
-            audio_be_close_out(stream->s->audio_be, stream->voice.out);
-            stream->voice.out = NULL;
+            WITH_QEMU_LOCK_GUARD(&stream->queue_mutex) {
+                audio_be_close_out(stream->s->audio_be, stream->voice.out);
+                stream->voice.out = NULL;
+            }
         } else if (stream->info.direction == VIRTIO_SND_D_INPUT) {
             audio_be_close_in(stream->s->audio_be, stream->voice.in);
             stream->voice.in = NULL;
@@ -490,6 +565,7 @@ static uint32_t virtio_snd_pcm_prepare(VirtIOSound *s, uint32_t stream_id)
         stream->latency_bytes = 0;
         qemu_mutex_init(&stream->queue_mutex);
         QSIMPLEQ_INIT(&stream->queue);
+        QSIMPLEQ_INIT(&stream->done);
 
         /*
          * stream_id >= s->snd_conf.streams was checked before so this is
@@ -499,6 +575,10 @@ static uint32_t virtio_snd_pcm_prepare(VirtIOSound *s, uint32_t stream_id)
     }
 
     virtio_snd_get_qemu_audsettings(&as, params);
+    /*
+     * Written outside queue_mutex, which the TX thread reads it under: always
+     * the same value for a stream id, so the race is harmless.
+     */
     stream->info.direction = stream_id < s->snd_conf.streams / 2 +
         (s->snd_conf.streams & 1) ? VIRTIO_SND_D_OUTPUT : VIRTIO_SND_D_INPUT;
     stream->info.hdr.hda_fn_nid = VIRTIO_SOUND_HDA_FN_NID;
@@ -507,21 +587,32 @@ static uint32_t virtio_snd_pcm_prepare(VirtIOSound *s, uint32_t stream_id)
     stream->info.channels_max = as.nchannels;
     stream->info.formats = supported_formats;
     stream->info.rates = supported_rates;
-    stream->params = *params;
-
     stream->positions[0] = VIRTIO_SND_CHMAP_FL;
     stream->positions[1] = VIRTIO_SND_CHMAP_FR;
-    stream->as = as;
 
     if (stream->info.direction == VIRTIO_SND_D_OUTPUT) {
-        stream->voice.out = audio_be_open_out(s->audio_be,
-                                         stream->voice.out,
-                                         "virtio-sound.out",
-                                         stream,
-                                         virtio_snd_pcm_out_cb,
-                                         &as);
-        audio_be_set_volume_out_lr(s->audio_be, stream->voice.out, 0, 255, 255);
+        /* the TX thread may be writing with the settings and voice replaced */
+        WITH_QEMU_LOCK_GUARD(&stream->queue_mutex) {
+            stream->params = *params;
+            stream->as = as;
+            stream->voice.out = audio_be_open_out(s->audio_be,
+                                             stream->voice.out,
+                                             "virtio-sound.out",
+                                             stream,
+                                             virtio_snd_pcm_out_cb,
+                                             &as);
+            /*
+             * A voice opened again (other settings) starts disabled, and may
