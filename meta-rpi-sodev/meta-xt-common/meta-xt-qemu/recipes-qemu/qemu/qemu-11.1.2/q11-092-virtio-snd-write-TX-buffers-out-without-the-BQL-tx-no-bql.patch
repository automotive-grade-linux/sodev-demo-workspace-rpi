 error_cleanup:
@@ -1207,6 +1353,99 @@ static inline void return_tx_buffer(VirtIOSoundPCMStream *stream,
     virtio_snd_pcm_buffer_free(buffer);
 }
 
+/*
+ * tx-no-bql: give one written-out TX buffer back to the guest, without the
+ * notification. BQL and queue_mutex held (the main loop, or the TX thread when
+ * its bql_trylock() succeeded); the buffer is on no list any more.
+ */
+static void virtio_snd_tx_give_back(VirtIOSoundPCMStream *stream,
+                                    VirtIOSoundPCMBuffer *buffer)
+{
+    virtio_snd_pcm_status resp = { 0 };
+
+    resp.status = cpu_to_le32(VIRTIO_SND_S_OK);
+    resp.latency_bytes = cpu_to_le32(stream->latency_bytes);
+    iov_from_buf(buffer->elem->in_sg, buffer->elem->in_num, 0, &resp,
+                 sizeof(virtio_snd_pcm_status));
+    virtqueue_push(buffer->vq, buffer->elem, sizeof(virtio_snd_pcm_status));
+}
+
+/*
+ * tx-no-bql, BQL held (the main loop's bottom half, or the TX thread after a
+ * successful bql_trylock()): give back what the TX thread has written out, and
+ * notify the queue of the last buffer given back (there is one TX queue).
+ */
+static void virtio_snd_tx_done_bh(void *opaque)
+{
+    VirtIOSound *vsnd = opaque;
+    VirtIOSoundPCMBuffer *buffer;
+    VirtQueue *vq = NULL;
+
+    for (uint32_t i = 0; i < vsnd->snd_conf.streams; i++) {
+        VirtIOSoundPCMStream *stream = vsnd->pcm.streams[i];
+
+        if (!stream) {
+            continue;
+        }
+        WITH_QEMU_LOCK_GUARD(&stream->queue_mutex) {
+            while (!QSIMPLEQ_EMPTY(&stream->done)) {
+                buffer = QSIMPLEQ_FIRST(&stream->done);
+                if (!virtio_queue_ready(buffer->vq)) {
+                    break; /* left for virtio_snd_reset() */
+                }
+                QSIMPLEQ_REMOVE_HEAD(&stream->done, entry);
+                virtio_snd_tx_give_back(stream, buffer);
+                vq = buffer->vq;
+                virtio_snd_pcm_buffer_free(buffer);
+            }
+        }
+    }
+    if (vq) {
+        virtio_notify(VIRTIO_DEVICE(vsnd), vq);
+    }
+}
+
+/*
+ * tx-no-bql, TX thread: write the stream's queued buffers out, queue_mutex
+ * held and the BQL not. Only the guest's memory (mapped when the element was
+ * popped) and the backend's own write (mixing engine off) are touched; a
+ * finished buffer moves to the done list for virtio_snd_tx_done_bh.
+ */
+static void virtio_snd_tx_drain_no_bql(VirtIOSoundPCMStream *stream)
+{
+    VirtIOSoundPCMBuffer *buffer;
+    size_t size;
+
+    size_t frame = audio_format_bits(stream->as.fmt) / 8 * stream->as.nchannels;
+
+    while (!QSIMPLEQ_EMPTY(&stream->queue)) {
+        buffer = QSIMPLEQ_FIRST(&stream->queue);
+        if (!buffer->populated) {
+            iov_to_buf(buffer->elem->out_sg, buffer->elem->out_num,
+                       sizeof(virtio_snd_pcm_xfer), buffer->data,
+                       buffer->size);
+            buffer->populated = true;
+        }
+        /* the backend writes whole frames: less than one would never go */
+        if (buffer->size >= frame) {
+            size = audio_be_write(stream->s->audio_be, stream->voice.out,
+                                  buffer->data + buffer->offset, buffer->size);
+            if (size == 0) {
+                return; /* the backend is full */
+            }
+            buffer->size -= size;
+            buffer->offset += size;
+            update_latency(stream, size);
+            if (buffer->size >= frame) {
+                return;
+            }
+        }
+        update_latency(stream, buffer->size);
+        QSIMPLEQ_REMOVE_HEAD(&stream->queue, entry);
+        QSIMPLEQ_INSERT_TAIL(&stream->done, buffer, entry);
+    }
+}
+
