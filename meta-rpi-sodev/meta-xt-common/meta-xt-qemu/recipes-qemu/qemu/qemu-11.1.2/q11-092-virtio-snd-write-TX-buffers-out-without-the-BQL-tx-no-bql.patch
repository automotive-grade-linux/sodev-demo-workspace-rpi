+                    stream->active = true;
+                } else {
+                    stream->active = false;
+                    audio_be_set_active_out(s->audio_be, stream->voice.out, false);
+                }
+            } else {
+                stream->active = start;
+                audio_be_set_active_in(s->audio_be, stream->voice.in, start);
+            }
