         while (!QSIMPLEQ_EMPTY(&stream->queue)) {
             buffer = QSIMPLEQ_FIRST(&stream->queue);
@@ -1381,6 +1625,14 @@ static inline void virtio_snd_pcm_flush(VirtIOSoundPCMStream *stream)
         return_rx_buffer;
 
