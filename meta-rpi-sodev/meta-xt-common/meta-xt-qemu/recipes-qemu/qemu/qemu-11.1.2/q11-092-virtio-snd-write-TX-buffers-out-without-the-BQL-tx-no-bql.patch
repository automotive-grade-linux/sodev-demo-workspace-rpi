  * audio_be_* output callback.
  *
@@ -1219,6 +1458,11 @@ static void virtio_snd_pcm_out_cb(void *data, int available)
     VirtIOSoundPCMBuffer *buffer;
     size_t size;
 
+    if (stream->s->tx_no_bql) {
