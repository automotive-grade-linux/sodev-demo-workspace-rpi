index 1fa45b5bf..19ec88c73 100644
--- a/include/hw/xen/xen-hvm-common.h
+++ b/include/hw/xen/xen-hvm-common.h
@@ -2,6 +2,8 @@
 #define HW_XEN_HVM_COMMON_H
 
 #include "qemu/queue.h"
+#include "qemu/thread.h"
+#include "qemu/event_notifier.h"
 #include "exec/hwaddr.h"
 #include "hw/xen/xen_native.h"
 #include "hw/xen/xen_backend_ops.h"
@@ -76,6 +78,19 @@ typedef struct XenIOState {
 
     bool has_bufioreq;
 
+    /*
+     * ioreq thread (QEMU_XEN_IOREQ_THREAD=1), see xen_ioreq_thread() in
+     * xen-hvm-common.c. ioreq_thread_on is set once it has been started; the
+     * thread sets ioreq_notifier for each ioreq it queues.
+     */
+    QemuThread ioreq_thread;
+    QemuMutex ioreq_lock;
+    QSIMPLEQ_HEAD(, XenIoreqItem) ioreq_fifo;
+    EventNotifier ioreq_notifier;
+    bool ioreq_thread_on;
+    uint64_t ioreq_early;
+    uint64_t ioreq_queued;
+
     Notifier exit;
 } XenIOState;
 
