index 000000000..ebf6ade43
--- /dev/null
+++ b/hw/virtio/virtio-media-isp.c
@@ -0,0 +1,342 @@
+/*
+ * virtio-media: host-isp -- convert the codec's NV12 CAPTURE frames to RGBA with the
+ * VideoCore ISP (bcm2835-codec-isp, an M2M device) instead of the GL shader, so V3D
+ * only has a same-format RGBA copy left per frame.
+ *
+ * Why (RPi4): at 1080p60 the GL conversion (TFU shadow copy of the 1920x1088
+ * NV12 frame plus the scaling draw) stretches every V3D job, the display blit included,
+ * from ~2.5 ms to 3-12 ms; the blit's GPU completion goes from 5.7 ms (720p) to 12 ms
+ * and weston's flips drop from 60/s to ~33/s. Measured on DomD, the VPU decodes 1080p
+ * and runs the ISP at the same time at 76 and 72 frames/s.
+ *
+ * The ISP cannot write the guest's virgl resource directly: bcm2835-codec imports
+ * dmabufs through vc_sm_cma and needs them physically contiguous, and a v3d BO is not
+ * ("contiguous chunk is too small 3670016/3717120", vc_sm_cma_import_dmabuf -12).
+ * So the OUTPUT queue takes the codec's CAPTURE buffer (CMA, exported with
+ * VIDIOC_EXPBUF) as a dmabuf, and the CAPTURE queue is a small ring of the ISP's own
+ * MMAP buffers (CMA), exported once so the caller can import them into GL and copy
+ * each converted frame into the guest resource (a full-surface same-format copy, which
+ * Mesa v3d turns into one TFU job, ~0.7 ms at 1280x720).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+
+#include <sys/ioctl.h>
+#include <linux/videodev2.h>
+
+#include "qemu/log.h"
+#include "hw/virtio/virtio-media-isp.h"
+
+#define ISP_DEV "/dev/video12"
+
+struct VirtIOMediaIsp {
+    int fd;
+    uint32_t nsrc;
+    uint32_t nring;
+    uint32_t dst_len;
+    int dst_fd[VIRTIO_MEDIA_ISP_MAX_RING];
+    /*
+     * The two queues complete independently (bcm2835-codec: buffered, ignore_cap_streaming,
+     * separate ip/op buffer callbacks), so each keeps its own count.
+     */
+    uint32_t cap_in_flight;
+    uint32_t src_in_flight;
+};
+
+/* CmaFree from /proc/meminfo in kB, or -1: the ring is 4-6 x 3.7 MB of the CMA pool */
+static long isp_cma_free_kb(void)
+{
+    g_autofree char *mi = NULL;
+    const char *p;
+
+    if (!g_file_get_contents("/proc/meminfo", &mi, NULL, NULL)) {
+        return -1;
+    }
+    p = strstr(mi, "CmaFree:");
+    return p ? strtol(p + 8, NULL, 10) : -1;
+}
+
+static int isp_set_fmt(int fd, uint32_t type, uint32_t fourcc, uint32_t w, uint32_t h,
+                       uint32_t bpl, uint32_t sizeimage, int matrix, bool rgb,
+                       uint32_t *bpl_out, uint32_t *size_out)
+{
+    struct v4l2_format f = { .type = type };
+
+    f.fmt.pix_mp.width = w;
+    f.fmt.pix_mp.height = h;
+    f.fmt.pix_mp.pixelformat = fourcc;
+    f.fmt.pix_mp.field = V4L2_FIELD_NONE;
+    f.fmt.pix_mp.num_planes = 1;
+    f.fmt.pix_mp.plane_fmt[0].bytesperline = bpl;
+    f.fmt.pix_mp.plane_fmt[0].sizeimage = sizeimage;
+    if (rgb) {
+        f.fmt.pix_mp.colorspace = V4L2_COLORSPACE_SRGB;
+        f.fmt.pix_mp.quantization = V4L2_QUANTIZATION_FULL_RANGE;
+    } else {
+        /* matrix: bit 0 = BT.709 (else BT.601), bit 1 = full range */
+        f.fmt.pix_mp.colorspace = (matrix & 1) ? V4L2_COLORSPACE_REC709
+                                               : V4L2_COLORSPACE_SMPTE170M;
+        f.fmt.pix_mp.ycbcr_enc = (matrix & 1) ? V4L2_YCBCR_ENC_709
+                                              : V4L2_YCBCR_ENC_601;
+        f.fmt.pix_mp.quantization = (matrix & 2) ? V4L2_QUANTIZATION_FULL_RANGE
+                                                 : V4L2_QUANTIZATION_LIM_RANGE;
+    }
+    if (ioctl(fd, VIDIOC_S_FMT, &f) < 0) {
+        return -errno;
+    }
+    if (f.fmt.pix_mp.width != w || f.fmt.pix_mp.height != h ||
+        f.fmt.pix_mp.pixelformat != fourcc) {
+        return -EINVAL;
+    }
+    *bpl_out = f.fmt.pix_mp.plane_fmt[0].bytesperline;
+    *size_out = f.fmt.pix_mp.plane_fmt[0].sizeimage;
+    return 0;
+}
+
+/* S_SELECTION target on queue type, rect (0, 0, w, h). 0 or -errno. */
+static int isp_set_sel(int fd, uint32_t type, uint32_t target, uint32_t w, uint32_t h)
+{
+    struct v4l2_selection sel = { .type = type, .target = target };
+
+    sel.r.width = w;
+    sel.r.height = h;
+    if (ioctl(fd, VIDIOC_S_SELECTION, &sel) < 0) {
+        return -errno;
+    }
+    return sel.r.width == w && sel.r.height == h ? 0 : -EINVAL;
+}
+
+static int isp_reqbufs(int fd, uint32_t type, uint32_t memory, uint32_t count)
+{
+    struct v4l2_requestbuffers rb = { .count = count, .type = type, .memory = memory };
+
+    if (ioctl(fd, VIDIOC_REQBUFS, &rb) < 0) {
+        return -errno;
+    }
+    return rb.count >= count || count == 0 ? 0 : -ENOBUFS;
+}
+
+VirtIOMediaIsp *virtio_media_isp_open(uint32_t src_fourcc, uint32_t src_w, uint32_t src_h,
+                                      uint32_t src_bpl,
+                                      uint32_t src_len, uint32_t dst_w, uint32_t dst_h,
+                                      uint32_t dst_bpl, uint32_t crop_w, uint32_t crop_h,
+                                      uint32_t comp_w, uint32_t comp_h, int matrix,
+                                      uint32_t nsrc, uint32_t nring, int *err)
+{
+    VirtIOMediaIsp *isp;
+    uint32_t bpl = 0, size = 0, type, k;
+    int fd, r;
+
+    if (nring == 0 || nring > VIRTIO_MEDIA_ISP_MAX_RING) {
+        *err = -EINVAL;
+        return NULL;
+    }
+    fd = open(ISP_DEV, O_RDWR | O_NONBLOCK | O_CLOEXEC);
+    if (fd < 0) {
+        *err = -errno;
+        return NULL;
+    }
+    isp = g_new0(VirtIOMediaIsp, 1);
+    isp->fd = fd;
+    isp->nsrc = nsrc;
+    isp->nring = nring;
+    for (k = 0; k < VIRTIO_MEDIA_ISP_MAX_RING; k++) {
+        isp->dst_fd[k] = -1;
+    }
+    /*
+     * NV12, or NV12_COL128 (SAND, the codec's native output: 11.2 ms per 1080p frame on the
+     * VPU instead of 15 ms with the firmware's NV12 conversion). For SAND, bytesperline is
+     * the column height in lines and must be at least height * 3 / 2, so the caller passes
+     * the visible luma rows (1080 for a 1620-line column), not the padded 1088.
+     */
+    r = isp_set_fmt(fd, V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE, src_fourcc, src_w,
+                    src_h, src_bpl, src_len, matrix, false, &bpl, &size);
+    if (!r && bpl != src_bpl) {
+        r = -EINVAL;
+    }
+    if (!r) {
+        r = isp_set_fmt(fd, V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE, V4L2_PIX_FMT_RGBA32,
+                        dst_w, dst_h, dst_bpl, dst_bpl * dst_h, matrix, true, &bpl, &size);
+        if (!r && bpl != dst_bpl) {
+            /* the GL copy into the guest resource is same-pitch: insist on it */
+            r = -EINVAL;
+        }
+        isp->dst_len = size;
+    }
+    /*
+     * Only the visible part of the frame: the codec pads 1080p to 1088 lines, and those 8
+     * lines (uninitialised in SAND) were scaled into the bottom of the picture as block
+     * noise (2026-10-07). Crop the input to the visible rectangle and compose the output
+     * into the guest's visible rectangle, which makes 1080 -> 720 an exact 1.5; the rows
+     * below it stay as allocated (zero, black). Both are set before REQBUFS, when the
+     * driver applies them to the component.
+     */
+    if (!r && crop_w && crop_h && (crop_w != src_w || crop_h != src_h)) {
+        r = isp_set_sel(fd, V4L2_BUF_TYPE_VIDEO_OUTPUT, V4L2_SEL_TGT_CROP, crop_w, crop_h);
+    }
+    if (!r && comp_w && comp_h && (comp_w != dst_w || comp_h != dst_h)) {
+        r = isp_set_sel(fd, V4L2_BUF_TYPE_VIDEO_CAPTURE, V4L2_SEL_TGT_COMPOSE, comp_w, comp_h);
+    }
+    if (!r) {
+        r = isp_reqbufs(fd, V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE, V4L2_MEMORY_DMABUF, nsrc);
+    }
+    if (!r) {
+        r = isp_reqbufs(fd, V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE, V4L2_MEMORY_MMAP, nring);
+    }
+    for (k = 0; !r && k < nring; k++) {
+        struct v4l2_exportbuffer eb = {
+            .type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE, .index = k, .plane = 0,
+            .flags = O_RDONLY | O_CLOEXEC,
+        };
+
+        if (ioctl(fd, VIDIOC_EXPBUF, &eb) < 0) {
+            r = -errno;
+        } else {
+            isp->dst_fd[k] = eb.fd;
+        }
+    }
+    if (!r) {
+        type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+        if (ioctl(fd, VIDIOC_STREAMON, &type) < 0) {
+            r = -errno;
+        }
+    }
+    if (!r) {
+        type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+        if (ioctl(fd, VIDIOC_STREAMON, &type) < 0) {
+            r = -errno;
+        }
+    }
+    if (r) {
+        qemu_log("virtio-media-diag: host_isp: open %ux%u %s bpl %u -> %ux%u bpl %u "
+                 "failed (%d, ISP bpl %u, CmaFree %ld kB)\n", src_w, src_h,
+                 src_fourcc == V4L2_PIX_FMT_NV12_COL128 ? "NC12" : "NV12", src_bpl,
+                 dst_w, dst_h, dst_bpl, r, bpl, isp_cma_free_kb());
+        virtio_media_isp_close(isp);
+        *err = r;
+        return NULL;
+    }
+    qemu_log("virtio-media-diag: host_isp: %ux%u %s (bpl %u, crop %ux%u) -> %ux%u RGBA "
+             "(bpl %u, %u bytes, compose %ux%u), %u codec buffers, ring of %u, matrix %d, "
+             "CmaFree %ld kB\n",
+             src_w, src_h, src_fourcc == V4L2_PIX_FMT_NV12_COL128 ? "NC12" : "NV12",
+             src_bpl, crop_w, crop_h, dst_w, dst_h, dst_bpl, isp->dst_len, comp_w, comp_h,
+             nsrc, nring, matrix, isp_cma_free_kb());
+    return isp;
+}
+
+int virtio_media_isp_fd(VirtIOMediaIsp *isp)
+{
+    return isp->fd;
+}
+
+uint32_t virtio_media_isp_in_flight(VirtIOMediaIsp *isp)
+{
+    return isp->cap_in_flight + isp->src_in_flight;
+}
+
+uint32_t virtio_media_isp_ring_size(VirtIOMediaIsp *isp)
+{
+    return isp->nring;
+}
+
+int virtio_media_isp_ring_fd(VirtIOMediaIsp *isp, uint32_t k, uint32_t *len)
+{
+    if (k >= isp->nring || isp->dst_fd[k] < 0) {
+        return -EINVAL;
+    }
+    *len = isp->dst_len;
+    return isp->dst_fd[k];
+}
+
+int virtio_media_isp_submit(VirtIOMediaIsp *isp, uint32_t src_index, int src_fd,
+                            uint32_t src_len, uint32_t src_used, uint32_t ring_index)
+{
+    struct v4l2_plane dpl = { .length = isp->dst_len };
+    struct v4l2_buffer db = {
+        .type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE, .memory = V4L2_MEMORY_MMAP,
+        .index = ring_index, .length = 1, .m.planes = &dpl,
+    };
+    struct v4l2_plane spl = { .length = src_len, .bytesused = src_used, .m.fd = src_fd };
+    struct v4l2_buffer sb = {
+        .type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE, .memory = V4L2_MEMORY_DMABUF,
+        .index = src_index, .length = 1, .m.planes = &spl,
+    };
+
+    if (src_index >= isp->nsrc || ring_index >= isp->nring) {
+        return -EINVAL;
+    }
+    if (ioctl(isp->fd, VIDIOC_QBUF, &db) < 0) {
+        return -errno;
+    }
+    if (ioctl(isp->fd, VIDIOC_QBUF, &sb) < 0) {
+        /*
+         * The ring buffer stays queued with no input to pair with. It is not counted, so
+         * the caller can close the ISP (which takes it back) without waiting for it.
+         */
+        return -errno;
+    }
+    isp->cap_in_flight++;
+    isp->src_in_flight++;
+    return 0;
+}
+
+int virtio_media_isp_reap(VirtIOMediaIsp *isp, uint32_t *ring_index)
+{
+    struct v4l2_plane pl = { 0 };
+    struct v4l2_buffer b = {
+        .type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE, .memory = V4L2_MEMORY_MMAP,
+        .length = 1, .m.planes = &pl,
+    };
+
+    if (ioctl(isp->fd, VIDIOC_DQBUF, &b) < 0) {
+        return -errno;
+    }
+    *ring_index = b.index;
+    if (isp->cap_in_flight) {
+        isp->cap_in_flight--;
+    }
+    return (b.flags & V4L2_BUF_FLAG_ERROR) ? -EIO : 0;
+}
+
+int virtio_media_isp_reap_src(VirtIOMediaIsp *isp, uint32_t *src_index)
+{
+    struct v4l2_plane pl = { 0 };
+    struct v4l2_buffer b = {
+        .type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE, .memory = V4L2_MEMORY_DMABUF,
+        .length = 1, .m.planes = &pl,
+    };
+
+    if (ioctl(isp->fd, VIDIOC_DQBUF, &b) < 0) {
+        return -errno;
+    }
+    *src_index = b.index;
+    if (isp->src_in_flight) {
+        isp->src_in_flight--;
+    }
+    return 0;
+}
+
+void virtio_media_isp_close(VirtIOMediaIsp *isp)
+{
+    uint32_t type, k;
+
+    if (!isp) {
+        return;
+    }
+    type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+    ioctl(isp->fd, VIDIOC_STREAMOFF, &type);
+    type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+    ioctl(isp->fd, VIDIOC_STREAMOFF, &type);
+    for (k = 0; k < VIRTIO_MEDIA_ISP_MAX_RING; k++) {
+        if (isp->dst_fd[k] >= 0) {
+            close(isp->dst_fd[k]);
+        }
+    }
+    isp_reqbufs(isp->fd, V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE, V4L2_MEMORY_MMAP, 0);
+    isp_reqbufs(isp->fd, V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE, V4L2_MEMORY_DMABUF, 0);
+    close(isp->fd);
+    g_free(isp);
+}
