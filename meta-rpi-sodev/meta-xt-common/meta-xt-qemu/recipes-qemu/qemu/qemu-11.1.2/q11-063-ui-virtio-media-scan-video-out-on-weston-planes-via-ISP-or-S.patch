diff --git a/include/ui/direct-scanout.h b/include/ui/direct-scanout.h
new file mode 100644
index 000000000..577835ffa
--- /dev/null
+++ b/include/ui/direct-scanout.h
@@ -0,0 +1,57 @@
+/*
+ * Direct scanout registry (q11-isp-scanout): a device that produced the content
+ * of a guest scanout texture in a dmabuf the display can scan out directly (host-isp's
+ * CMA ring) publishes it here; the display looks the texture up at flush time and, when
+ * the entry is still current, presents the dmabuf instead of blitting the texture.
+ * Main loop only.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef UI_DIRECT_SCANOUT_H
+#define UI_DIRECT_SCANOUT_H
+
+typedef struct DirectScanout {
+    void *owner;             /* the producer (forgotten with direct_scanout_forget) */
+    uint64_t epoch;          /* the producer's session: a reopened producer gets a new one */
+    int fd;                  /* dmabuf, owned by the producer */
+    uint32_t width, height;  /* of the buffer (>= the scanout rectangle) */
+    uint32_t stride;
+    /* q11-sand-scanout: 0 = one ABGR8888 LINEAR plane (the ISP ring); else a DRM fourcc with */
+    uint32_t fourcc;         /* modifier on every plane and a second plane at offset1/pitch1 */
+    uint64_t modifier;
+    uint32_t offset1, pitch1;
+    uint32_t slot;           /* the producer's buffer index */
+    uint64_t seq;            /* the producer's content generation for slot */
+    /* true while slot still holds content seq (not requeued, not rewritten) */
+    bool (*current)(void *owner, uint32_t slot, uint64_t seq);
+    /* the display started (true) / stopped (false) scanning slot out */
+    void (*hold)(void *owner, uint32_t slot, bool held);
+} DirectScanout;
+
+/* the content of texture tex_id is now that of d (replaces an older entry) */
+void direct_scanout_publish(uint32_t tex_id, const DirectScanout *d);
+/* the entry for tex_id if there is one and it is still current (copied to *d) */
+bool direct_scanout_lookup(uint32_t tex_id, DirectScanout *d);
+/* is there an entry for tex_id at all (current or not): miss statistics */
+bool direct_scanout_has(uint32_t tex_id);
+/* the texture got content from elsewhere (another path wrote it): forget its entry */
+void direct_scanout_forget_tex(uint32_t tex_id);
+/* drop every entry of owner; later hold() calls for it are not made */
+void direct_scanout_forget(void *owner);
+/* the owner's current epoch (0: forgotten); buffers of another epoch are stale */
+uint64_t direct_scanout_owner_epoch(void *owner);
+/* q11-sand-scanout: false once the compositor refused a multi-plane (fourcc) buffer */
+bool direct_scanout_sand_usable(void);
+void direct_scanout_sand_set_failed(void);
+
+/*
+ * q11-isp-skip-copy: the display reports each flush (hit = presented a dmabuf
+ * directly). A miss first runs the producer's catch-up, which must leave every guest
+ * texture it skipped filling complete before the display samples one.
+ */
+void direct_scanout_note_flush(bool hit);
+/* /run/qemu-isp-skip-copy is present and the recent flushes all hit */
+bool direct_scanout_skip_copy(void);
+void direct_scanout_set_catch_up(void *owner, void (*fn)(void *owner));
+
+#endif
