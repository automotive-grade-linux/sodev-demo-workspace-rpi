diff --git a/ui/direct-scanout.c b/ui/direct-scanout.c
new file mode 100644
index 000000000..188141c79
--- /dev/null
+++ b/ui/direct-scanout.c
@@ -0,0 +1,125 @@
+/*
+ * Direct scanout registry, see include/ui/direct-scanout.h.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "qemu/timer.h"
+#include "ui/direct-scanout.h"
+
+static GHashTable *entries;  /* tex_id -> DirectScanout* */
+static GHashTable *owners;   /* owner -> its current epoch (alive set) */
+
+void direct_scanout_publish(uint32_t tex_id, const DirectScanout *d)
+{
+    if (!entries) {
+        entries = g_hash_table_new_full(g_direct_hash, g_direct_equal, NULL, g_free);
+        owners = g_hash_table_new_full(g_direct_hash, g_direct_equal, NULL, g_free);
+    }
+    g_hash_table_replace(entries, GUINT_TO_POINTER(tex_id), g_memdup2(d, sizeof(*d)));
+    g_hash_table_insert(owners, d->owner, g_memdup2(&d->epoch, sizeof(d->epoch)));
+}
+
+bool direct_scanout_lookup(uint32_t tex_id, DirectScanout *d)
+{
+    DirectScanout *e = entries ? g_hash_table_lookup(entries, GUINT_TO_POINTER(tex_id))
+                               : NULL;
+
+    if (!e || !e->current || !e->current(e->owner, e->slot, e->seq)) {
+        return false;
+    }
+    *d = *e;
+    return true;
+}
+
+bool direct_scanout_has(uint32_t tex_id)
+{
+    return entries && g_hash_table_contains(entries, GUINT_TO_POINTER(tex_id));
+}
+
+void direct_scanout_forget_tex(uint32_t tex_id)
+{
+    if (entries && tex_id) {
+        g_hash_table_remove(entries, GUINT_TO_POINTER(tex_id));
+    }
+}
+
+static gboolean of_owner(gpointer key, gpointer value, gpointer owner)
+{
+    return ((DirectScanout *)value)->owner == owner;
+}
+
+/* q11-isp-skip-copy */
+#define DIRECT_SCANOUT_STREAK 30
+#define DIRECT_SCANOUT_FRESH_MS 100
+static uint32_t streak;
+static int64_t last_hit_ms;
+static void *catch_up_owner;
+static void (*catch_up_fn)(void *owner);
+
+void direct_scanout_set_catch_up(void *owner, void (*fn)(void *owner))
+{
+    catch_up_owner = owner;
+    catch_up_fn = fn;
+}
+
+void direct_scanout_note_flush(bool hit)
+{
+    if (hit) {
+        if (streak < UINT32_MAX) {
+            streak++;
+        }
+        last_hit_ms = qemu_clock_get_ms(QEMU_CLOCK_REALTIME);
+        return;
+    }
+    streak = 0;
+    if (catch_up_fn) {
+        catch_up_fn(catch_up_owner);
+    }
+}
+
+bool direct_scanout_skip_copy(void)
+{
+    static int64_t checked = -1000000;
+    static bool on;
+    int64_t now = qemu_clock_get_ms(QEMU_CLOCK_REALTIME);
+
+    if (now - checked >= 1000) {
+        checked = now;
+        on = access("/run/qemu-isp-skip-copy", F_OK) == 0;
+    }
+    return on && streak >= DIRECT_SCANOUT_STREAK &&
+           now - last_hit_ms < DIRECT_SCANOUT_FRESH_MS;
+}
+
+void direct_scanout_forget(void *owner)
+{
+    if (catch_up_owner == owner) {
+        catch_up_owner = NULL;
+        catch_up_fn = NULL;
+    }
+    if (entries) {
+        g_hash_table_foreach_remove(entries, of_owner, owner);
+        g_hash_table_remove(owners, owner);
+    }
+}
+
+uint64_t direct_scanout_owner_epoch(void *owner)
+{
+    uint64_t *e = owners ? g_hash_table_lookup(owners, owner) : NULL;
+
+    return e ? *e : 0;
+}
+
+/* q11-sand-scanout: the compositor refused a fourcc buffer once: stop offering them */
+static bool sand_failed;
+
+bool direct_scanout_sand_usable(void)
+{
+    return !sand_failed;
+}
+
+void direct_scanout_sand_set_failed(void)
+{
+    sand_failed = true;
+}
