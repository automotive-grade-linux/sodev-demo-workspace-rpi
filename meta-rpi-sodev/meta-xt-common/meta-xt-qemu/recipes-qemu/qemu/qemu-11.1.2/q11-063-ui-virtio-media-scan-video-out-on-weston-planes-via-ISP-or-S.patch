+/*
+ * virtio-media: host-isp, see hw/virtio/virtio-media-isp.c.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef HW_VIRTIO_MEDIA_ISP_H
+#define HW_VIRTIO_MEDIA_ISP_H
+
+/* Raspberry Pi SAND (YUVUV128); not in the generic kernel headers (same as virtio-media.c) */
+#ifndef V4L2_PIX_FMT_NV12_COL128
+#define V4L2_PIX_FMT_NV12_COL128 v4l2_fourcc('N', 'C', '1', '2')
+#endif
+
+/* ISP CAPTURE ring size limit: 6 x 3.7 MB of CMA at 1280x726 RGBA */
+#define VIRTIO_MEDIA_ISP_MAX_RING 24
+
+typedef struct VirtIOMediaIsp VirtIOMediaIsp;
+
+/*
+ * NV12 or NV12_COL128 (src_fourcc; nsrc DMABUF indices = the codec's CAPTURE buffers) ->
+ * RGBA32 'AB24' (dst, a ring of nring MMAP buffers owned by the ISP). For NV12_COL128,
+ * src_bpl is the column height in lines and src_h the luma rows of a column.
+ * crop_* (input: the codec's visible rectangle) and comp_* (output: the guest's visible
+ * rectangle) are applied when non-zero and different from the full frame.
+ */
+VirtIOMediaIsp *virtio_media_isp_open(uint32_t src_fourcc, uint32_t src_w, uint32_t src_h,
+                                      uint32_t src_bpl,
+                                      uint32_t src_len, uint32_t dst_w, uint32_t dst_h,
+                                      uint32_t dst_bpl, uint32_t crop_w, uint32_t crop_h,
+                                      uint32_t comp_w, uint32_t comp_h, int matrix,
+                                      uint32_t nsrc, uint32_t nring, int *err);
+int virtio_media_isp_fd(VirtIOMediaIsp *isp);
+uint32_t virtio_media_isp_in_flight(VirtIOMediaIsp *isp);
+uint32_t virtio_media_isp_ring_size(VirtIOMediaIsp *isp);
+/* the dmabuf of ring buffer k (owned by the ISP: dup() it to keep it) and its length */
+int virtio_media_isp_ring_fd(VirtIOMediaIsp *isp, uint32_t k, uint32_t *len);
+/* convert codec buffer src_index (dmabuf src_fd) into ring buffer ring_index */
+int virtio_media_isp_submit(VirtIOMediaIsp *isp, uint32_t src_index, int src_fd,
+                            uint32_t src_len, uint32_t src_used, uint32_t ring_index);
+/*
+ * The two sides complete independently (no pairing in bcm2835-codec):
+ * reap: one converted frame (CAPTURE): 0 (ring_index set), -EIO (set, frame flagged),
+ *   -EAGAIN, -errno.
+ * reap_src: one codec buffer the ISP has finished reading (OUTPUT): 0, -EAGAIN, -errno.
+ * in_flight counts both, so 0 means the ISP holds no buffer of either kind.
+ */
+int virtio_media_isp_reap(VirtIOMediaIsp *isp, uint32_t *ring_index);
+int virtio_media_isp_reap_src(VirtIOMediaIsp *isp, uint32_t *src_index);
+void virtio_media_isp_close(VirtIOMediaIsp *isp);
+
+#endif
