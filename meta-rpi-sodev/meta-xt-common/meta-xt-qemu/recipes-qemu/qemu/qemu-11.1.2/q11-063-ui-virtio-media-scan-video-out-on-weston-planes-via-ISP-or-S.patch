--- /dev/null
+++ b/ui/sdl2-wl-scanout.c
@@ -0,0 +1,558 @@
+/*
+ * q11-isp-scanout: present a published dmabuf (host-isp's CMA ring)
+ * straight on the SDL window's wl_surface, so weston can put it on a vc4 plane instead of
+ * qemu blitting the guest texture with V3D and weston compositing qemu's window with V3D
+ * again (measured 2026-10-07: the CMA buffer went to an overlay plane, V3D 0, 60 fps).
+ *
+ * While in direct mode qemu does not call SDL_GL_SwapWindow; Mesa's wayland EGL only
+ * attaches its own buffer in eglSwapBuffers, so leaving the mode is just the next swap.
+ * Everything here runs on the main loop, with our own wl_event_queue on SDL's display.
+ *
+ * Pacing: the guest's flushes come in bunches (2 in one vblank, none in the next); weston
+ * shows only the last buffer committed before its repaint, so with a commit per flush the
+ * HDMI got 45 flips/s of ~57 guest frames (2026-10-07). A commit therefore waits for the
+ * previous one's wl_surface.frame done; up to 2 frames wait, the oldest is dropped.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "qemu/main-loop.h"
+#include "qemu/error-report.h"
+#include "qemu/timer.h"
+#include "ui/console.h"
+#include "ui/sdl2.h"
+#include "ui/direct-scanout.h"
+
+#if __has_include(<wayland-client.h>) && __has_include(<SDL_syswm.h>)
+#include <SDL_syswm.h>
+#include <wayland-client.h>
+#include "linux-dmabuf-unstable-v1-client-protocol.h"
+
+#define WL_DRM_FORMAT_ABGR8888 0x34324241 /* 'AB24' = V4L2 RGBA32 byte order */
+/*
+ * Frames that may wait for the frame callback: /run/qemu-isp-scanout-depth (1..6, read
+ * at most once a second), default 4 (bunches of 4 seen: 17% dropped at 2, best flips at
+ * 4). Each waiting frame holds a ring slot (24); the guest's own backlog needs ~11.
+ */
+#define WL_SCAN_QUEUE 6
+#ifndef WL_SCAN_QUEUE_DEFAULT /* the host test builds with others */
+#define WL_SCAN_QUEUE_DEFAULT 4
+#endif
+/* a frame callback weston never answers (window hidden): give up on it after this */
+#define WL_SCAN_FRAME_TIMEOUT_NS (50 * SCALE_MS)
+
+typedef struct WlScanBuf {
+    void *owner;
+    uint64_t epoch;
+    uint32_t slot;
+    int fd;
+    uint32_t w, h;
+    void (*hold)(void *owner, uint32_t slot, bool held);
+    struct wl_buffer *wb;
+    bool attached; /* committed, compositor has not released it yet */
+    bool queued;   /* waiting in wl.pending for the frame callback */
+    bool held;     /* the owner was told hold(true): attached || queued */
+    bool dead;     /* owner forgotten: destroy once released */
+    /* q11-sand-scanout: fourcc buffers are created asynchronously */
+    uint32_t fourcc;
+    bool ready;    /* wb exists */
+    bool failed;   /* the compositor refused it */
+} WlScanBuf;
+
+static struct {
+    bool tried, ok;
+    struct wl_display *dpy;
+    struct wl_surface *surf;
+    struct wl_surface *surf_q; /* wrapper of surf on our queue (for frame callbacks) */
+    struct wl_event_queue *queue;
+    struct zwp_linux_dmabuf_v1 *dmabuf;
+    GPtrArray *bufs;
+    struct wl_callback *frame_cb;
+    int64_t frame_t;
+    WlScanBuf *pending[WL_SCAN_QUEUE];
+    int npending;
+    WlScanBuf *last; /* last committed */
+    uint64_t frames, commits, dropped, fallbacks, timeouts;
+    /* per stats line: frame callbacks answered, commit -> done (ns) */
+    uint64_t dones, done_sum, done_max, done_late;
+} wl;
+
+/* q11-sand-scanout: what the compositor takes for NV12 (logged once at init) */
+#define WL_DRM_FORMAT_NV12 0x3231564e
+static GString *wl_nv12_mods;
+
+static void dmabuf_format(void *data, struct zwp_linux_dmabuf_v1 *d, uint32_t format)
+{
+}
+
+static void dmabuf_modifier(void *data, struct zwp_linux_dmabuf_v1 *d, uint32_t format,
+                            uint32_t hi, uint32_t lo)
+{
+    if (format == WL_DRM_FORMAT_NV12) {
+        if (!wl_nv12_mods) {
+            wl_nv12_mods = g_string_new(NULL);
+        }
+        g_string_append_printf(wl_nv12_mods, " 0x%08x%08x", hi, lo);
+    }
+}
+
+static const struct zwp_linux_dmabuf_v1_listener dmabuf_listener = {
+    dmabuf_format, dmabuf_modifier,
+};
+
+static void reg_global(void *data, struct wl_registry *reg, uint32_t name,
+                       const char *iface, uint32_t ver)
+{
+    if (!strcmp(iface, zwp_linux_dmabuf_v1_interface.name) && ver >= 2) {
+        wl.dmabuf = wl_registry_bind(reg, name, &zwp_linux_dmabuf_v1_interface,
+                                     ver < 3 ? ver : 3);
+        zwp_linux_dmabuf_v1_add_listener(wl.dmabuf, &dmabuf_listener, NULL);
+    }
+}
+
+static void reg_remove(void *data, struct wl_registry *reg, uint32_t name)
+{
+}
+
+static const struct wl_registry_listener reg_listener = { reg_global, reg_remove };
+
+static void wl_fd_read(void *opaque)
+{
+    sdl2_wl_scanout_dispatch();
+}
+
+static bool wl_init(SDL_Window *win)
+{
+    SDL_SysWMinfo info;
+    struct wl_display *wrapped;
+    struct wl_registry *reg;
+
+    if (wl.tried) {
+        return wl.ok;
+    }
+    wl.tried = true;
+    SDL_VERSION(&info.version);
+    if (!SDL_GetWindowWMInfo(win, &info) || info.subsystem != SDL_SYSWM_WAYLAND) {
+        warn_report("sdl2: isp-scanout: the window is not a wayland surface");
+        return false;
+    }
+    wl.dpy = info.info.wl.display;
+    wl.surf = info.info.wl.surface;
+    wl.queue = wl_display_create_queue(wl.dpy);
+    wrapped = wl_proxy_create_wrapper(wl.dpy);
+    wl_proxy_set_queue((struct wl_proxy *)wrapped, wl.queue);
+    reg = wl_display_get_registry(wrapped);
+    wl_proxy_wrapper_destroy(wrapped);
+    wl_registry_add_listener(reg, &reg_listener, NULL);
+    wl_display_roundtrip_queue(wl.dpy, wl.queue);
+    wl_display_roundtrip_queue(wl.dpy, wl.queue); /* q11-sand-scanout: the format events */
+    wl_registry_destroy(reg);
+    info_report("sdl2: isp-scanout: compositor NV12 modifiers:%s",
+                wl_nv12_mods ? wl_nv12_mods->str : " (none)");
+    if (!wl.dmabuf) {
+        warn_report("sdl2: isp-scanout: compositor has no zwp_linux_dmabuf_v1");
+        return false;
+    }
+    wl.surf_q = wl_proxy_create_wrapper(wl.surf);
+    wl_proxy_set_queue((struct wl_proxy *)wl.surf_q, wl.queue);
+    wl.bufs = g_ptr_array_new();
+    /* frame-done and release events also when no guest frame comes (SDL reads too) */
+    qemu_set_fd_handler(wl_display_get_fd(wl.dpy), wl_fd_read, NULL, NULL);
+    wl.ok = true;
+    info_report("sdl2: isp-scanout: ready (linux-dmabuf on the window surface, "
+                "frame-callback paced, queue up to %d)", WL_SCAN_QUEUE);
+    return true;
+}
+
+static void buf_free(WlScanBuf *b)
+{
+    if (b->wb) {
+        wl_buffer_destroy(b->wb);
+    }
+    g_ptr_array_remove_fast(wl.bufs, b);
+    if (wl.last == b) {
+        wl.last = NULL;
+    }
+    g_free(b);
+}
+
+/* tell the owner when the buffer is neither on screen nor waiting any more */
+static void buf_unhold(WlScanBuf *b)
+{
+    if (b->held && !b->attached && !b->queued) {
+        b->held = false;
+        if (!b->dead && direct_scanout_owner_epoch(b->owner) == b->epoch) {
+            b->hold(b->owner, b->slot, false);
+        }
+    }
+}
+
+static void buf_release(void *data, struct wl_buffer *wb)
+{
+    WlScanBuf *b = data;
+
+    b->attached = false;
+    buf_unhold(b);
+    if (b->dead && !b->queued) {
+        buf_free(b);
+    }
+}
+
+static const struct wl_buffer_listener buf_listener = { buf_release };
+
+/*
+ * A fourcc buffer whose asynchronous create has not been answered yet: its params
+ * listener still points at it, so it may be marked dead but only freed by
+ * params_created()/params_failed().
+ */
+static bool buf_creating(const WlScanBuf *b)
+{
+    return b->fourcc && !b->ready && !b->failed;
+}
+
+/* forgotten owners: mark their buffers dead, free the ones the compositor gave back */
+static void wl_gc(void)
+{
+    for (guint i = wl.bufs->len; i-- > 0;) {
+        WlScanBuf *b = g_ptr_array_index(wl.bufs, i);
+
+        if (!b->dead && direct_scanout_owner_epoch(b->owner) != b->epoch) {
+            b->dead = true;
+            b->held = false; /* the owner is gone: no hold(false) to send */
+        }
+        if (b->dead && !b->attached && !b->queued && !buf_creating(b)) {
+            buf_free(b);
+        }
+    }
+}
+
+/* q11-sand-scanout: the async create of a fourcc buffer */
+static void params_created(void *data, struct zwp_linux_buffer_params_v1 *params,
+                           struct wl_buffer *wb)
+{
+    WlScanBuf *b = data;
+
+    b->wb = wb;
+    wl_buffer_add_listener(b->wb, &buf_listener, b);
+    b->ready = true;
+    zwp_linux_buffer_params_v1_destroy(params);
+    if (b->dead) {
+        buf_free(b); /* the owner went away while the create was in flight */
+    }
+}
+
+static void params_failed(void *data, struct zwp_linux_buffer_params_v1 *params)
+{
+    WlScanBuf *b = data;
+
+    b->failed = true;
+    zwp_linux_buffer_params_v1_destroy(params);
+    direct_scanout_sand_set_failed();
+    warn_report("sdl2: isp-scanout: the compositor refused a %.4s buffer %ux%u "
+                "(modifier 0x%016" PRIx64 "): direct SAND scanout off", (char *)&b->fourcc,
+                b->w, b->h, (uint64_t)0);
+    if (b->dead) {
+        buf_free(b);
+    }
+}
+
+static const struct zwp_linux_buffer_params_v1_listener params_listener = {
+    params_created, params_failed,
+};
+
+static WlScanBuf *wl_buf_for(const DirectScanout *d, uint32_t w, uint32_t h)
+{
+    struct zwp_linux_buffer_params_v1 *params;
+    WlScanBuf *b;
+
+    for (guint i = 0; i < wl.bufs->len; i++) {
+        b = g_ptr_array_index(wl.bufs, i);
+        if (!b->dead && b->owner == d->owner && b->epoch == d->epoch &&
+            b->slot == d->slot && b->fd == d->fd &&
+            b->w == (d->fourcc ? d->width : w) && b->h == (d->fourcc ? d->height : h)) {
+            return b;
+        }
+    }
+    b = g_new0(WlScanBuf, 1);
+    b->owner = d->owner;
+    b->epoch = d->epoch;
+    b->slot = d->slot;
+    b->fd = d->fd;
+    b->w = w;
+    b->h = h;
+    b->hold = d->hold;
+    b->fourcc = d->fourcc;
+    params = zwp_linux_dmabuf_v1_create_params(wl.dmabuf);
+    if (d->fourcc) {
+        /* q11-sand-scanout: two planes, the modifier on both, the whole visible picture */
+        uint32_t hi = d->modifier >> 32, lo = d->modifier & 0xffffffff;
+
+        b->w = d->width;
+        b->h = d->height;
+        zwp_linux_buffer_params_v1_add(params, d->fd, 0, 0, d->stride, hi, lo);
+        zwp_linux_buffer_params_v1_add(params, d->fd, 1, d->offset1, d->pitch1, hi, lo);
+        zwp_linux_buffer_params_v1_add_listener(params, &params_listener, b);
+        zwp_linux_buffer_params_v1_create(params, d->width, d->height, d->fourcc, 0);
+        wl_display_flush(wl.dpy);
+        g_ptr_array_add(wl.bufs, b);
+        return b;
+    }
+    b->ready = true;
+    /* the scanout rectangle only: rows below it (padding) are not part of the picture */
+    zwp_linux_buffer_params_v1_add(params, d->fd, 0, 0, d->stride, 0, 0); /* LINEAR */
+    b->wb = zwp_linux_buffer_params_v1_create_immed(params, w, h, WL_DRM_FORMAT_ABGR8888,
+                                                    0);
+    zwp_linux_buffer_params_v1_destroy(params);
+    wl_buffer_add_listener(b->wb, &buf_listener, b);
+    g_ptr_array_add(wl.bufs, b);
+    return b;
+}
+
+static int queue_depth(void)
+{
+    static int64_t last = INT64_MIN;
+    static int depth = WL_SCAN_QUEUE_DEFAULT;
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+    gchar *s = NULL;
+    int v;
+
+    if (last != INT64_MIN && now - last < NANOSECONDS_PER_SECOND) {
+        return depth;
+    }
+    last = now;
+    v = WL_SCAN_QUEUE_DEFAULT;
+    if (g_file_get_contents("/run/qemu-isp-scanout-depth", &s, NULL, NULL)) {
+        v = atoi(s);
+        g_free(s);
+    }
+    v = MAX(1, MIN(v, WL_SCAN_QUEUE));
+    if (v != depth) {
+        info_report("sdl2: isp-scanout: queue depth %d", v);
+        depth = v;
+    }
+    return depth;
+}
+
+static void frame_done(void *data, struct wl_callback *cb, uint32_t t);
+static const struct wl_callback_listener frame_listener = { frame_done };
+
+static void frame_cb_drop(void)
+{
+    if (wl.frame_cb) {
+        wl_callback_destroy(wl.frame_cb);
+        wl.frame_cb = NULL;
+    }
+}
+
+static void commit(WlScanBuf *b)
+{
+    frame_cb_drop();
+    wl.frame_cb = wl_surface_frame(wl.surf_q);
+    wl_callback_add_listener(wl.frame_cb, &frame_listener, NULL);
+    wl.frame_t = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+    wl_surface_attach(wl.surf, b->wb, 0, 0);
+    wl_surface_damage(wl.surf, 0, 0, b->w, b->h);
+    wl_surface_commit(wl.surf);
+    wl_display_flush(wl.dpy);
+    b->attached = true;
+    wl.last = b;
+    wl.commits++;
+}
+
+/* the next waiting frame, if any, goes to the compositor */
+static void commit_next(void)
+{
+    WlScanBuf *b;
+
+    if (!wl.npending) {
+        return;
+    }
+    b = wl.pending[0];
+    memmove(&wl.pending[0], &wl.pending[1], --wl.npending * sizeof(wl.pending[0]));
+    b->queued = false;
+    if (b->dead) {
+        if (!b->attached) {
+            buf_free(b);
+        }
+        commit_next();
+        return;
+    }
+    commit(b);
+}
+
+static void frame_done(void *data, struct wl_callback *cb, uint32_t t)
+{
+    if (cb == wl.frame_cb) {
+        uint64_t d = qemu_clock_get_ns(QEMU_CLOCK_REALTIME) - wl.frame_t;
+
+        wl.dones++;
+        wl.done_sum += d;
+        wl.done_max = MAX(wl.done_max, d);
+        wl.done_late += d > 20 * SCALE_MS; /* later than one vblank (+jitter) */
+        wl_callback_destroy(cb);
+        wl.frame_cb = NULL;
+        commit_next();
+    }
+}
+
+/* weston did not answer the frame callback in time (window hidden?): do not wait on it */
+static void frame_timeout_check(void)
+{
+    if (wl.frame_cb && wl.npending &&
+        qemu_clock_get_ns(QEMU_CLOCK_REALTIME) - wl.frame_t > WL_SCAN_FRAME_TIMEOUT_NS) {
+        wl.timeouts++;
+        frame_cb_drop();
+        commit_next();
+    }
+}
+
+/* leaving direct mode: nothing waiting may be committed over the GL path's frame */
+static void pending_drop(void)
+{
+    frame_cb_drop();
+    while (wl.npending) {
+        WlScanBuf *b = wl.pending[--wl.npending];
+
+        b->queued = false;
+        wl.dropped++;
+        buf_unhold(b);
+        if (b->dead && !b->attached) {
+            buf_free(b);
+        }
+    }
+}
+
+/*
+ * Read and dispatch our queue (buffer releases, frame callbacks). Nobody else reads the
+ * socket for us reliably: SDL pumps on its own timer and Mesa reads only in
+ * eglSwapBuffers, which direct mode skips. The documented multi-queue pattern, safe next
+ * to SDL's own reader; read_events does not block (the socket reads are MSG_DONTWAIT).
+ */
+void sdl2_wl_scanout_dispatch(void)
+{
+    if (!wl.ok) {
+        return;
+    }
+    while (wl_display_prepare_read_queue(wl.dpy, wl.queue) != 0) {
+        wl_display_dispatch_queue_pending(wl.dpy, wl.queue);
+    }
+    wl_display_flush(wl.dpy);
+    if (wl_display_read_events(wl.dpy) == 0) {
+        wl_display_dispatch_queue_pending(wl.dpy, wl.queue);
+    }
+    frame_timeout_check();
+    wl_gc();
+}
+
+void sdl2_wl_scanout_off(void)
+{
+    if (wl.ok) {
+        pending_drop();
+    }
+}
+
+/* why is a string literal of the caller: counted per pointer */
+void sdl2_wl_scanout_miss(const char *why)
+{
+    static struct { const char *why; uint64_t n; } m[8];
+    static uint64_t last_print;
+    GString *g;
+    int i;
+
+    if (wl.ok) {
+        pending_drop();
+    }
+    wl.fallbacks++;
+    for (i = 0; i < ARRAY_SIZE(m) && m[i].why && m[i].why != why; i++) {
+    }
+    if (i < ARRAY_SIZE(m)) {
+        m[i].why = why;
+        m[i].n++;
+    }
+    if (wl.fallbacks - last_print < 60 && last_print) {
+        return;
+    }
+    last_print = wl.fallbacks;
+    g = g_string_new(NULL);
+    for (i = 0; i < ARRAY_SIZE(m) && m[i].why; i++) {
+        g_string_append_printf(g, " %s %" PRIu64, m[i].why, m[i].n);
+    }
+    info_report("sdl2: isp-scanout: %" PRIu64 " direct, %" PRIu64 " not:%s", wl.frames,
+                wl.fallbacks, g->str);
+    g_string_free(g, true);
+}
+
+bool sdl2_wl_scanout(struct sdl2_console *scon, const DirectScanout *d, uint32_t w,
+                     uint32_t h)
+{
+    WlScanBuf *b;
+
+    if (!wl_init(scon->real_window) || d->width < w || d->height < h) {
+        return false; /* counted by the caller (sdl2_wl_scanout_miss) */
+    }
+    sdl2_wl_scanout_dispatch();
+    b = wl_buf_for(d, w, h);
+    if (!b->ready) {
+        return false; /* q11-sand-scanout: not created (yet) or refused: ring / GL this time */
+    }
+    wl.frames++;
+    if (b->queued || (b == wl.last && b->attached && !wl.npending)) {
+        return true; /* the same frame flushed again: already on its way */
+    }
+    if (!b->held) {
+        b->held = true;
+        b->hold(b->owner, b->slot, true);
+    }
+    if (!wl.frame_cb) {
+        commit(b);
+    } else {
+        int depth = queue_depth();
+
+        while (wl.npending >= depth) {
+            /* the oldest waiting frame is never shown */
+            WlScanBuf *o = wl.pending[0];
+
+            memmove(&wl.pending[0], &wl.pending[1],
+                    (wl.npending - 1) * sizeof(wl.pending[0]));
+            wl.npending--;
+            o->queued = false;
+            wl.dropped++;
+            buf_unhold(o);
+        }
+        b->queued = true;
+        wl.pending[wl.npending++] = b;
+    }
+    if ((wl.frames % 600) == 1) { /* ~10 s of 60 fps: one line per clip */
+        info_report("sdl2: isp-scanout: %" PRIu64 " frames direct, %" PRIu64 " commits, %"
+                    PRIu64 " dropped, %" PRIu64 " frame timeouts, %" PRIu64
+                    " fallbacks, %u wl_buffers; frame done %" PRIu64 " (commit->done "
+                    "mean %.1f max %.1f ms, >20ms %" PRIu64 ")", wl.frames, wl.commits,
+                    wl.dropped, wl.timeouts, wl.fallbacks, wl.bufs->len, wl.dones,
+                    wl.dones ? wl.done_sum / 1e6 / wl.dones : 0.0, wl.done_max / 1e6,
+                    wl.done_late);
+        wl.dones = wl.done_sum = wl.done_max = wl.done_late = 0;
+    }
+    return true;
+}
+
