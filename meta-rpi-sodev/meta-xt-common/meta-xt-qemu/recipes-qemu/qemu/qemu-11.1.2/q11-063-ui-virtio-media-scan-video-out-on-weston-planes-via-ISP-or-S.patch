+    int64_t now = g_get_monotonic_time();
+
+    if (!checked || now - last >= G_USEC_PER_SEC) {
+        bool was = on;
+
+        checked = true;
+        last = now;
+        on = access("/run/qemu-fb-invalidate", F_OK) == 0;
