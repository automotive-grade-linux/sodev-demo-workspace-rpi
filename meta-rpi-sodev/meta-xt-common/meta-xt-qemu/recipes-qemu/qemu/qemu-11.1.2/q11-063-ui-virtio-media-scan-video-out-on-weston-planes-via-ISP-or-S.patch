+#define VIRTIO_MEDIA_ISP_PENDING_MAX 12
+
+static void virtio_media_isp_drop_res(VirtIOMediaQueue *q, uint32_t res, uint32_t except)
+{
+    uint32_t j;
+
+    /* q11-sand-catchup: newer content reaches res, an older skipped frame for it is moot */
+    for (j = 0; res && j < VIRTIO_MEDIA_MAX_BUFFERS; j++) {
+        if (q->sand_cpend[j] && q->sand_cres[j] == res) {
+            q->sand_cpend[j] = false;
+        }
+    }
+    if (!q->isp_pending_n || !res) {
+        return;
+    }
+    for (j = 0; j < VIRTIO_MEDIA_ISP_RING; j++) {
+        if (j != except && q->isp_ring_pending[j] && q->isp_ring_res[j] == res) {
+            q->isp_ring_pending[j] = false;
+            q->isp_pending_n--;
+            q->isp_rel_n++;
+        }
+    }
+}
+
+static bool virtio_media_isp_skip(VirtIOMediaQueue *q)
+{
+    if (!direct_scanout_skip_copy()) {
+        return false;
+    }
+    if (q->isp_pending_n >= VIRTIO_MEDIA_ISP_PENDING_MAX) {
+        q->isp_skip_cap_n++;
+        return false;
+    }
+    return true;
+}
+
+/* the display missed: make every skipped copy, and wait for it, before it samples */
+static void virtio_media_isp_catch_up(void *owner)
+{
+    VirtIOMediaQueue *q = owner;
+    uint32_t j;
+    bool blitted[VIRTIO_MEDIA_MAX_BUFFERS] = { false };
+
+    /* q11-sand-catchup: frames shown without the ISP get their guest content now */
+    for (j = 0; j < VIRTIO_MEDIA_MAX_BUFFERS; j++) {
+        if (!q->sand_cpend[j]) {
+            continue;
+        }
+        q->sand_cpend[j] = false;
+        if (q->gpu_buf[j] && q->sand_seq[j] == q->sand_cseq[j] && !q->sand_hostq[j] &&
+            virtio_media_gpu_blit(q->gpu_buf[j], q->sand_cres[j]) == 0) {
+            blitted[j] = true;
+            q->sand_catch_n++;
+        } else {
+            q->sand_catch_lost++; /* the decoder has the buffer again: a stale frame */
+        }
+    }
+    for (j = 0; j < VIRTIO_MEDIA_MAX_BUFFERS; j++) {
+        if (blitted[j]) {
+            virtio_media_gpu_wait(q->gpu_buf[j]);
+        }
+    }
+    if (!q->isp_pending_n) {
+        return;
+    }
+    for (j = 0; j < VIRTIO_MEDIA_ISP_RING; j++) {
+        if (q->isp_ring_pending[j]) {
+            int br = virtio_media_gpu_blit(q->isp_gpu[j], q->isp_ring_res[j]);
+
+            if (br) {
+                warn_report_once("virtio-media: host_isp: late copy into res %u failed (%d)",
+                                 q->isp_ring_res[j], br);
+            }
+        }
+    }
+    for (j = 0; j < VIRTIO_MEDIA_ISP_RING; j++) {
+        if (q->isp_ring_pending[j]) {
+            virtio_media_gpu_wait(q->isp_gpu[j]);
+            q->isp_ring_pending[j] = false;
+            q->isp_lazy_n++;
+        }
+    }
+    q->isp_pending_n = 0;
+}
+
+static void virtio_media_isp_mark_ready(VirtIOMediaQueue *q)
+{
+    GList *l;
+
+    for (l = q->isp_fifo.head; l; l = l->next) {
+        VirtIOMediaIspEvt *e = l->data;
+
+        if (!e->ready && e->cap_done && !q->isp_src_busy[e->src]) {
+            e->ready = true;
+        }
+    }
+}
+
+/* decided once per CAPTURE queue (i.e. per decode session), at its first frame */
+static bool virtio_media_isp_wanted(VirtIOMediaQueue *q)
+{
+    if (!q->isp_checked) {
+        q->isp_checked = true;
+        q->isp_on = access("/run/qemu-media-isp", F_OK) == 0;
+        if (q->isp_on) {
+            qemu_log("virtio-media-diag: host_isp: requested for this session\n");
+        }
+    }
+    return q->isp_on && !q->isp_failed;
+}
+
+/* Drop the ISP, its fds and any held events (STREAMOFF / buffer release / failure). */
+static void virtio_media_isp_teardown(VirtIOMediaQueue *q)
+{
+    VirtIOMediaIspEvt *e;
+    int i;
+
+    /* the display stops using our ring before it goes (it keeps what it still holds) */
+    direct_scanout_forget(q);
+    virtio_media_sand_drop(q, true); /* q11-sand-scanout: no release will come any more */
+    if (q->isp) {
+        qemu_log("virtio-media-diag: host_isp: closing after %" PRIu64 " frames "
+                 "(%" PRIu64 " sent to GL with the ring full; scanout misses: %" PRIu64
+                 " stale, %" PRIu64 " off)\n", q->isp_frames, q->isp_ring_full,
+                 q->isp_scan_stale, q->isp_scan_off);
+        qemu_log("virtio-media-diag: host_isp: skip-copy: %" PRIu64 " skipped, %" PRIu64
+                 " copied late, %" PRIu64 " released, %" PRIu64 " over the cap\n",
+                 q->isp_skip_n, q->isp_lazy_n, q->isp_rel_n, q->isp_skip_cap_n);
+        qemu_set_fd_handler(virtio_media_isp_fd(q->isp), NULL, NULL, NULL);
+    }
+    for (i = 0; i < VIRTIO_MEDIA_ISP_MAX_RING; i++) {
+        if (q->isp_gpu[i]) {
+            /* waits for a copy still reading the ring buffer, closes our dup */
+            virtio_media_gpu_release(q->isp_gpu[i]);
+            q->isp_gpu[i] = NULL;
+        }
+        q->isp_ring_busy[i] = false;
+        q->isp_ring_held[i] = false;
+        q->isp_ring_pending[i] = false;
+        q->isp_ring_seq[i] = 0;
+        q->isp_ring_res[i] = 0;
+    }
+    if (q->isp) {
+        virtio_media_isp_close(q->isp);
+        q->isp = NULL;
+    }
+    for (i = 0; i < VIRTIO_MEDIA_MAX_BUFFERS; i++) {
+        if (q->isp_src_fd[i]) {
+            close(q->isp_src_fd[i] - 1);
+            q->isp_src_fd[i] = 0;
+        }
+        q->isp_src_busy[i] = false;
+    }
+    if (q->isp_timer) {
+        timer_free(q->isp_timer);
+        q->isp_timer = NULL;
+    }
+    while ((e = g_queue_pop_head(&q->isp_fifo))) {
+        g_free(e);
+    }
+    q->isp_ring_next = 0;
+    q->isp_frames = q->isp_ring_full = 0;
+    q->isp_pending_n = 0;
+    q->isp_skip_n = q->isp_lazy_n = q->isp_rel_n = q->isp_skip_cap_n = 0;
+}
+
+/* Send the held events whose frames are done, oldest first, stopping at the first not done. */
+static void virtio_media_isp_flush(VirtIOMediaSession *s, VirtIOMediaQueue *q)
+{
+    VirtIOMediaIspEvt *e;
+
+    while ((e = g_queue_peek_head(&q->isp_fifo)) && e->ready) {
+        g_queue_pop_head(&q->isp_fifo);
+        virtio_media_send_event(s->vm, &e->evt, sizeof(e->evt));
+        g_free(e);
+    }
+}
+
+static void virtio_media_isp_readable(void *opaque)
+{
+    VirtIOMediaSession *s = opaque;
+    VirtIOMediaQueue *q = &s->queues[1];
+    uint32_t k;
+    int r;
+
+    if (!q->isp) {
+        return;
+    }
+    /* codec buffers the ISP has finished reading (they complete apart from the frames) */
+    while (virtio_media_isp_reap_src(q->isp, &k) == 0) {
+        if (k < VIRTIO_MEDIA_MAX_BUFFERS) {
+            q->isp_src_busy[k] = false;
+        }
+    }
+    while ((r = virtio_media_isp_reap(q->isp, &k)) != -EAGAIN) {
+        GList *l;
+
+        if (r && r != -EIO) {
+            /* not a completed frame (e.g. the queue is going away): stop here */
+            warn_report_once("virtio-media: host_isp: DQBUF failed (%d)", r);
+            break;
+        }
+        if (k >= VIRTIO_MEDIA_ISP_RING) {
+            warn_report_once("virtio-media: host_isp: ring index %u out of range", k);
+            continue;
+        }
+        if (r) {
+            warn_report_once("virtio-media: host_isp: the ISP reported a frame error (%d)", r);
+        } else {
+            /*
+             * The same-format copy into the guest resource. Its fence is armed and
+             * flushed, so virgl's later draws from the resource order behind it; the
+             * ring buffer is not handed to the ISP again before the copy is done.
+             */
+            int br;
+
+            /* q11-isp-skip-copy: an older pending copy into this resource is moot */
+            virtio_media_isp_drop_res(q, q->isp_ring_res[k], k);
+            if (virtio_media_isp_skip(q)) {
+                q->isp_ring_pending[k] = true;
+                q->isp_pending_n++;
+                q->isp_skip_n++;
+                br = 0;
+            } else {
+                br = virtio_media_gpu_blit(q->isp_gpu[k], q->isp_ring_res[k]);
+            }
+
+            if (br) {
+                warn_report_once("virtio-media: host_isp: copy into res %u failed (%d)",
+                                 q->isp_ring_res[k], br);
+            } else {
+                /* isp-scanout: the guest resource now shows ring buffer k */
+                uint32_t tex = virtio_media_gpu_res_tex(q->isp_ring_res[k]);
+                uint32_t len = 0;
+                int fd = virtio_media_isp_ring_fd(q->isp, k, &len);
+
+                if (tex && fd >= 0) {
+                    DirectScanout d = {
+                        .owner = q, .epoch = q->isp_epoch, .fd = fd,
+                        .width = q->isp_dst_bpl / 4, .height = q->isp_dst_h,
+                        .stride = q->isp_dst_bpl, .slot = k, .seq = q->isp_ring_seq[k],
+                        .current = virtio_media_isp_scan_current,
+                        .hold = virtio_media_isp_scan_hold,
+                    };
+
+                    direct_scanout_set_catch_up(q, virtio_media_isp_catch_up);
+                    if (!virtio_media_sand_publish(q, tex, k)) { /* q11-sand-scanout */
+                        direct_scanout_publish(tex, &d);
+                    }
+                }
+            }
+        }
+        if (q->isp_t[k] && qemu_lat_diag()) {
+            qemu_lat_diag_add(LAT_MEDIA_ISP,
+                              qemu_clock_get_ns(QEMU_CLOCK_REALTIME) - q->isp_t[k]);
+        }
+        q->isp_ring_busy[k] = false;
+        for (l = q->isp_fifo.head; l; l = l->next) {
+            VirtIOMediaIspEvt *e = l->data;
+
+            if (!e->cap_done && !e->ready && e->ring == k) {
+                e->cap_done = true;
+                break;
+            }
+        }
+        q->isp_frames++;
+        if (q->isp_frames % 1800 == 0 && (q->isp_skip_n || q->isp_skip_cap_n)) {
+            qemu_log("virtio-media-diag: host_isp: skip-copy: %" PRIu64 " of %" PRIu64
+                     " frames skipped, %" PRIu64 " copied late, %" PRIu64 " released, %"
+                     PRIu64 " over the cap, %u pending\n", q->isp_skip_n, q->isp_frames,
+                     q->isp_lazy_n, q->isp_rel_n, q->isp_skip_cap_n, q->isp_pending_n);
+        }
+    }
+    virtio_media_isp_mark_ready(q);
+    if (!virtio_media_isp_in_flight(q->isp)) {
+        /*
+         * An M2M fd with nothing queued on either side polls EPOLLERR (v4l2_m2m_poll_for_data):
+         * only watch it while the ISP holds a buffer.
+         */
+        qemu_set_fd_handler(virtio_media_isp_fd(q->isp), NULL, NULL, NULL);
+    }
+    virtio_media_isp_flush(s, q);
+    if (q->isp_failed && !virtio_media_isp_in_flight(q->isp)) {
+        /* turned off with frames in flight (virtio_media_isp_frame): now all are back */
+        virtio_media_isp_teardown(q);
+        return;
+    }
+    if (g_queue_is_empty(&q->isp_fifo)) {
+        timer_del(q->isp_timer);
+    } else {
+        /* the stall check re-arms itself for the oldest frame still held */
+        virtio_media_isp_stalled(s);
+    }
+}
+
+/*
+ * A held frame has waited VIRTIO_MEDIA_ISP_STALL_NS. bcm2835-codec only logs a failed
+ * submit (device_run) and keeps the buffer until STREAMOFF, so without this the guest
+ * would wait for that codec buffer forever -- and with all of them held, no new frame
+ * would come to notice. Close the ISP (STREAMOFF: it lets go of every buffer), release
+ * the held events as they are (stale frames) and use GL from now on.
+ */
+static void virtio_media_isp_stalled(void *opaque)
+{
+    VirtIOMediaSession *s = opaque;
+    VirtIOMediaQueue *q = &s->queues[1];
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+    VirtIOMediaIspEvt *old = NULL;
+    GList *l;
+
+    if (!q->isp) {
+        return;
+    }
+    for (l = q->isp_fifo.head; l && !old; l = l->next) {
+        VirtIOMediaIspEvt *e = l->data;
+
+        if (!e->ready) {
+            old = e;
+        }
+    }
+    if (!old) {
+        return;
+    }
+    if (now - old->t < VIRTIO_MEDIA_ISP_STALL_NS) {
+        timer_mod(q->isp_timer, old->t + VIRTIO_MEDIA_ISP_STALL_NS);
+        return;
+    }
+    qemu_log("virtio-media-diag: host_isp: frame (ring %u, codec buffer %u) not back after "
+             "%" PRId64 " ms (cap_done %d, src_busy %d): ISP off, GL path instead\n",
+             old->ring, old->src, (now - old->t) / SCALE_MS, old->cap_done,
+             q->isp_src_busy[old->src]);
+    q->isp_failed = true;
+    qemu_set_fd_handler(virtio_media_isp_fd(q->isp), NULL, NULL, NULL);
+    virtio_media_isp_close(q->isp);
+    q->isp = NULL;
+    for (l = q->isp_fifo.head; l; l = l->next) {
+        ((VirtIOMediaIspEvt *)l->data)->ready = true;
+    }
+    virtio_media_isp_flush(s, q);
+    virtio_media_isp_teardown(q);
+}
+
+/* Open the ISP and import its ring into GL. 0, -EAGAIN (GL not up yet: retry), <0. */
+static int virtio_media_isp_start(VirtIOMediaSession *s, VirtIOMediaQueue *q,
+                                  uint32_t src_used, uint32_t dst_w, uint32_t dst_h,
+                                  uint32_t dst_bpl)
+{
+    uint32_t k;
+    int e = 0;
+
+    static uint64_t epochs;
+
+    if (!q->isp_timer) {
+        q->isp_timer = timer_new_ns(QEMU_CLOCK_REALTIME, virtio_media_isp_stalled, s);
+    }
+    q->isp_epoch = ++epochs;
+    q->isp_dst_h = dst_h;
+    q->isp_dst_bpl = dst_bpl;
+    /*
+     * host-sand: the codec's SAND column holds sand_col_height lines (luma then chroma,
+     * 1632 = 1088 + 544 for 1080p); the ISP takes that as its bytesperline and the luma
+     * rows (where the chroma starts) as its height. A padded column (q11-sand-stride,
+     * 720p: 1152) keeps the stream's luma rows (720) in q->sand_luma.
+     */
+    q->isp = virtio_media_isp_open(q->sand ? V4L2_PIX_FMT_NV12_COL128 : V4L2_PIX_FMT_NV12,
+                                   q->width,
+                                   q->sand ? (q->sand_luma ? q->sand_luma
+                                              : virtio_media_sand_luma_rows(q->sand_col_height))
+                                           : q->height,
+                                   q->sand ? q->sand_col_height : q->bytesperline, src_used,
+                                   dst_w, dst_h, dst_bpl,
+                                   q->host_vis_w, q->host_vis_h, q->guest_vis_w,
+                                   q->guest_vis_h, q->matrix, q->num_bufs,
+                                   VIRTIO_MEDIA_ISP_RING, &e);
+    if (!q->isp) {
+        return e ? e : -EIO;
+    }
+    for (k = 0; k < VIRTIO_MEDIA_ISP_RING; k++) {
+        uint32_t len = 0;
+        int fd = virtio_media_isp_ring_fd(q->isp, k, &len);
+
+        if (fd >= 0) {
+            fd = fcntl(fd, F_DUPFD_CLOEXEC, 0); /* the import owns its fd */
+        }
+        if (fd < 0) {
+            return -EBADF;
+        }
+        /* the guest resource is dst_bpl / 4 wide (padded), as the blit requires */
+        q->isp_gpu[k] = virtio_media_gpu_import(fd, dst_bpl / 4, dst_h, dst_bpl, len, &e);
+        if (!q->isp_gpu[k]) {
+            return e ? e : -EIO;
+        }
+    }
+    return 0;
+}
+
+/*
+ * Queue CAPTURE frame idx to the ISP. 0: queued, *held is the guest event's FIFO entry
+ * to fill in; <0: use GL for this frame (-EBUSY: ring full, -EAGAIN: no GL yet; both
+ * leave the ISP on).
+ */
+static int virtio_media_isp_frame(VirtIOMediaSession *s, VirtIOMediaQueue *q, uint32_t idx,
+                                  uint32_t res, uint32_t dst_w, uint32_t dst_h,
+                                  uint32_t dst_bpl, VirtIOMediaIspEvt **held)
+{
+    uint32_t src_used = q->host_sizeimage ? q->host_sizeimage
+                                          : q->bytesperline * q->height * 3 / 2;
+    uint32_t k;
+    int64_t now;
+    bool idle;
+    int r;
+
+    if (idx >= VIRTIO_MEDIA_MAX_BUFFERS || src_used > q->host_len[idx][0]) {
+        r = -EINVAL;
+        goto fail;
+    }
+    if (!q->isp) {
+        r = virtio_media_isp_start(s, q, src_used, dst_w, dst_h, dst_bpl);
+        if (r == -EAGAIN) {
+            /* no GL context yet: this frame takes the GL path, try again next frame */
+            virtio_media_isp_teardown(q);
+            return r;
+        }
+        if (r) {
+            goto fail;
+        }
+    }
+    /* the next ring buffer that neither the ISP nor the display (isp-scanout) holds */
+    for (k = q->isp_ring_next, r = 0; r < VIRTIO_MEDIA_ISP_RING;
+         r++, k = (k + 1) % VIRTIO_MEDIA_ISP_RING) {
+        if (!q->isp_ring_busy[k] && !q->isp_ring_held[k] && !q->isp_ring_pending[k]) {
+            break;
+        }
+    }
+    if (r == VIRTIO_MEDIA_ISP_RING) {
+        /* all with the ISP or on screen: this one frame goes the GL way */
+        q->isp_ring_full++;
+        return -EBUSY;
+    }
+    if (!q->isp_src_fd[idx]) {
+        struct v4l2_exportbuffer eb = {
+            .type = q->type, .index = idx, .plane = 0, .flags = O_RDONLY | O_CLOEXEC,
+        };
+
+        if (ioctl(s->fd, VIDIOC_EXPBUF, &eb) < 0) {
+            r = -errno;
+            goto fail;
+        }
+        q->isp_src_fd[idx] = eb.fd + 1;
+    }
+    /* the ISP must not overwrite ring buffer k while the last copy from it may run */
+    virtio_media_gpu_wait(q->isp_gpu[k]);
+    if (q->isp_src_busy[idx]) {
+        /* cannot happen (its event is held until the ISP returns it): be safe anyway */
+        return -EBUSY;
+    }
+    idle = virtio_media_isp_in_flight(q->isp) == 0;
+    now = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+    q->isp_t[k] = qemu_lat_diag() ? now : 0;
+    r = virtio_media_isp_submit(q->isp, idx, q->isp_src_fd[idx] - 1, q->host_len[idx][0],
+                                src_used, k);
+    if (r) {
+        goto fail;
+    }
+    q->isp_ring_busy[k] = true;
+    q->isp_ring_seq[k] = ++q->isp_seq; /* an older publication of k is stale from now */
+    q->isp_ring_res[k] = res;
+    q->isp_ring_src[k] = idx;    /* q11-sand-scanout */
+    q->sand_seq[idx]++;
+    q->sand_hostq[idx] = false;
+    q->sand_sess = s;
+    q->isp_src_busy[idx] = true;
+    q->isp_ring_next = (k + 1) % VIRTIO_MEDIA_ISP_RING;
+    *held = g_new0(VirtIOMediaIspEvt, 1);
+    (*held)->ring = k;
+    (*held)->src = idx;
+    (*held)->t = now;
+    if (idle) {
+        /* POLLIN: a converted frame; POLLOUT: a codec buffer the ISP is done with */
+        qemu_set_fd_handler(virtio_media_isp_fd(q->isp), virtio_media_isp_readable,
+                            virtio_media_isp_readable, s);
+    }
+    if (!timer_pending(q->isp_timer)) {
+        timer_mod(q->isp_timer, now + VIRTIO_MEDIA_ISP_STALL_NS);
+    }
+    return 0;
+
+fail:
+    qemu_log("virtio-media-diag: host_isp: off for this queue (%d), GL path instead\n", r);
+    q->isp_failed = true;
+    if (!q->isp || virtio_media_isp_in_flight(q->isp) == 0) {
+        /* nothing in flight, so every held event is ready: send them before the FIFO goes */
+        virtio_media_isp_flush(s, q);
+        virtio_media_isp_teardown(q);
+    }
+    return r;
+}
