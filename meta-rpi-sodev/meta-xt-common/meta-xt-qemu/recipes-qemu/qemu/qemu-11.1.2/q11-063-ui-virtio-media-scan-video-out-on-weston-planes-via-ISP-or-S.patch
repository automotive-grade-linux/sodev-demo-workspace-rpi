+    if (q->gpu_buf[idx]) {
+        return true;
+    }
+    if (!s->vm->gpu_xfer || q->gpu_failed || q->sand_import_failed || !q->nv12_host || !q->sand) {
+        return false;
+    }
+    if (ioctl(s->fd, VIDIOC_EXPBUF, &eb) < 0) {
+        return false;
+    }
+    luma_rows = q->sand_luma ? q->sand_luma : virtio_media_sand_luma_rows(q->sand_col_height);
