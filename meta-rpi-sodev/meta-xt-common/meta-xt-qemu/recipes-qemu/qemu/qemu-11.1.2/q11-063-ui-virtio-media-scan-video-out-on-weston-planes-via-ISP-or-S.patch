+                         qemu_dmabuf_get_height(src->dmabuf));
+    } else {
+        egl_fb_blit_rect(dst, src, flip, 0, 0, src->width, src->height);
+    }
+}
+
+void egl_fb_blit_rect(egl_fb *dst, egl_fb *src, bool flip, uint32_t sx, uint32_t sy,
+                      uint32_t sw, uint32_t sh)
+{
+    GLuint x1 = sx;
+    GLuint y1 = sy;
     GLuint x2, y2;
-    GLuint w = src->width;
-    GLuint h = src->height;
+    GLuint w = sw;
+    GLuint h = sh;
 
     glBindFramebuffer(GL_READ_FRAMEBUFFER, src->framebuffer);
     glBindFramebuffer(GL_DRAW_FRAMEBUFFER, dst->framebuffer);
     glViewport(0, 0, dst->width, dst->height);
-    glClear(GL_COLOR_BUFFER_BIT);
 
-    if (src->dmabuf) {
-        x1 = qemu_dmabuf_get_x(src->dmabuf);
-        y1 = qemu_dmabuf_get_y(src->dmabuf);
-        w = qemu_dmabuf_get_width(src->dmabuf);
-        h = qemu_dmabuf_get_height(src->dmabuf);
+    if (x1 >= (GLuint)src->width || y1 >= (GLuint)src->height || !w || !h) {
+        /* a rectangle outside the texture: the whole of it, as before */
+        x1 = y1 = 0;
+        w = src->width;
+        h = src->height;
     }
 
     w = (x1 + w) > src->width ? src->width - x1 : w;
     h = (y1 + h) > src->height ? src->height - y1 : h;
 
+    /*
+     * The blit below stretches the source over all of dst, so clearing first only
+     * costs a separate clear job plus a full tile load in the blit's job (Mesa v3d).
+     * Invalidate instead -- but only when v3d will draw the blit (scaled or
+     * flipped): an unscaled, unflipped blit may take the TFU/TLB path, which leaves
+     * the invalidation for the next draw (the overlays) to skip loading its result.
+     */
+    if (dst->x == 0 && dst->y == 0 &&
+        (flip || w != (GLuint)dst->width || h != (GLuint)dst->height) &&
+        egl_fb_invalidate_on() && egl_fb_can_invalidate()) {
+        GLenum att = dst->framebuffer ? GL_COLOR_ATTACHMENT0 : GL_COLOR;
+
+        glInvalidateFramebuffer(GL_DRAW_FRAMEBUFFER, 1, &att);
+    } else {
+        glClear(GL_COLOR_BUFFER_BIT);
+    }
+
     y2 = flip ? y1 : h + y1;
     y1 = flip ? h + y1 : y1;
     x2 = x1 + w;
