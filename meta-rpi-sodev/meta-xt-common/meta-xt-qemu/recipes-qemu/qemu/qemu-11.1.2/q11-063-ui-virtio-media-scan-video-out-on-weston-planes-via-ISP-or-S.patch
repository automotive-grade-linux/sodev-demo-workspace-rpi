+{
+}
+
+void sdl2_wl_scanout_miss(const char *why)
+{
+}
+
+void sdl2_wl_scanout_off(void)
+{
+}
+
+bool sdl2_wl_scanout(struct sdl2_console *scon, const DirectScanout *d, uint32_t w,
+                     uint32_t h)
+{
+    return false;
+}
