@@ -355,6 +375,28 @@ static const char *nv12_fs =
     "  float b = y + u_coef.w * c.x;\n"
     "  o = vec4(clamp(vec3(r, g, b), 0.0, 1.0), 1.0);\n"
     "}\n";
+/* host-sand: identical maths; the planes are SAND128 imports, which Mesa only binds external. */
+static const char *nv12_fs_ext =
+    "#version 300 es\n"
+    "#extension GL_OES_EGL_image_external_essl3 : require\n"
+    "precision highp float;\n"
+    "uniform samplerExternalOES u_y;\n"
+    "uniform samplerExternalOES u_uv;\n"
+    "uniform vec2 u_src_size;\n"
+    "uniform vec2 u_scale;\n"
+    "uniform float u_yoff;\n"
+    "uniform float u_yscale;\n"
+    "uniform vec4 u_coef;\n"
+    "out vec4 o;\n"
+    "void main() {\n"
+    "  vec2 uv = gl_FragCoord.xy * u_scale / u_src_size;\n"
+    "  float y = (texture(u_y, uv).r - u_yoff) * u_yscale;\n"
+    "  vec2 c = texture(u_uv, uv).rg - vec2(0.5);\n"
+    "  float r = y + u_coef.x * c.y;\n"
+    "  float g = y + u_coef.y * c.x + u_coef.z * c.y;\n"
+    "  float b = y + u_coef.w * c.x;\n"
+    "  o = vec4(clamp(vec3(r, g, b), 0.0, 1.0), 1.0);\n"
+    "}\n";
 
