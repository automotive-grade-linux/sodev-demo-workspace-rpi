-    if (!gpu_build_nv12_program()) {
+    if (!gpu_build_nv12_program(sand)) {
         gpu_leave(&sv);
         close(dmabuf_fd);
         if (err) {
@@ -455,11 +539,13 @@ void *virtio_media_gpu_import_nv12(int dmabuf_fd, uint32_t src_width,
     b->stride = stride;
     b->len = len;
     b->matrix = matrix;
+    b->sand = sand;
     b->tex = gpu_import_plane(dmabuf_fd, VM_DRM_FORMAT_R8, src_width,
-                              src_height, stride, 0, scaled);
+                              src_height, stride, 0, scaled, mod, sand);
     b->tex_uv = b->tex ? gpu_import_plane(dmabuf_fd, VM_DRM_FORMAT_GR88,
                                           src_width / 2, src_height / 2,
-                                          stride, uv_offset, scaled) : 0;
+                                          stride, uv_offset, scaled, mod,
+                                          sand) : 0;
     if (!b->tex || !b->tex_uv) {
         if (b->tex) {
             glDeleteTextures(1, &b->tex);
@@ -515,23 +601,28 @@ static int gpu_draw_nv12(VirtIOMediaGpuBuf *b, GLuint dst_tex)
     glDisable(GL_DEPTH_TEST);
     glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
     glViewport(0, 0, b->width, b->height);
-    glUseProgram(gpu.prog);
-    glActiveTexture(GL_TEXTURE0);
-    glBindTexture(GL_TEXTURE_2D, b->tex);
-    glActiveTexture(GL_TEXTURE1);
-    glBindTexture(GL_TEXTURE_2D, b->tex_uv);
-    glUniform1i(gpu.u_y, 0);
-    glUniform1i(gpu.u_uv, 1);
-    glUniform2f(gpu.u_src_size, (float)b->src_width, (float)b->src_height);
-    glUniform2f(gpu.u_scale, b->scale_x, b->scale_y);
-    glUniform1f(gpu.u_yoff, yoff);
-    glUniform1f(gpu.u_yscale, yscale);
-    glUniform4fv(gpu.u_coef, 1, c);
-    glBindVertexArray(0);
-    glDrawArrays(GL_TRIANGLES, 0, 3);
-    glBindTexture(GL_TEXTURE_2D, 0);
-    glActiveTexture(GL_TEXTURE0);
-    glBindTexture(GL_TEXTURE_2D, 0);
+    {
+        GLenum target = b->sand ? GL_TEXTURE_EXTERNAL_OES : GL_TEXTURE_2D;
+
+        glUseProgram(b->sand ? gpu.prog_ext : gpu.prog);
+        glActiveTexture(GL_TEXTURE0);
+        glBindTexture(target, b->tex);
+        glActiveTexture(GL_TEXTURE1);
+        glBindTexture(target, b->tex_uv);
+        glUniform1i(b->sand ? gpu.e_y : gpu.u_y, 0);
+        glUniform1i(b->sand ? gpu.e_uv : gpu.u_uv, 1);
+        glUniform2f(b->sand ? gpu.e_src_size : gpu.u_src_size,
+                    (float)b->src_width, (float)b->src_height);
+        glUniform2f(b->sand ? gpu.e_scale : gpu.u_scale, b->scale_x, b->scale_y);
+        glUniform1f(b->sand ? gpu.e_yoff : gpu.u_yoff, yoff);
+        glUniform1f(b->sand ? gpu.e_yscale : gpu.u_yscale, yscale);
+        glUniform4fv(b->sand ? gpu.e_coef : gpu.u_coef, 1, c);
+        glBindVertexArray(0);
+        glDrawArrays(GL_TRIANGLES, 0, 3);
+        glBindTexture(target, 0);
+        glActiveTexture(GL_TEXTURE0);
+        glBindTexture(target, 0);
+    }
     glUseProgram(0);
     glBindFramebuffer(GL_DRAW_FRAMEBUFFER, 0);
     return 0;
diff --git a/hw/virtio/virtio-media.c b/hw/virtio/virtio-media.c
