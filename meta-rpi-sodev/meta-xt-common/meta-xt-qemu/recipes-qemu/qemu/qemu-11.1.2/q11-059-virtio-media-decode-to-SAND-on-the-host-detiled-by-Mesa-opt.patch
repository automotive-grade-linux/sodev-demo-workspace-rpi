-    glAttachShader(gpu.prog, fs);
-    glLinkProgram(gpu.prog);
+    prog = glCreateProgram();
+    glAttachShader(prog, vs);
+    glAttachShader(prog, fs);
+    glLinkProgram(prog);
     glDeleteShader(vs);
     glDeleteShader(fs);
-    glGetProgramiv(gpu.prog, GL_LINK_STATUS, &ok);
+    glGetProgramiv(prog, GL_LINK_STATUS, &ok);
     if (!ok) {
         char log[512] = "";
-        glGetProgramInfoLog(gpu.prog, sizeof(log), NULL, log);
+        glGetProgramInfoLog(prog, sizeof(log), NULL, log);
         qemu_log("virtio-media-diag: gpu_xfer: program link failed: %s\n", log);
-        glDeleteProgram(gpu.prog);
-        gpu.prog = 0;
+        glDeleteProgram(prog);
+        return 0;
+    }
+    return prog;
+}
+
+static bool gpu_build_nv12_program(bool ext)
+{
+    GLuint p;
+
+    if (ext) {
+        if (gpu.prog_ext) {
+            return true;
+        }
+        if (gpu.prog_ext_failed) {
+            return false;
+        }
+        p = gpu_link_nv12_program(nv12_fs_ext);
+        if (!p) {
+            gpu.prog_ext_failed = true;
+            return false;
+        }
+        gpu.prog_ext = p;
+        gpu.e_y = glGetUniformLocation(p, "u_y");
+        gpu.e_uv = glGetUniformLocation(p, "u_uv");
+        gpu.e_src_size = glGetUniformLocation(p, "u_src_size");
+        gpu.e_scale = glGetUniformLocation(p, "u_scale");
+        gpu.e_yoff = glGetUniformLocation(p, "u_yoff");
+        gpu.e_yscale = glGetUniformLocation(p, "u_yscale");
+        gpu.e_coef = glGetUniformLocation(p, "u_coef");
+        return true;
+    }
+    if (gpu.prog) {
+        return true;
+    }
+    if (gpu.prog_failed) {
+        return false;
+    }
+    p = gpu_link_nv12_program(nv12_fs);
+    if (!p) {
         gpu.prog_failed = true;
         return false;
     }
+    gpu.prog = p;
     gpu.u_y = glGetUniformLocation(gpu.prog, "u_y");
     gpu.u_uv = glGetUniformLocation(gpu.prog, "u_uv");
     gpu.u_src_size = glGetUniformLocation(gpu.prog, "u_src_size");
@@ -421,11 +501,15 @@ void *virtio_media_gpu_import_nv12(int dmabuf_fd, uint32_t src_width,
                                    uint32_t src_height, uint32_t stride,
