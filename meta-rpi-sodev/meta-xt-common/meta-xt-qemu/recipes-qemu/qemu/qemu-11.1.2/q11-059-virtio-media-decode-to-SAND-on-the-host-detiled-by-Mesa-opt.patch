@@ -78,10 +78,21 @@ typedef struct VirtIOMediaGpuBuf {
     float scale_x, scale_y;   /* source pixels per destination pixel */
     GLuint tex_uv;
     int matrix;
+    bool sand;                /* planes are SAND128 external textures (host-sand) */
 } VirtIOMediaGpuBuf;
 
 #define VM_DRM_FORMAT_R8    0x20203852u   /* 'R8  ' */
 #define VM_DRM_FORMAT_GR88  0x38385247u   /* 'GR88': byte0 = R (Cb), byte1 = G (Cr) */
+/*
+ * DRM_FORMAT_MOD_BROADCOM_SAND128_COL_HEIGHT(h) (drm_fourcc.h): vendor 0x07, the column height
+ * in lines in the parameter field (bits 8..55), mod 4. Mesa v3d accepts it for R8 and GR88
+ * planes, external-only, and detiles them into a tiled shadow with its sand8 blit.
+ */
+#define VM_DRM_FORMAT_MOD_SAND128_COL_HEIGHT(h) \
+    ((0x07ull << 56) | (((uint64_t)(h) & 0xffffffffffffull) << 8) | 4ull)
+#ifndef GL_TEXTURE_EXTERNAL_OES
+#define GL_TEXTURE_EXTERNAL_OES 0x8D65
+#endif
 
