         EGL_HEIGHT, height,
@@ -282,12 +299,15 @@ static GLuint gpu_import_plane(int fd, uint32_t fourcc, uint32_t width,
         EGL_DMA_BUF_PLANE0_FD_EXT, fd,
         EGL_DMA_BUF_PLANE0_OFFSET_EXT, offset,
