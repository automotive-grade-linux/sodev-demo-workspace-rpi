 {
@@ -374,39 +416,77 @@ static GLuint gpu_compile(GLenum type, const char *src)
     return sh;
 }
 
-static bool gpu_build_nv12_program(void)
+static GLuint gpu_link_nv12_program(const char *fs_src)
 {
