--- a/hw/virtio/virtio-media.c
+++ b/hw/virtio/virtio-media.c
@@ -180,6 +180,10 @@ static void virtio_media_queue_release(VirtIOMediaSession *s, VirtIOMediaQueue *
 /* host-nv12 helpers                                                         */
 /* ------------------------------------------------------------------------- */
 
+#ifndef V4L2_PIX_FMT_NV12_COL128
+#define V4L2_PIX_FMT_NV12_COL128 v4l2_fourcc('N', 'C', '1', '2')
+#endif
+
 static inline uint32_t virtio_media_rgba_bpl(uint32_t width)
 {
     /* What bcm2835-codec answers for RGBA32: bytesperline_align 64. */
@@ -255,6 +259,21 @@ static void virtio_media_fmt_set_size(struct v4l2_format *f, uint32_t w,
