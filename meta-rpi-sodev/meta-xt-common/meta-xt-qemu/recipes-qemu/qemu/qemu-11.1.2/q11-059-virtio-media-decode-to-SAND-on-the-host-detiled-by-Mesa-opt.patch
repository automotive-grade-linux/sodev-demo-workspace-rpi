+                               uint64_t modifier, bool external)
 {
     EGLImageKHR img;
     GLuint tex = 0;
+    GLenum target = external ? GL_TEXTURE_EXTERNAL_OES : GL_TEXTURE_2D;
     EGLint attrs[] = {
