+    fs = gpu_compile(GL_FRAGMENT_SHADER, fs_src);
     if (!vs || !fs) {
-        gpu.prog_failed = true;
-        return false;
+        if (vs) {
+            glDeleteShader(vs);
+        }
+        if (fs) {
+            glDeleteShader(fs);
+        }
+        return 0;
     }
-    gpu.prog = glCreateProgram();
