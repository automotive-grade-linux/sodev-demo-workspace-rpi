+/* Linear NV12 or, with host-sand, its SAND twin: both mean "host YUV, guest RGBA". */
+static inline bool virtio_media_pf_is_host_yuv(uint32_t pf)
+{
+    return pf == V4L2_PIX_FMT_NV12 || pf == V4L2_PIX_FMT_NV12_COL128;
+}
+
+/* host-sand: remember whether the host frame is SAND, and its column height. */
+static void virtio_media_note_sand(VirtIOMediaQueue *q, const struct v4l2_format *f)
+{
+    q->sand = virtio_media_fmt_pixelformat(f) == V4L2_PIX_FMT_NV12_COL128;
+    q->sand_col_height = !q->sand ? 0 :
+        (V4L2_TYPE_IS_MULTIPLANAR(f->type) ? f->fmt.pix_mp.plane_fmt[0].bytesperline
+                                           : f->fmt.pix.bytesperline);
+}
