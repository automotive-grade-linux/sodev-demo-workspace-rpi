     bool prog_failed;
+    /* host-sand: the same program with samplerExternalOES (SAND imports are external-only). */
+    GLuint prog_ext;
+    GLint e_y, e_uv, e_src_size, e_scale, e_yoff, e_yscale, e_coef;
+    bool prog_ext_failed;
 } gpu;
 
