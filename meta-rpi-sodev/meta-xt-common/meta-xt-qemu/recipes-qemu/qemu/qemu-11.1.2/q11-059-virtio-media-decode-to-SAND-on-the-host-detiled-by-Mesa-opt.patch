-        EGL_DMA_BUF_PLANE0_MODIFIER_LO_EXT, (EGLint)(VM_DRM_FORMAT_MOD_LINEAR & 0xffffffffu),
-        EGL_DMA_BUF_PLANE0_MODIFIER_HI_EXT, (EGLint)(VM_DRM_FORMAT_MOD_LINEAR >> 32),
+        EGL_DMA_BUF_PLANE0_MODIFIER_LO_EXT, (EGLint)(modifier & 0xffffffffu),
+        EGL_DMA_BUF_PLANE0_MODIFIER_HI_EXT, (EGLint)(modifier >> 32),
         EGL_NONE
     };
 
     if (!gpu_have_egl_ext(gpu.dpy, "EGL_EXT_image_dma_buf_import_modifiers")) {
+        if (modifier != VM_DRM_FORMAT_MOD_LINEAR) {
+            return 0;   /* a SAND buffer cannot be described without the modifier */
+        }
         attrs[12] = EGL_NONE;
     }
     img = eglCreateImageKHR(gpu.dpy, EGL_NO_CONTEXT, EGL_LINUX_DMA_BUF_EXT,
@@ -302,15 +322,15 @@ static GLuint gpu_import_plane(int fd, uint32_t fourcc, uint32_t width,
         /* clear stale errors */
     }
     glGenTextures(1, &tex);
-    glBindTexture(GL_TEXTURE_2D, tex);
