From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yuichi Kusakabe <yuichi_kusakabe@jp.honda>
Date: Wed, 14 Oct 2026 00:47:10 +0900
Subject: [PATCH] virtio-gpu: clear overlay and handed-off plane state on reset
 and on errors

Three cases left stale display state behind once overlay planes
(q11-051) or the plane handoff (q11-066) were in use:

- A device reset only cleared the outputs' scanouts, not the overlay
  planes' extra ones, and did not take the overlays off the display:
  after a reset, texture names that the reset had deleted
  kept being blended over scanout 0. Reset now clears all
  max_outputs + overlay_planes scanouts and the overlay state, and
  drops each overlay from the display before the textures go away. It
  also clears the resource ids the plane handoff tracks for scanout 0
  and the overlays, and each output's positioned / scaled primary
  rectangle.
- A SET_SCANOUT on an overlay plane whose resource_get_info failed
  returned with the error but left the plane's previous resource and
  the display's overlay in place. It is now handled like resource 0:
  the plane is cleared and dropped from the display, and the error is
  still returned.
- The SDL GL display kept an overlay's framebuffer while the texture
  name stayed the same, but a name can come back for a new resource of
  another size; the framebuffer is now rebuilt when the size changes
  too.

Assisted-by: Claude Code:claude-opus-5-5
Signed-off-by: Yuichi Kusakabe <yuichi_kusakabe@jp.honda>
Upstream-Status: Inappropriate [fixes this layer's overlay-plane and plane-handoff patches]
---
 hw/display/virtio-gpu-base.c  |  4 +++-
 hw/display/virtio-gpu-virgl.c | 29 +++++++++++++++++++++++------
 ui/sdl2-gl.c                  |  5 ++++-
 3 files changed, 30 insertions(+), 8 deletions(-)

diff --git a/hw/display/virtio-gpu-base.c b/hw/display/virtio-gpu-base.c
index 9ce9038..824a7d6 100644
--- a/hw/display/virtio-gpu-base.c
+++ b/hw/display/virtio-gpu-base.c
@@ -28,7 +28,8 @@ virtio_gpu_base_reset(VirtIOGPUBase *g)
 
     g->enable = 0;
 
-    for (i = 0; i < g->conf.max_outputs; i++) {
+    /* the overlay planes' scanouts too, which have no console */
+    for (i = 0; i < g->conf.max_outputs + g->conf.overlay_planes; i++) {
         g->scanout[i].resource_id = 0;
         g->scanout[i].width = 0;
         g->scanout[i].height = 0;
@@ -36,6 +37,7 @@ virtio_gpu_base_reset(VirtIOGPUBase *g)
         g->scanout[i].y = 0;
         g->scanout[i].ds = NULL;
     }
+    memset(g->overlay, 0, sizeof(g->overlay));
 }
 
 void
diff --git a/hw/display/virtio-gpu-virgl.c b/hw/display/virtio-gpu-virgl.c
index 6a85f4b..54cafa6 100644
--- a/hw/display/virtio-gpu-virgl.c
+++ b/hw/display/virtio-gpu-virgl.c
@@ -770,14 +770,16 @@ static void virgl_cmd_set_overlay(VirtIOGPU *g,
         if (virgl_renderer_resource_get_info(ss->resource_id, &info)) {
             qemu_log_mask(LOG_GUEST_ERROR, "%s: illegal resource specified %d\n",
                           __func__, ss->resource_id);
+            /* and drop the overlay below, as for resource 0 */
             cmd->error = VIRTIO_GPU_RESP_ERR_INVALID_RESOURCE_ID;
-            return;
+        } else {
+            b->overlay[k].tex_id = info.tex_id;
+            b->overlay[k].tex_w = info.width;
+            b->overlay[k].tex_h = info.height;
+            b->overlay[k].y0_top =
+                info.flags & VIRTIO_GPU_RESOURCE_FLAG_Y_0_TOP;
+            b->overlay[k].on = true;
         }
-        b->overlay[k].tex_id = info.tex_id;
-        b->overlay[k].tex_w = info.width;
-        b->overlay[k].tex_h = info.height;
-        b->overlay[k].y0_top = info.flags & VIRTIO_GPU_RESOURCE_FLAG_Y_0_TOP;
-        b->overlay[k].on = true;
     }
     b->scanout[ss->scanout_id].resource_id = b->overlay[k].on ? ss->resource_id : 0;
     if (k < ARRAY_SIZE(q11_overlay_resource_id)) { /* q11-plane-handoff */
@@ -1761,6 +1763,21 @@ void virtio_gpu_virgl_reset_scanout(VirtIOGPU *g)
     for (i = 0; i < g->parent_obj.conf.max_outputs; i++) {
         qemu_console_set_surface(g->parent_obj.scanout[i].con, NULL);
         qemu_console_gl_scanout_disable(g->parent_obj.scanout[i].con);
+        /* no positioned / scaled primary until the guest sends one again */
+        qemu_console_gl_primary_rect(g->parent_obj.scanout[i].con, 0, 0, 0, 0, 0, 0);
+    }
+    q11_scanout0_resource_id = 0; /* q11-plane-handoff */
+    /*
+     * Drop the overlays from the display before their textures go away (the
+     * reset's resource cleanup and virgl_renderer_reset() delete them).
+     * virtio_gpu_base_reset() has already cleared their state.
+     */
+    for (i = 0; i < g->parent_obj.conf.overlay_planes; i++) {
+        if (i < ARRAY_SIZE(q11_overlay_resource_id)) { /* q11-plane-handoff */
+            q11_overlay_resource_id[i] = 0;
+        }
+        qemu_console_gl_overlay(g->parent_obj.scanout[0].con, i, false, 0,
+                                false, 0, 0, 0, 0);
     }
 }
 
diff --git a/ui/sdl2-gl.c b/ui/sdl2-gl.c
index e0a1e35..aa91f59 100644
--- a/ui/sdl2-gl.c
+++ b/ui/sdl2-gl.c
@@ -297,7 +297,10 @@ void sdl2_gl_overlay(DisplayChangeListener *dcl, unsigned int idx, bool on,
         return;
     }
     SDL_GL_MakeCurrent(scon->real_window, scon->winctx);
-    if (scon->ovl[idx].fb.texture != tex_id || !on) {
+    /* a texture name can come back for a new resource of another size */
+    if (scon->ovl[idx].fb.texture != tex_id || !on ||
+        scon->ovl[idx].fb.width != tex_w ||
+        scon->ovl[idx].fb.height != tex_h) {
         egl_fb_destroy(&scon->ovl[idx].fb);
     }
     scon->ovl[idx].on = on && tex_id;
