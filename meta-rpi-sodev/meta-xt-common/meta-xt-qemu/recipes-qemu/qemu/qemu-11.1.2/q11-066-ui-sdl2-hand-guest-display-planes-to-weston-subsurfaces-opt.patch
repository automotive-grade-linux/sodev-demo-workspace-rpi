+/*
+ * q11-plane-handoff (2026-10-13, on while /run/qemu-plane-handoff exists, read once a
+ * second): when the guest display is not one directly scanned-out buffer -- the HMI case,
+ * a scaled primary (the WebView video underlay) under three overlays -- qemu does not
+ * blend the planes with V3D and swap; each plane's guest texture is exported as a dmabuf
+ * (BROADCOM_UIF) and attached to its own wl_subsurface of the window (the primary scaled
+ * with a wp_viewport), and weston composites them. RPi4, local 720p60 in the HMI layout:
+ * 52 -> 57 fps, Chromium drops 8 -> 2%, V3D render (qemu + weston) 37.5 -> 16.6%; a streamed
+ * video in the HMI layout 32.7 -> 42.6 (DomA CPU is the limit there).
+ * No hold of the guest: the guest's next write to a buffer and weston's read of it are
+ * both V3D jobs on the same BO and are ordered by the kernel's implicit sync. (Holding the
+ * guest until weston's frame callback or buffer release was tried: 20-24 ms per frame,
+ * 42 fps.) What did bite:
+ *  - GL texture names are recycled: a cache keyed by name and size handed weston another
+ *    resource's old dmabuf (the launcher shown instead of the app, flashing video) -> the
+ *    cache is keyed by the virtio resource too and drops a resource the guest unrefs;
+ *  - a plane moved between presents: weston applied the new position before the new size
+ *    and killed qemu for a window geometry past the fullscreen size (xdg_wm_base error 4)
+ *    -> a plane that moves or resizes is unmapped in its own parent commit first, and
+ *    every plane is clipped to the window;
+ *  - the default input region would take the touches: it is empty.
+ */
+#define WL_PLANES 4
+#define WL_PLANE_CACHE 64
+
+typedef struct WlPlaneBuf {
+    uint32_t tex, w, h;
+    uint32_t res; /* virtio resource (0 = unknown) */
+    struct wl_buffer *wb;
+    int64_t used;
+} WlPlaneBuf;
+
+static struct {
+    struct wl_surface *s[WL_PLANES];
+    struct wl_subsurface *ss[WL_PLANES];
+    struct wp_viewport *vp[WL_PLANES];
+    WlPlaneBuf *cur[WL_PLANES];
+    int gx[WL_PLANES], gy[WL_PLANES], gw[WL_PLANES], gh[WL_PLANES]; /* last placement */
+    bool shown;
+    GPtrArray *cache;
+    uint64_t presents, exports, export_fail, evicted;
+    uint64_t geom, name_reuse, gone; /* per stats line */
+} pl;
+
+static bool planes_flag(void)
+{
+    static int64_t last = INT64_MIN;
+    static bool on;
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+
+    if (last == INT64_MIN || now - last > NANOSECONDS_PER_SECOND) {
+        last = now;
+        on = access("/run/qemu-plane-handoff", F_OK) == 0;
+    }
+    return on;
+}
+
+static bool plane_in_use(WlPlaneBuf *b)
+{
+    for (int i = 0; i < WL_PLANES; i++) {
+        if (pl.cur[i] == b) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static WlPlaneBuf *plane_buf(uint32_t tex, uint32_t w, uint32_t h, uint32_t res)
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+    int fd[DMABUF_MAX_PLANES] = { -1, -1, -1, -1 };
+    EGLint off[DMABUF_MAX_PLANES], stride[DMABUF_MAX_PLANES], fourcc = 0;
+    EGLuint64KHR mod = 0;
+    int np = 0;
+    struct zwp_linux_buffer_params_v1 *params;
+    WlPlaneBuf *b;
+
+    if (!pl.cache) {
+        pl.cache = g_ptr_array_new();
+    }
+    for (guint i = 0; i < pl.cache->len; i++) {
+        b = g_ptr_array_index(pl.cache, i);
+        if (b->tex == tex && b->w == w && b->h == h) {
+            if (res && b->res && b->res != res) {
+                /* the GL name now belongs to another resource: never match this entry again */
+                pl.name_reuse++;
+                b->tex = 0;
+                continue;
+            }
+            b->used = now;
+            return b;
+        }
+    }
+    if (!egl_dmabuf_export_texture(tex, fd, off, stride, &fourcc, &np, &mod)) {
+        for (int i = 0; i < DMABUF_MAX_PLANES; i++) {
+            if (fd[i] >= 0) {
+                close(fd[i]);
+            }
+        }
+        if (pl.export_fail++ == 0) {
+            warn_report("sdl2: plane-handoff: texture %u (%ux%u) cannot be exported", tex,
+                        w, h);
+        }
+        return NULL;
+    }
+    params = zwp_linux_dmabuf_v1_create_params(wl.dmabuf);
+    for (int i = 0; i < np; i++) {
+        zwp_linux_buffer_params_v1_add(params, fd[i], i, off[i], stride[i], mod >> 32,
+                                       mod & 0xffffffff);
+    }
+    b = g_new0(WlPlaneBuf, 1);
+    b->tex = tex;
+    b->w = w;
+    b->h = h;
+    b->res = res;
+    b->used = now;
+    b->wb = zwp_linux_buffer_params_v1_create_immed(params, w, h, fourcc, 0);
+    zwp_linux_buffer_params_v1_destroy(params);
+    for (int i = 0; i < np; i++) {
+        close(fd[i]);
+    }
+    if (pl.exports++ < 8) {
+        info_report("sdl2: plane-handoff: texture %u %ux%u fourcc %.4s modifier 0x%016" PRIx64
+                    " planes %d", tex, w, h, (char *)&fourcc, (uint64_t)mod, np);
+    }
+    if (pl.cache->len >= WL_PLANE_CACHE) { /* drop the least recently used, not on screen */
+        guint lru = 0;
+        int64_t t = INT64_MAX;
+
+        for (guint i = 0; i < pl.cache->len; i++) {
+            WlPlaneBuf *o = g_ptr_array_index(pl.cache, i);
+
+            if (o->used < t && !plane_in_use(o)) {
+                t = o->used;
+                lru = i;
+            }
+        }
+        wl_buffer_destroy(((WlPlaneBuf *)g_ptr_array_index(pl.cache, lru))->wb);
+        g_free(g_ptr_array_index(pl.cache, lru));
+        g_ptr_array_remove_index_fast(pl.cache, lru);
+        pl.evicted++;
+    }
+    g_ptr_array_add(pl.cache, b);
+    return b;
+}
+
+/* the guest unref'd res (virtio-gpu-virgl.c): its buffers are never matched again */
+static void pl_resource_gone(uint32_t res)
+{
+    if (!pl.cache) {
+        return;
+    }
+    for (guint i = 0; i < pl.cache->len; i++) {
+        WlPlaneBuf *b = g_ptr_array_index(pl.cache, i);
+
+        if (b->res == res && b->tex) {
+            b->tex = 0; /* the LRU frees it once it is off screen */
+            pl.gone++;
+        }
+    }
+}
+
+static bool planes_create(void)
+{
+    if (pl.s[0]) {
+        return true;
+    }
+    if (!wl.compositor || !wl.subcomp || !wl.viewporter) {
+        return false;
+    }
+    for (int i = 0; i < WL_PLANES; i++) {
+        struct wl_region *none = wl_compositor_create_region(wl.compositor);
+
+        pl.s[i] = wl_compositor_create_surface(wl.compositor);
+        pl.ss[i] = wl_subcompositor_get_subsurface(wl.subcomp, pl.s[i], wl.surf);
+        pl.vp[i] = wp_viewporter_get_viewport(wl.viewporter, pl.s[i]);
+        /* no input on the planes: touches and pointer stay with the window (SDL) */
+        wl_surface_set_input_region(pl.s[i], none);
+        wl_region_destroy(none);
+        wl_subsurface_place_above(pl.ss[i], i ? pl.s[i - 1] : wl.surf);
+        wl_subsurface_set_sync(pl.ss[i]);
+    }
+    q11_resource_gone_cb = pl_resource_gone;
+    info_report("sdl2: plane-handoff: %d subsurfaces on the window", WL_PLANES);
+    return true;
+}
+
+static void plane_hide(int i)
+{
+    if (pl.cur[i]) {
+        wl_surface_attach(pl.s[i], NULL, 0, 0);
+        wl_surface_commit(pl.s[i]);
+        pl.cur[i] = NULL;
+    }
+}
+
+/* buffer rectangle (sx, sy, sw, sh, in a w x h texture) to window rectangle (dx, dy, dw, dh) */
+static void plane_show(int i, WlPlaneBuf *b, bool y0_top, int sx, int sy, int sw, int sh,
+                       int dx, int dy, int dw, int dh, int ww, int wh)
+{
+    /* clip to the window (see the header); the source shrinks in proportion */
+    double rx = dw > 0 ? (double)sw / dw : 1, ry = dh > 0 ? (double)sh / dh : 1;
+
+    if (dx < 0) {
+        sx += -dx * rx; sw -= -dx * rx; dw += dx; dx = 0;
+    }
+    if (dy < 0) {
+        sy += -dy * ry; sh -= -dy * ry; dh += dy; dy = 0;
+    }
+    if (dx + dw > ww) {
+        sw -= (dx + dw - ww) * rx; dw = ww - dx;
+    }
+    if (dy + dh > wh) {
+        sh -= (dy + dh - wh) * ry; dh = wh - dy;
+    }
+    if (dw <= 0 || dh <= 0 || sw <= 0 || sh <= 0) {
+        plane_hide(i);
+        return;
+    }
+    /*
+     * The exported memory of a usual (!y0_top) guest texture is top-down already (qemu's
+     * GL blit flips it only because GL's origin is bottom-left), so only a y0_top texture
+     * gets the vertical flip; the source rectangle follows it. (y0_top is not seen on the
+     * RPi4 AAOS guest; that branch is untested.)
+     */
+    wl_surface_set_buffer_transform(pl.s[i], y0_top ? WL_OUTPUT_TRANSFORM_FLIPPED_180
+                                                     : WL_OUTPUT_TRANSFORM_NORMAL);
+    if (y0_top) {
+        sy = (int)b->h - sy - sh;
+    }
+    wp_viewport_set_source(pl.vp[i], wl_fixed_from_int(sx), wl_fixed_from_int(sy),
+                           wl_fixed_from_int(sw), wl_fixed_from_int(sh));
+    wp_viewport_set_destination(pl.vp[i], dw, dh);
+    if (pl.presents < 3) {
+        info_report("sdl2: plane-handoff: plane %d tex %u %ux%u src %d,%d %dx%d -> dst %d,%d %dx%d"
+                    " (window %dx%d)", i, b->tex, b->w, b->h, sx, sy, sw, sh, dx, dy, dw, dh,
+                    ww, wh);
+    }
+    if (pl.cur[i] && (pl.gx[i] != dx || pl.gy[i] != dy || pl.gw[i] != dw || pl.gh[i] != dh)) {
+        /* moves or resizes: unmapped first, in its own parent commit (see the header) */
+        plane_hide(i);
+        wl_surface_commit(wl.surf);
+        pl.geom++;
+    }
+    pl.gx[i] = dx;
+    pl.gy[i] = dy;
+    pl.gw[i] = dw;
+    pl.gh[i] = dh;
+    wl_subsurface_set_position(pl.ss[i], dx, dy);
+    wl_surface_attach(pl.s[i], b->wb, 0, 0);
+    wl_surface_damage_buffer(pl.s[i], 0, 0, INT32_MAX, INT32_MAX);
+    wl_surface_commit(pl.s[i]);
+    pl.cur[i] = b;
+}
+
+bool sdl2_wl_planes(struct sdl2_console *scon, int ww, int wh)
+{
+    WlPlaneBuf *b[WL_PLANES] = { NULL };
+    bool rect = scon->prim_w && scon->prim_h && scon->prim_cw && scon->prim_ch;
+    uint32_t cw = rect ? scon->prim_cw : (scon->w ? scon->w : (uint32_t)ww);
+    uint32_t ch = rect ? scon->prim_ch : (scon->h ? scon->h : (uint32_t)wh);
+    double fx = (double)ww / cw, fy = (double)wh / ch;
+
+    if (!planes_flag() || scon->guest_fb.dmabuf || !scon->guest_fb.texture ||
+        !wl_init(scon->real_window) || !planes_create()) {
+        return false;
+    }
+    sdl2_wl_scanout_dispatch();
+    b[0] = plane_buf(scon->guest_fb.texture, scon->guest_fb.width, scon->guest_fb.height,
+                     q11_scanout0_resource_id);
+    if (!b[0]) {
+        return false;
+    }
+    for (int i = 0; i < 3; i++) {
+        if (scon->ovl[i].on && scon->ovl[i].fb.texture) {
+            b[i + 1] = plane_buf(scon->ovl[i].fb.texture, scon->ovl[i].fb.width,
+                                 scon->ovl[i].fb.height, q11_overlay_resource_id[i]);
+            if (!b[i + 1]) {
+                return false;
+            }
+        }
+    }
+    {
+        int sx = scon->w ? scon->x : 0, sy = scon->w ? scon->y : 0;
+        int sw = scon->w ? (int)scon->w : scon->guest_fb.width;
+        int sh = scon->h ? (int)scon->h : scon->guest_fb.height;
+
+        if (rect) {
+            plane_show(0, b[0], scon->y0_top, sx, sy, sw, sh, scon->prim_x * fx,
+                       scon->prim_y * fy, scon->prim_w * fx, scon->prim_h * fy, ww, wh);
+        } else {
+            plane_show(0, b[0], scon->y0_top, sx, sy, sw, sh, 0, 0, ww, wh, ww, wh);
+        }
+    }
+    for (int i = 0; i < 3; i++) {
+        if (b[i + 1]) {
+            plane_show(i + 1, b[i + 1], scon->ovl[i].y0_top, 0, 0, scon->ovl[i].fb.width,
+                       scon->ovl[i].fb.height, scon->ovl[i].x * fx, scon->ovl[i].y * fy,
+                       scon->ovl[i].fb.width * fx, scon->ovl[i].fb.height * fy, ww, wh);
+        } else {
+            plane_hide(i + 1);
+        }
+    }
+    wl_surface_commit(wl.surf); /* the subsurfaces are synchronized: apply them */
+    wl_display_flush(wl.dpy);
+    pl.shown = true;
+    if ((pl.presents++ % 600) == 0) {
+        info_report("sdl2: plane-handoff: %" PRIu64 " presents, %" PRIu64 " exports (%"
+                    PRIu64 " failed, %" PRIu64 " evicted), %u cached; geom %" PRIu64
+                    ", name_reuse %" PRIu64 ", gone %" PRIu64, pl.presents, pl.exports,
+                    pl.export_fail, pl.evicted, pl.cache ? pl.cache->len : 0, pl.geom,
+                    pl.name_reuse, pl.gone);
+        pl.geom = pl.name_reuse = pl.gone = 0;
+    }
+    return true;
+}
+
+void sdl2_wl_planes_off(void)
+{
+    if (!pl.shown) {
+        return;
+    }
+    for (int i = 0; i < WL_PLANES; i++) {
+        plane_hide(i);
+    }
+    wl_surface_commit(wl.surf);
+    wl_display_flush(wl.dpy);
+    pl.shown = false;
+}
+
 #else
 
 void sdl2_wl_scanout_dispatch(void)
 {
 }
 
+bool sdl2_wl_planes(struct sdl2_console *scon, int ww, int wh)
+{
+    return false;
+}
+
+void sdl2_wl_planes_off(void)
+{
+}
+
 void sdl2_wl_scanout_miss(const char *why)
 {
 }
