#!/bin/sh
# SPDX-License-Identifier: MIT
# Activate the flat L2 bridge once the guests (and their qemu taps) exist.
# The bridge is activated LATE, after the guests (and their qemu taps) exist. Doing
# it at boot instead enslaved eth0 and the netfront into xenbr0 and broke xenbus
# about seven seconds in, so no guest was ever created and both screens stayed
# black. Activating it post-boot keeps the xenstore-critical window on the plain
# static network configuration, and then joins eth0 and the DomU/DomA qemu taps
# into xenbr0. xenbr0 then obtains the wired/LAN address by DHCP, equivalent to
# running udhcpc manually after the bridge is formed.
# Dom0's xen-netfront is intentionally NOT enslaved here (that is the suspected
# xenbus breaker; handled/verified separately via routing).
log() { echo "domd-flatbridge-up: $*"; }

DHCP_PID=/run/udhcpc-xenbr0.pid
# Self-report progress into xenstore (readable from Dom0 as
# /local/domain/1/data/flatbridge even when DomD console output is
# backpressured and sshd is down -- the exact situation this instruments).
XSKEY=/local/domain/1/data/flatbridge
xsr() { xenstore-write "$XSKEY" "$(xenstore-read "$XSKEY" 2>/dev/null);$*" 2>/dev/null || true; }
xenstore-write "$XSKEY" "start uptime=$(cut -d. -f1 /proc/uptime)" 2>/dev/null || true
# Wait for the first guest tap to appear. multi-user.target fires much earlier
# than the old graphical anchor, so this wait now carries the whole
# post-guest-creation timing requirement. Skipped entirely in a guest-less build,
# where no tap can ever appear and the wait would just add its full length to
# DomD's boot -- multi-user.target Wants this unit.
#
# The 90 x 2 s bound (~180 s) has no measured basis: on hardware the first tap
# has always appeared within a few seconds of the guest being created, and the
# bound is only there so a build where no guest ever starts still reaches the
# rest of this script. Treat it as a conservative ceiling, not a requirement.
if [ -f /etc/xen/doma.cfg ] || [ -f /etc/xen/domu.cfg ]; then
    i=0
    while [ $i -lt 90 ]; do
        [ -e /sys/class/net/vif-emu ] && break
        i=$((i+1)); sleep 2
    done
fi
# The bridge device itself is created by systemd-networkd from
# /etc/systemd/network/xenbr0.netdev -- this script only moves the address onto it.
# Bail out BEFORE touching eth0 if it is missing: the sequence below flushes eth0's
# 192.168.10.11 first, so continuing without a bridge to move the address to would
# leave DomD with no address at all (observed on hardware when an image recipe
# deleted xenbr0.netdev).
if [ ! -e /sys/class/net/xenbr0 ]; then
    log "FATAL: xenbr0 does not exist (missing /etc/systemd/network/xenbr0.netdev?); keeping eth0 as-is"
    xsr "xenbr0-missing"
    exit 1
fi
ip link set xenbr0 up 2>/dev/null
xsr "xenbr0-up"
# PC->Dom0 SSH is routed THROUGH DomD (PC -> xenbr0 .10.10 -> eth1 .0.11 ->
# Dom0 vif .0.1), so DomD must forward. This used to come implicitly from
# IPMasquerade=ipv4 in 50-xenbr0.network; that was removed (the .0.1 address
# there shadowed Dom0's vif end), so enable forwarding explicitly here.
sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1 && log "ip_forward=1 (PC->Dom0 routing)"
xsr "ipfwd=$(cat /proc/sys/net/ipv4/ip_forward)"
# Do not run DomD's old dnsmasq DHCP server on xenbr0 when eth0 is bridged to a
# physical LAN. The upstream network should supply addresses to DomD and any
# DHCP-capable bridged guests.
systemctl stop dnsmasq.service >/dev/null 2>&1 || true
systemctl disable dnsmasq.service >/dev/null 2>&1 || true

# Move the physical RP1 NIC into xenbr0. The bridge, not eth0, is the DHCP
# client so DomD gets a normal address from the external Ethernet network.
ip addr flush dev eth0 2>/dev/null
ip link set eth0 master xenbr0 2>/dev/null && log "eth0 -> xenbr0"
ip link set eth0 up 2>/dev/null
xsr "eth0master=$([ -e /sys/class/net/eth0/master ] && echo y || echo n)"

# Get the external wired address by DHCP on the final bridge. This intentionally
# mirrors the manual recovery command (`udhcpc -i xenbr0`) instead of changing
# the early boot networkd topology.
if command -v udhcpc >/dev/null 2>&1 && ! ip -4 addr show dev xenbr0 | grep -q ' inet '; then
    [ -f "$DHCP_PID" ] && kill "$(cat "$DHCP_PID")" 2>/dev/null || true
    rm -f "$DHCP_PID"
    udhcpc -i xenbr0 -p "$DHCP_PID" -b -R -x hostname:@SODEV_MANAGEMENT_HOSTNAME@ >/dev/null 2>&1 && log "udhcpc started on xenbr0" || \
        log "WARNING: failed to start udhcpc on xenbr0"
fi

# enslave the DomU/DomA qemu taps as they appear. DomU's tap (vif-emu2) is
# created later than the DomA taps, so retry for up to ~90s; enslaving is
# idempotent (skip any tap that already has a bridge master).
#
# Break out as soon as all three are enslaved. Without that early exit this loop
# always ran its full 45 iterations, and because multi-user.target/graphical.target
# wait on this unit the reported boot time was ~102 s even though every tap was in
# the bridge by t+12 s -- measured on hardware: the taps were enslaved at 15:35:19
# and the unit only printed "done" at 15:36:49.
# Only wait for taps that this build can actually produce. ENABLE_DOMU=no and
# ENABLE_ANDROID=no are supported configurations (XT_DOMU_CFG_INSTALL,
# XT_DOMA_BBMASK), and in those the missing tap never appears -- waiting the full
# 45 iterations for it would put back exactly the 90 s of dead time this loop was
# fixed to avoid, and then log a spurious warning. Expectation is derived from the
# xl configs present in this rootfs, which is what decides whether a guest is
# created at all.
#
# Like the tap wait above, the 45 x 2 s bound is a conservative ceiling and not a
# measured requirement -- the one hardware measurement here (taps enslaved at
# t+12 s) justifies the early break, not the size of the bound. It only decides
# how long a build whose taps never appear delays the targets that wait on this
# unit before logging the warning below.
expected=""
[ -f /etc/xen/doma.cfg ] && expected="$expected vif-emu vif-emu1"
[ -f /etc/xen/domu.cfg ] && expected="$expected vif-emu2"
if [ -z "$expected" ]; then
    log "no guest xl config present; nothing to enslave"
else
    n=0
    while [ $n -lt 45 ]; do
        pending=0
        for t in $expected; do
            if [ ! -e /sys/class/net/$t ]; then
                pending=$((pending+1))
            elif [ ! -e /sys/class/net/$t/master ]; then
                ip link set $t master xenbr0 2>/dev/null && log "$t -> xenbr0"
                [ -e /sys/class/net/$t/master ] || pending=$((pending+1))
            fi
        done
        [ "$pending" -eq 0 ] && break
        n=$((n+1)); sleep 2
    done
    [ "$pending" -eq 0 ] || log "WARNING: $pending of [$expected ] not enslaved after ~90s"
fi
# ---------------------------------------------------------------------------
# NAT the flat bridge out through DomD's real Wi-Fi.
#
# The bridge gives the guests L2 access to eth0's wired network, which needs no
# NAT. Wi-Fi is different: DomD's wlan0 gets its own address from the AP's DHCP
# server, the AP knows nothing about 192.168.10.0/24, and Xen guests
# cannot be bridged onto a station-mode wireless interface at all -- 802.11 headers carry
# one address per direction, so a bridge port would have to send frames with the guest's
# MAC as source and the AP would drop them. Routing plus source NAT is the only way out.
#
# Measured on RPi4 2026-08-26: DomD itself reached the internet over wlan0 (ping
# 8.8.8.8 10 ms, an https page fetched), but DomA could not, because nothing
# translated its addresses. iptables is an RDEPENDS of this recipe for that
# reason.
#
# Rules are installed unconditionally, not gated on wlan0 existing: iptables resolves
# interface names when a packet is matched, not when the rule is added, so they simply do
# nothing until wpa_supplicant brings the interface up. That matters because this unit is
# Type=oneshot and finishes long before Wi-Fi associates. -C before -A/-I keeps it
# idempotent, which this script has to be -- xl-create-doma.service re-runs it on every
# DomA (re)create.
UPLINK_WIFI_IF=wlan0
if command -v iptables >/dev/null 2>&1; then
    # If xenbr0 has a DHCP lease, derive the source subnet for optional Wi-Fi
    # NAT from that lease. If it has no address yet, skip the NAT source setup.
    _cidr="$(ip -o -4 addr show dev xenbr0 | awk 'NR==1 {print $4}')"
    _net=""
    if [ -n "$_cidr" ]; then
        _net="$(printf '%s' "${_cidr%%/*}" | sed 's|\.[0-9]*$|.0|')/${_cidr##*/}"
    fi
    sysctl -qw net.ipv4.ip_forward=1 2>/dev/null || true
    # ipt_add <table-args...> -- add the rule only if an identical one is absent.
    # Written as a helper so the -C/-A pair cannot drift apart, and so the exit status
    # of the whole thing is the ADD's, not a confusing `||`/`&&` precedence chain.
    # DO NOT hide the add's stderr. A failed add is otherwise invisible: the
    #   only symptom is DomA with no internet (ping 8.8.8.8 100% loss, DNS still
    #   fine because dnsmasq answers locally) and `iptables -t nat -S` empty,
    #   which is how a missing nat table presented on the board. The nat table
    #   is a module in these kernels; modules-load.d/domd-nat.conf loads it at
    #   boot.
    ipt_add() {
        _t=""
        if [ "$1" = "-t" ]; then _t="-t $2"; shift 2; fi
        _op="$1"; shift
        # shellcheck disable=SC2086
        if iptables $_t -C "$@" 2>/dev/null; then return 0; fi
        # shellcheck disable=SC2086
        _err=$(iptables $_t "$_op" "$@" 2>&1) && return 0
        log "WARNING: iptables $_t $_op $* failed: ${_err:-(no message)}"
        return 1
    }
    if [ -n "$_net" ]; then
        ipt_add -t nat -A POSTROUTING -s "$_net" -o "$UPLINK_WIFI_IF" -j MASQUERADE \
            && log "nat: MASQUERADE $_net -> $UPLINK_WIFI_IF"
    fi
    ipt_add -I FORWARD -i xenbr0 -o "$UPLINK_WIFI_IF" -j ACCEPT
    # The stateful return rule is OPTIONAL: it needs the xt_conntrack module,
    # and the FORWARD policy is ACCEPT, so replies come back without it.
    ipt_add -I FORWARD -i "$UPLINK_WIFI_IF" -o xenbr0 \
        -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT \
        || log "note: stateful return rule skipped (no xt_conntrack); FORWARD policy is $(iptables -S FORWARD | sed -n 's/^-P FORWARD //p')"
    xsr "nat-installed net=${_net:-none} out=$UPLINK_WIFI_IF"
else
    log "iptables not present; guests will have no route out through $UPLINK_WIFI_IF"
    xsr "nat-skipped-no-iptables"
fi
# ---------------------------------------------------------------------------

xsr "done addrs=$(ip -br -4 a | tr '\n' '|')"
log "done (xenbr0 DHCP: $(ip -o -4 addr show dev xenbr0 | awk 'NR==1 {print $4}' || true))"
