# SPDX-License-Identifier: MIT
[Unit]
Description=Bluetooth HCI bridge for DomA (btproxy: hci0 user channel <-> H4 on a Unix socket)
# Started by hci0 itself: udev tags every bluetooth device for systemd
# (99-systemd.rules), so hci0 is the device unit below once hci_uart has bound over
# serdev to the brcm,bcm43438-bt child of the board's Bluetooth UART, and the
# [Install] section hangs this unit off it. BindsTo stops it when hci0 goes (an
# unbind, a module reload) and the device starts it again when hci0 comes back. Where
# DomD has no Bluetooth UART (the Raspberry Pi 5 with DOM0_OS=linux) hci0 never
# appears and this never starts.
BindsTo=sys-subsystem-bluetooth-devices-hci0.device
After=sys-subsystem-bluetooth-devices-hci0.device
# A btproxy that fails right after hci0 appears is started again (Restart=always)
# without ever latching the unit failed. Must live in [Unit], not [Service]. Same
# reasoning as domd-wifi-agent.service, gnss_replay.service and
# cluster-service.service.
StartLimitIntervalSec=0

[Service]
# --unix=<path> MUST use the `=` form. btproxy declares the option as
# { "unix", optional_argument, NULL, 'u' } (tools/btproxy.c), and getopt does not
# consume a space-separated value for an optional_argument -- `-u /run/bt-hci.sock`
# leaves optarg NULL and btproxy silently listens on its built-in default
# /tmp/bt-server-bredr instead. qemu would then just retry forever against a socket
# that never appears, so the failure is invisible without reading this journal.
ExecStart=/usr/bin/btproxy --unix=/run/bt-hci.sock -i 0
Restart=always
RestartSec=2

[Install]
WantedBy=sys-subsystem-bluetooth-devices-hci0.device
