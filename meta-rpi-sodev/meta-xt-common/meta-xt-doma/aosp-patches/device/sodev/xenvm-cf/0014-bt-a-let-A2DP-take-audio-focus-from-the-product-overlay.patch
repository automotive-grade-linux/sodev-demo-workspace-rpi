 ## Status
 
diff --git a/overlay/packages/modules/Bluetooth/android/app/res/values/config.xml b/overlay/packages/modules/Bluetooth/android/app/res/values/config.xml
new file mode 100644
index 0000000..f4cb0e3
--- /dev/null
+++ b/overlay/packages/modules/Bluetooth/android/app/res/values/config.xml
@@ -0,0 +1,15 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+     SPDX-License-Identifier: Apache-2.0
+
+     Static overlay on the Bluetooth app (packages/modules/Bluetooth/android/app).
+
+     With AOSP's default, false, the stack requests no audio focus when an
+     A2DP sink source starts or plays, so on this car product A2DP is
+     selectable but silent: its route never becomes active.
+
+     The Raspberry Pi 5 product carries the same value in device/agl/common/overlay.
+-->
+<resources>
+    <bool name="a2dp_sink_automatically_request_audio_focus">true</bool>
+</resources>
