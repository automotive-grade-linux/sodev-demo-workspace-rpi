 README.md                                    |  2 ++
 aosp_xenvm_trout_rpi4_arm64.mk               |  8 ++++++
 xenvm_trout_rpi4_arm64/init.xenvm-webview.rc | 26 +++++++++++++++++++
 6 files changed, 78 insertions(+)
 create mode 100644 DomaNoSafeAreaRRO/Android.bp
 create mode 100644 DomaNoSafeAreaRRO/AndroidManifest.xml
 create mode 100644 DomaNoSafeAreaRRO/res/values/config.xml
