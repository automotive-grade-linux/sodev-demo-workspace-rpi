diff --git a/DomaNoSafeAreaRRO/Android.bp b/DomaNoSafeAreaRRO/Android.bp
new file mode 100644
index 0000000..416fad6
--- /dev/null
+++ b/DomaNoSafeAreaRRO/Android.bp
@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// DomaNoSafeAreaRRO -- no per-display safe area and toolbar in CarSystemUI.
+//
+// With config_enableSafeAreaAndToolbarPerDisplay=true (CarSystemUI's default,
+// packages/apps/Car/SystemUI/res/values/config.xml) a full-screen app is kept out
+// of a band by ShellLetterboxSurface, and SurfaceFlinger then composes every layer
+// on the GPU (CLIENT): a WebView's video can no longer go on its own plane.
+// Measured on the Raspberry Pi 5 (2026-10-16, an H.264 1080p60 video playing in a
+// WebView, with this value set by a runtime test overlay): all of SurfaceFlinger's
+// layers became DEVICE. This board's 1280x720 display takes values/'s safe region
+// (0,144 to 1408,696 dp at density 160), as wide as the screen but with a band
+// above and below, so the same letterbox is there. With the value false a
+// full-screen app covers the whole display, with no band; with this RRO in DomA's
+// image, a WebView's 720p video full screen was composed as three DEVICE layers
+// on this board (2026-10-23; no run without the RRO was compared here).
+//
+// A static product overlay, signed with the platform key like Car's own RROs. The
+// priority only orders it among static overlays of the same target in product. No
+// RRO this product installs sets this value (car_product's CarSystemUIDewdUIRRO does,
+// but it is installed only with HAS_SCALABLEUI=true, which this product does not set).
+runtime_resource_overlay {
+    name: "DomaNoSafeAreaRRO",
+    resource_dirs: ["res"],
+    certificate: "platform",
+    product_specific: true,
+}
diff --git a/DomaNoSafeAreaRRO/AndroidManifest.xml b/DomaNoSafeAreaRRO/AndroidManifest.xml
new file mode 100644
index 0000000..1f5dd42
--- /dev/null
+++ b/DomaNoSafeAreaRRO/AndroidManifest.xml
@@ -0,0 +1,9 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- SPDX-License-Identifier: Apache-2.0 -->
+<manifest xmlns:android="http://schemas.android.com/apk/res/android"
+    package="com.agl.doma.rpi4.nosafearea">
+    <overlay android:targetPackage="com.android.systemui"
+        android:isStatic="true"
+        android:priority="10" />
+    <application android:hasCode="false" />
+</manifest>
diff --git a/DomaNoSafeAreaRRO/res/values/config.xml b/DomaNoSafeAreaRRO/res/values/config.xml
new file mode 100644
index 0000000..032ba7e
--- /dev/null
+++ b/DomaNoSafeAreaRRO/res/values/config.xml
@@ -0,0 +1,6 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- SPDX-License-Identifier: Apache-2.0 -->
+<resources>
+    <!-- See Android.bp: a full-screen app covers the display, so its video can be a plane. -->
+    <bool name="config_enableSafeAreaAndToolbarPerDisplay">false</bool>
+</resources>
