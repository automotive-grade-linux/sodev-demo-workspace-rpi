diff --git a/aosp_xenvm_trout_rpi4_arm64.mk b/aosp_xenvm_trout_rpi4_arm64.mk
index 6232f0c..1da9543 100644
--- a/aosp_xenvm_trout_rpi4_arm64.mk
+++ b/aosp_xenvm_trout_rpi4_arm64.mk
@@ -196,6 +196,14 @@ PRODUCT_VENDOR_PROPERTIES += \
 PRODUCT_VENDOR_PROPERTIES += \
     ro.surface_flinger.enable_frame_rate_override=false
 
+# Full screen without CarSystemUI's per-display safe area, so a WebView's video can go on
+# its own plane (see DomaNoSafeAreaRRO/Android.bp), and the WebView switches that make a
+# <video> element's video its own layer, so drm_hwcomposer can put it on a plane of its
+# own (init.xenvm-webview.rc). The same as the Raspberry Pi 5 product in the AGL layer.
+PRODUCT_PACKAGES += DomaNoSafeAreaRRO
+PRODUCT_COPY_FILES += \
+    device/sodev/xenvm-cf/xenvm_trout_rpi4_arm64/init.xenvm-webview.rc:$(TARGET_COPY_OUT_VENDOR)/etc/init/init.xenvm-webview.rc
+
 # Start the interface rename that minradio's data call depends on. cuttlefish already
 # ships the service and a trigger for it, but trout sets ro.vendor.disable_rename_eth0
 # so that trigger never fires; overriding that is deliberate and argued in the .rc.
diff --git a/xenvm_trout_rpi4_arm64/init.xenvm-webview.rc b/xenvm_trout_rpi4_arm64/init.xenvm-webview.rc
new file mode 100644
index 0000000..89f2754
--- /dev/null
+++ b/xenvm_trout_rpi4_arm64/init.xenvm-webview.rc
@@ -0,0 +1,26 @@
+# SPDX-License-Identifier: Apache-2.0
+#
+# Let the WebView hand decoded video to SurfaceFlinger as its own layer.
+#
+# With WebViewSurfaceControl the video of a <video> element becomes a child
+# SurfaceControl (webview_overlay_content) instead of being drawn into the app's
+# window every frame; drm_hwcomposer can then put the video and the app on
+# separate planes. Measured on this board (local 1080p30 H.264, full screen):
+# dropped frames 16% -> 1.7% over 5 minutes, app CPU 48 -> 38 (2026-10-03, set by
+# hand on the board).
+#
+# WebView takes Chromium switches only from this file, and reads it only when
+# ro.debuggable=1 (userdebug, as this product is); it is read at app start, so a
+# WebView app started before the first boot completes runs without the switches (the
+# file then stays in /data). It applies to every WebView app.
+#
+# SELinux: works only while the product boots permissive. Creating a file in
+# /data/local/tmp (shell_data_file) is a neverallow for vendor_init and for init itself
+# (system/sepolicy/private/vendor_init.te:365, init.te:853), so no init script on any
+# partition can write it in enforcing; only adb's shell, adbd and dumpstate may. In
+# enforcing the write fails (init logs it) and WebView runs without the switches; put
+# the file there once with `adb shell` (it stays in /data). Not yet verified on a
+# board that init writes it (the boards' files were put there by hand).
+on property:sys.boot_completed=1
+    write /data/local/tmp/webview-command-line "_ --enable-features=WebViewSurfaceControl,WebViewThreadSafeMedia"
+    chmod 0644 /data/local/tmp/webview-command-line
