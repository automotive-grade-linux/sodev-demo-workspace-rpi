# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Android Dumpstate GRPC Server
# Restart=always with no StartLimitIntervalSec lets an immediately-failing start
# trip systemd's default start-limit (5 starts / 10 s) and latch the unit into a
# permanent "failed" state. Disable the rate limiter so a crash loop keeps retrying
# (matches cluster-service.service). Must live in [Unit], not [Service].
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/dumpstate_grpc_server -server_addr vsock:2:9310
Restart=always

[Install]
WantedBy=multi-user.target
