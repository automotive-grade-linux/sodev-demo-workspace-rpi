# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Mock GNSS Host Agent
# Restart=always with no StartLimitIntervalSec lets an immediately-failing start
# trip systemd's default start-limit (5 starts / 10 s) and latch the unit into a
# permanent "failed" state. Disable the rate limiter so a crash loop keeps retrying
# (matches cluster-service.service). Must live in [Unit], not [Service].
StartLimitIntervalSec=0

[Service]
ExecStartPre=/bin/sh -c 'while [ ! -e /run/gnss-uart ]; do sleep 0.2; done'
ExecStart=/usr/bin/python3 /usr/bin/gnss_replay.py -s /run/gnss-uart -i /usr/share/gnss/test.csv
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
