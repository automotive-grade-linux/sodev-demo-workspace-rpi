@@ -302,6 +360,28 @@ static struct vhost_xen_map *vhost_xen_find_map(struct vhost_virtqueue *vq,
 	return NULL;
 }
 
+/*
+ * Unmap everything still mapped on this virtqueue.
+ *
+ * translate_desc() maps every descriptor it translates, so a handler that
+ * leaves an iteration before its own unmap -- a vq_err break, a NULL from
+ * vhost_vsock_alloc_skb(), vhost_discard_vq_desc() in vhost_net's RX and TX
+ * paths, or a chain whose translation failed half-way (including the
+ * indirect table in get_indirect()) -- leaves those maps on vq->desc_maps.
+ * A discarded descriptor is translated and mapped again on the next get, so
+ * the leftovers are not bounded by the ring. vhost_dev_cleanup() is the only
+ * other caller, so without this they live until QEMU closes the vhost fd.
+ *
+ * The device handlers therefore call this at the head of every iteration
+ * and once more before they drop vq->mutex. It is safe there because every
+ * success path copies the data synchronously (copy_to/from_iter,
+ * skb_copy_datagram_*, vhost_net_build_xdp into a page_frag) and unmaps
+ * before the iteration ends, so nothing still on the list is in use.
+ *
+ * handle_tx_zerocopy() is the one path that hands guest pages to an skb
+ * asynchronously; it has no such call and must not get one. vhost_net never
+ * selects it here: experimental_zcopytx defaults to 0 and is left at 0.
+ */
 void vhost_xen_unmap_desc_all(struct vhost_virtqueue *vq)
 {
 	struct vhost_xen_map *map;
