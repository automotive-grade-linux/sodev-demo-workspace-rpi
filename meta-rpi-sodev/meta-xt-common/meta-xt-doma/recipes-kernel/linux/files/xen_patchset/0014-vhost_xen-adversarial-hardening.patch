 static void handle_tx_zerocopy(struct vhost_net *net, struct socket *sock)
@@ -1213,6 +1215,14 @@ static void handle_rx(struct vhost_net *net)
 			  vhost_has_feature(vq, VIRTIO_F_VERSION_1);
 
 	do {
+#ifdef CONFIG_VHOST_XEN
+		/*
+		 * Maps an earlier iteration left on an error or discard path
+		 * (get_rx_bufs running out of buffers, a short recvmsg, a
+		 * failed num_buffers write); see xen.c.
+		 */
+		vhost_xen_unmap_desc_all(vq);
+#endif
 		sock_len = vhost_net_rx_peek_head_len(net, sock->sk,
 						      &busyloop_intr, &count);
 		if (!sock_len)
@@ -1254,6 +1264,10 @@ static void handle_rx(struct vhost_net *net)
 			err = sock->ops->recvmsg(sock, &msg,
 						 1, MSG_DONTWAIT | MSG_TRUNC);
 			pr_debug("Discarded rx packet: len %zd\n", sock_len);
+#ifdef CONFIG_VHOST_XEN
+			/* MV4: unmap the descriptors mapped for this discarded packet */
+			vhost_net_unmap_desc(vq, in);
+#endif
 			continue;
 		}
 		/* We don't need to be notified again. */
@@ -1325,6 +1339,9 @@ static void handle_rx(struct vhost_net *net)
 	else if (!sock_len)
 		vhost_net_enable_vq(net, vq);
 out:
+#ifdef CONFIG_VHOST_XEN
+	vhost_xen_unmap_desc_all(vq);
+#endif
 	vhost_net_signal_used(nvq, count);
 	mutex_unlock(&vq->mutex);
 }
