+	/*
+	 * A zero-length descriptor contributes no iovec, as in the generic
+	 * loop below (which does not run and returns 0). Mapping it would
+	 * ask the allocator for 0 pages and then read map->pages[0].
+	 */
+	if (!len)
+		return 0;
+	/*
+	 * With an IOTLB the callers pass host virtual addresses (the ring
