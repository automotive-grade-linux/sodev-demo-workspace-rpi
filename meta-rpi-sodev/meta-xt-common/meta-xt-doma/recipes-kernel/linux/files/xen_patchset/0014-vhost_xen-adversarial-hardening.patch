-					__func__, map->domid, ret);
+		if (ret) {
+			/*
+			 * Some frame may still be mapped from the guest. Giving
+			 * the pages back to their pool (gnttab or unpopulated)
+			 * would hand the next user a window onto guest memory,
+			 * so the map is leaked on purpose.
+			 */
+			pr_warn_ratelimited("%s: Failed to unmap pages from dom%d (ret=%d); leaking %d page(s)\n",
+					__func__, map->domid, ret, map->count);
