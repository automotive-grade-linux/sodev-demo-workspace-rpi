+	 * error left the frames behind it in the physmap while the caller
+	 * returned their pages to the unpopulated pool. Frames that never made
+	 * it into the physmap (map->mapped clear, see map_pages) are skipped.
+	 * The first error is reported.
+	 */
 	for (i = 0; i < map->count; i++) {
 		xen_pfn_t pfn = page_to_xen_pfn(map->pages[i / XEN_PFN_PER_PAGE]);
 
+		if (!test_bit(i, map->mapped))
+			continue;
