+		 * Maps an earlier iteration left on an error or discard path
+		 * (get_tx_bufs failure, vhost_net_build_xdp failure, sendmsg
+		 * backpressure); see xen.c. Not for handle_tx_zerocopy().
+		 */
+		vhost_xen_unmap_desc_all(vq);
+#endif
 		if (nvq->done_idx == VHOST_NET_BATCH)
 			vhost_tx_batch(net, nvq, sock, &msg);
 
@@ -882,6 +881,9 @@ static void handle_tx_copy(struct vhost_net *net, struct socket *sock)
 	} while (likely(!vhost_exceeds_weight(vq, ++sent_pkts, total_len)));
 
 	vhost_tx_batch(net, nvq, sock, &msg);
