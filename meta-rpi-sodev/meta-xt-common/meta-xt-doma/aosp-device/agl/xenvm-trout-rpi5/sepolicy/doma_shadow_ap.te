# SPDX-License-Identifier: Apache-2.0
#
# doma_shadow_ap: /vendor/bin/doma-shadow-ap (the shadow-AP bring-up oneshot) and
# /vendor/bin/doma-wifi-relay (the long-lived relay), which share the domain (see
# file_contexts). Both run from init.xenvm-hwsim.rc as uid wifi (the oneshot with
# NET_ADMIN and NET_RAW, the relay with no capability), and use only /vendor's tools
# (their PATH) and cuttlefish's Wi-Fi apex.
#
# The rules are the scripts' needs, each with the step that has it. Collect denials on
# the board with
#     adb shell dmesg | grep 'avc: .*doma_shadow_ap'
#     adb logcat -b events -d | grep 'avc: .*doma_shadow_ap'
# (both, and early: the kernel rate-limits avc lines, and the logs then say audit_lost).

type doma_shadow_ap, domain;
type doma_shadow_ap_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(doma_shadow_ap)

# The scripts' interpreter (#!/vendor/bin/sh) and tools: toybox_vendor (ls, cp, mv,
# chmod, grep, sed, cmp, date, brctl, ifconfig, log ...) and toolbox (getprop,
# setprop), both vendor_toolbox_exec, and /vendor/bin's other programs, awk and iw
# (iw_vendor), which take the vendor_file default label.
allow doma_shadow_ap vendor_shell_exec:file rx_file_perms;
allow doma_shadow_ap vendor_toolbox_exec:file rx_file_perms;
allow doma_shadow_ap vendor_file:file rx_file_perms;

# Step 2 of doma-shadow-ap.sh: mac80211_create_radios makes the hwsim radios over
# generic netlink. It runs in this domain, as cuttlefish's init_wifi_sh runs it
# (device/google/cuttlefish/shared/sepolicy/vendor/init_wifi_sh.te). The relay's iw
# uses generic netlink (nl80211) too.
allow doma_shadow_ap mac80211_create_radios_exec:file { getattr open read execute execute_no_trans map };
allow doma_shadow_ap self:netlink_generic_socket create_socket_perms_no_ioctl;

# Steps 1 and 4: renaming buried_eth1 back to eth1 is cuttlefish's rename_netiface,
# in its own domain; the virt_wifi fallback execs cuttlefish's setup_wifi, in its own
# domain.
domain_auto_trans(doma_shadow_ap, rename_netiface_exec, rename_netiface)
domain_auto_trans(doma_shadow_ap, setup_wifi_exec, setup_wifi)

# Step 4: the uplink bridge. Socket ioctls: ifconfig's link flags and bionic's
# if_nametoindex() on a UDP socket (toybox toys/net/ifconfig.c, bionic net_if.cpp),
# brctl's addbr and addif on a TCP one (toybox toys/pending/brctl.c, xsocket(AF_INET,
# SOCK_STREAM)). The radios, the bridge and the link state need NET_ADMIN (init grants
# the capability, SELinux checks it as well).
allow doma_shadow_ap self:capability { net_admin net_raw };
allow doma_shadow_ap self:udp_socket { create ioctl };
allowxperm doma_shadow_ap self:udp_socket ioctl { SIOCGIFFLAGS SIOCSIFFLAGS SIOCGIFINDEX };
allow doma_shadow_ap self:tcp_socket { create ioctl };
allowxperm doma_shadow_ap self:tcp_socket ioctl { SIOCBRADDBR SIOCBRADDIF };

# The AP list, the generated hostapd.conf (hostapd's ctrl_interface directory is made
# here; nothing here talks to its sockets) and the request drop-box:
# /data/vendor/wifi/shadow (file_contexts).
allow doma_shadow_ap hostapd_data_file:dir create_dir_perms;
allow doma_shadow_ap hostapd_data_file:file create_file_perms;
allow doma_shadow_ap doma_wifi_req_file:dir rw_dir_perms;
allow doma_shadow_ap doma_wifi_req_file:file create_file_perms;

# Step 3: the shipped AP-list seed, /vendor/etc/doma-shadow-aps.conf, takes the
# partition default vendor_configs_file.
allow doma_shadow_ap vendor_configs_file:file r_file_perms;

# The relay's stations_present() and both scripts' interface checks read
# /sys/class/net/<if>/{carrier,flags,carrier_up_count,master} and list its entries
# (genfs sysfs_net).
allow doma_shadow_ap sysfs_net:dir r_dir_perms;
allow doma_shadow_ap sysfs_net:file r_file_perms;
allow doma_shadow_ap sysfs_net:lnk_file r_file_perms;

# `setprop ctl.restart|stop|start vendor.doma_shadow_hostapd`: init checks the legacy
# name ctl.vendor.doma_shadow_hostapd, which falls to the `ctl.` prefix,
# ctl_default_prop, a system_public_prop a vendor domain may set
# (system/core/init/property_service.cpp, private/property_contexts). Not
# ctl_restart_prop, a system_internal_prop no vendor domain may be given.
set_prop(doma_shadow_ap, ctl_default_prop)

# The relay's `exec 3<> /dev/hvc4`, its channel to DomD: cuttlefish labels /dev/hvc4
# gatekeeper_device (device/google/cuttlefish/shared/sepolicy/vendor/file_contexts).
allow doma_shadow_ap gatekeeper_device:chr_file rw_file_perms;

# `getprop ro.boot.wifi_mac_prefix`, the hwsim MAC prefix: cuttlefish labels it
# vendor_wifi_mac_prefix with an exact match, granted per domain.
get_prop(doma_shadow_ap, vendor_wifi_mac_prefix)
