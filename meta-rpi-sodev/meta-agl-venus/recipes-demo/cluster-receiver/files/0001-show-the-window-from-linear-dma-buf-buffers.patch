+/* No frame for this long: the stream has stopped. */
+#define STREAM_IDLE_MS 1000
+
+/* The sink's streaming thread: only wake the main loop, which owns Wayland. */
+static GstFlowReturn
+new_sample_cb(GstAppSink *sink, gpointer user_data)
+{
+	struct cluster_receiver_data *d =
+		static_cast<struct cluster_receiver_data *>(user_data);
+	uint64_t one = 1;
+	(void) sink;
+
+	if (write(d->frame_fd, &one, sizeof(one)) < 0 && errno != EAGAIN)
+		return GST_FLOW_ERROR;
+	return GST_FLOW_OK;
+}
+
+static void
+show_sample(struct cluster_receiver_data *d)
+{
+	uint64_t count;
+	GstSample *sample;
+	GstVideoInfo info;
+	GstVideoFrame frame;
+
+	if (read(d->frame_fd, &count, sizeof(count)) < 0)
+		return;
+	sample = gst_app_sink_try_pull_sample(d->sink, 0);
+	if (!sample)
+		return;
+
+	GstBuffer *gbuf = gst_sample_get_buffer(sample);
+	if (!gbuf || !gst_video_info_from_caps(&info, gst_sample_get_caps(sample))) {
+		gst_sample_unref(sample);
+		return;
+	}
+	if (GST_VIDEO_INFO_WIDTH(&info) != d->window->width ||
+	    GST_VIDEO_INFO_HEIGHT(&info) != d->window->height) {
+		if (!d->size_warned) {
+			fprintf(stderr, "dropping %dx%d frames: the window is %dx%d\n",
+				GST_VIDEO_INFO_WIDTH(&info), GST_VIDEO_INFO_HEIGHT(&info),
+				d->window->width, d->window->height);
+			d->size_warned = true;
+		}
+		gst_sample_unref(sample);
+		return;
+	}
+	/* the buffer's own layout (GstVideoMeta), which may be padded */
+	if (gst_video_frame_map(&frame, &info, gbuf, GST_MAP_READ)) {
+		if (present(d->window,
+			    static_cast<const uint8_t *>(GST_VIDEO_FRAME_PLANE_DATA(&frame, 0)),
+			    GST_VIDEO_FRAME_PLANE_STRIDE(&frame, 0))) {
+			d->showing_frame = true;
+			d->last_frame_us = g_get_monotonic_time();
+		}
+		gst_video_frame_unmap(&frame);
+	}
+	gst_sample_unref(sample);
+}
