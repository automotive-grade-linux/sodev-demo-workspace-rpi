+static void
+dmabuf_created(void *data, struct zwp_linux_buffer_params_v1 *params,
+	       struct wl_buffer *new_buffer)
+{
+	struct buffer *buffer = static_cast<struct buffer *>(data);
+
+	buffer->buffer = new_buffer;
+	wl_buffer_add_listener(buffer->buffer, &buffer_listener, buffer);
+	zwp_linux_buffer_params_v1_destroy(params);
+}
+
+static void
+dmabuf_failed(void *data, struct zwp_linux_buffer_params_v1 *params)
+{
+	struct buffer *buffer = static_cast<struct buffer *>(data);
+
+	buffer->failed = 1;
+	zwp_linux_buffer_params_v1_destroy(params);
+}
+
+static const struct zwp_linux_buffer_params_v1_listener params_listener = {
+	dmabuf_created,
+	dmabuf_failed,
+};
+
+/*
+ * A linear XRGB8888 GBM buffer, handed to the compositor as a dma-buf. The
+ * answer is waited for here, so a refusal turns into the wl_shm path rather
+ * than into a protocol error.
+ */
+static int
+create_dmabuf_buffer(struct display *display, struct buffer *buffer,
+		     int width, int height)
+{
+	struct zwp_linux_buffer_params_v1 *params;
+	int fd;
+
+	buffer->bo = gbm_bo_create(display->gbm, width, height, GBM_FORMAT_XRGB8888,
+				   GBM_BO_USE_SCANOUT | GBM_BO_USE_LINEAR);
+	if (!buffer->bo)
+		return -1;
+
+	fd = gbm_bo_get_fd(buffer->bo);
+	if (fd < 0) {
+		gbm_bo_destroy(buffer->bo);
+		buffer->bo = NULL;
+		return -1;
+	}
+
+	params = zwp_linux_dmabuf_v1_create_params(display->dmabuf);
+	zwp_linux_buffer_params_v1_add(params, fd, 0, gbm_bo_get_offset(buffer->bo, 0),
+				       gbm_bo_get_stride(buffer->bo), 0, 0); /* LINEAR */
+	zwp_linux_buffer_params_v1_add_listener(params, &params_listener, buffer);
+	zwp_linux_buffer_params_v1_create(params, width, height, GBM_FORMAT_XRGB8888, 0);
+	wl_display_roundtrip(display->wl_display);
+	close(fd);
+
+	if (!buffer->buffer) {
+		gbm_bo_destroy(buffer->bo);
+		buffer->bo = NULL;
+		return -1;
+	}
+	return 0;
+}
+
+static void
+destroy_buffer(struct buffer *buffer)
+{
+	if (buffer->buffer)
+		wl_buffer_destroy(buffer->buffer);
+	if (buffer->bo)
+		gbm_bo_destroy(buffer->bo);
+	else if (buffer->shm_data)
+		munmap(buffer->shm_data, buffer->width * buffer->height * 4);
+	memset(buffer, 0, sizeof(*buffer));
+}
